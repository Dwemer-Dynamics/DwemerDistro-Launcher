<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DwemerDistro</AssemblyName>
    <Version>3.3.7</Version>
    <FileVersion>3.3.7.0</FileVersion>
    <AssemblyVersion>3.3.7.0</AssemblyVersion>
    <ApplicationIcon>Assets\DwemerDistro.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\*.png" />
    <None Remove="Assets\*.gif" />
    <None Remove="Assets\*.ico" />
    <None Remove="Assets\GameCenter\*.jpg" />
    <None Remove="Assets\Fonts\*.ttf" />
    <None Remove="Assets\Fonts\FONT-LICENSES.md" />
    <None Remove="Assets\Fonts\OFL-*.txt" />
    <Resource Include="Assets\*.png" />
    <Resource Include="Assets\*.gif" />
    <Resource Include="Assets\*.ico" />
    <Resource Include="Assets\GameCenter\*.jpg" />
    <!-- Brand title faces are packaged into the assembly so the launcher never
         depends on a system-installed font. The attribution and the full OFL
         licence text are copied out as loose files rather than embedded, so they
         stay readable beside the published binary. -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <Content Include="Assets\Fonts\FONT-LICENSES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\OFL-*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="GenerateLauncherSecrets" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <LauncherSecretsGeneratedFile>$(IntermediateOutputPath)Generated\LauncherSecrets.g.cs</LauncherSecretsGeneratedFile>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)Generated" />
    <ItemGroup>
      <LauncherSecretsLines Include="namespace DwemerDistro.Launcher.Wpf.Services%3B" />
      <LauncherSecretsLines Include="internal static class LauncherSecrets" />
      <LauncherSecretsLines Include="{" />
      <LauncherSecretsLines Include="    public const string ManagedHuggingFaceToken = &quot;$(ManagedHuggingFaceToken)&quot;%3B" />
      <LauncherSecretsLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(LauncherSecretsGeneratedFile)" Lines="@(LauncherSecretsLines)" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(LauncherSecretsGeneratedFile)" />
    </ItemGroup>
  </Target>

</Project>
