    <!-- Mod Webpage action. It is the panel's primary action while the installed server is
         current, so it takes the brand fill at rest. When the mod's own version check confirms an
         update, the Update button above it takes the emphasis and this drops to the brand outline
         (transparent fill, brand border) without moving. Hover and pressed come from the brand
         style in both states. The DataContext is the main view model, so each variant watches its
         own manager. Reign and Lorkhan never report IsUpdateAvailable and use the plain brand
         buttons. -->
    <Style x:Key="GameCenter.ModAction.ChimWebpageButton" TargetType="Button" BasedOn="{StaticResource GameCenter.Brand.ChimButton}">
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
