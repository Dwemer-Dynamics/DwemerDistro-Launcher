    <!-- External pages and local logs: a compact, wrapping group of neutral outline buttons
         under the mod's main actions. Visible labels may be shortened, but every button keeps
         its full automation name and help text, and the WrapPanel keeps document (tab) order. -->
    <Style x:Key="GameCenter.ModAction.LinkButton" TargetType="Button" BasedOn="{StaticResource GameCenter.ModAction.SecondaryButton}">
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="0,0,6,6" />
    </Style>

    <!-- Hairline rule that closes the everyday actions and opens the Manage group, so rollback
         and removal are a deliberate reach rather than the next button in the stack. Purely
         decorative: it takes no hit testing and no focus and carries no automation name, so the
         tab order and the screen-reader walk of the panel are unchanged. -->
    <Style x:Key="GameCenter.ModAction.Separator" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource GameCenter.Border}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.Border}" />
        <Setter Property="Margin" Value="0,12,0,8" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Quiet "Manage" label under the separator. -->
    <Style x:Key="GameCenter.ModAction.GroupLabel" TargetType="TextBlock" BasedOn="{StaticResource GameCenter.Caption}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Mod action panel tiers. One action, one colour, on every mod: the panel's buttons never
         carry a brand colour, which stays in the artwork, rail emblem and title. The copper fill is
         the one primary action of the current state (Webpage while current, Install, Repair, a
         custom mod's dashboard); the copper outline is the same family without the fill. Hover and
         pressed each move two channels, disabled drops to the neutral muted treatment every other
         tier uses, and the base template's white focus ring is kept, so focus reads on copper,
         green, red and transparent alike. -->
    <Style x:Key="GameCenter.ModAction.PrimaryButton" TargetType="Button" BasedOn="{StaticResource GameCenter.Button}">
        <Setter Property="Background" Value="{DynamicResource GameCenter.Copper}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.CopperEdge}" />
        <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.CopperHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.CopperStrong}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.CopperPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.CopperStrong}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource GameCenter.PanelRaised}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.BorderStrong}" />
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GameCenter.ModAction.CopperOutlineButton" TargetType="Button" BasedOn="{StaticResource GameCenter.Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.CopperEdge}" />
        <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.CopperTint}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.CopperStrong}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.CopperTintPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.CopperStrong}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource GameCenter.PanelRaised}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.BorderStrong}" />
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Installed mod Webpage, shared by every official mod. Copper fill while the server is
         current; when the mod's own version check confirms an update (IsUpdateAvailable), Update
         below takes the emphasis and this drops to the copper outline in place, so nothing moves.
         The button's DataContext stays the main view model its command lives on; its Tag carries
         that mod's ServerManagerItemViewModel, which is all the style reads. -->
    <Style x:Key="GameCenter.ModAction.WebpageButton" TargetType="Button" BasedOn="{StaticResource GameCenter.ModAction.PrimaryButton}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag.IsUpdateAvailable, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="Transparent" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag.IsUpdateAvailable, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource GameCenter.CopperTint}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag.IsUpdateAvailable, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource GameCenter.CopperTintPressed}" />
            </MultiDataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource GameCenter.PanelRaised}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.BorderStrong}" />
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Installed mod Update, shared by every official mod. Copper outline at rest; the shared
         success green only when IsUpdateAvailable confirms the selected branch is ahead, never the
         yellow status colour, which also stands for an unknown or missing version. Hover and pressed
         darken the green, as Start Server does, so the white label stays above 4.5:1. The DataContext
         of each of these buttons is its ServerManagerItemViewModel. -->
    <Style x:Key="GameCenter.ModAction.UpdateButton" TargetType="Button" BasedOn="{StaticResource GameCenter.ModAction.CopperOutlineButton}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.Success}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.SuccessHover}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsUpdateAvailable}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource GameCenter.SuccessPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.SuccessEdge}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsUpdateAvailable}" Value="True" />
                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource GameCenter.SuccessPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.SuccessEdge}" />
            </MultiDataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource GameCenter.PanelRaised}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.BorderStrong}" />
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Local game log action: a quiet full-width row with a document glyph, muted until hovered or
         focused, so logs never compete with the panel's buttons. Content stays the plain label
         string; hover, pressed, focus and disabled come from the base template. -->
    <Style x:Key="GameCenter.ModAction.LogRow" TargetType="Button" BasedOn="{StaticResource GameCenter.Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="12" FontWeight="Normal"
                                   Margin="0,0,9,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Quiet sentence-case group heading with a hairline to the right ("Pages and logs",
         "Manage"). Decorative only: it takes no focus or tab stop and has no automation peer, so the
         tab order and screen-reader walk are those of the buttons inside it. -->
    <Style x:Key="GameCenter.ModAction.Group" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="0,14,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                       Style="{StaticResource GameCenter.ModAction.GroupLabel}" Margin="0" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Height="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Background="{DynamicResource GameCenter.Border}" SnapsToDevicePixels="True" />
                        </Grid>
                        <ContentPresenter />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Official mod action rows. One copper Open, then quiet grouped lists (Update, Files & logs,
         Manage): each group is a short label over one rounded container, rows are separated by a
         hairline, and only hover, focus and the uninstall row's red text add colour. -->
    <SolidColorBrush x:Key="GameCenter.ModAction.ListBackground" Color="#262626" />
    <SolidColorBrush x:Key="GameCenter.ModAction.ListLine" Color="#3A3A3A" />
    <SolidColorBrush x:Key="GameCenter.ModAction.RowHover" Color="#333333" />
    <SolidColorBrush x:Key="GameCenter.ModAction.DangerRowHover" Color="#3A1A1A" />

    <!-- Leading Segoe MDL2 glyph from the button's Tag, then the plain label string. -->
    <DataTemplate x:Key="GameCenter.ModAction.GlyphLabelTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                       FontFamily="Segoe MDL2 Assets" FontSize="13" FontWeight="Normal"
                       Margin="0,0,9,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <!-- Every-state primary (Install, Repair): the copper fill at 40px with a leading glyph
         carried in Tag. Content stays the plain label string. -->
    <Style x:Key="GameCenter.ModAction.OpenButton" TargetType="Button" BasedOn="{StaticResource GameCenter.ModAction.PrimaryButton}">
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Tag" Value="&#xE8A7;" />
        <Setter Property="ContentTemplate" Value="{StaticResource GameCenter.ModAction.GlyphLabelTemplate}" />
    </Style>

    <!-- Group: a quiet label over one rounded container. Decorative only: no focus, no tab stop and
         no automation peer, so the tab order and screen-reader walk are those of the rows inside. -->
    <Style x:Key="GameCenter.ModAction.RowGroup" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="0,14,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <StackPanel>
                        <TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                   Style="{StaticResource GameCenter.ModAction.GroupLabel}" />
                        <Border Background="{DynamicResource GameCenter.ModAction.ListBackground}"
                                BorderBrush="{DynamicResource GameCenter.ModAction.ListLine}" BorderThickness="1"
                                CornerRadius="10" Padding="3" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hairline between two rows of one group; decorative, never hit-tested. -->
    <Style x:Key="GameCenter.ModAction.RowSeparator" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="Background" Value="{DynamicResource GameCenter.ModAction.ListLine}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- One full-width row: leading MDL2 glyph from Tag, then the label. The glyph takes its colour
         from BorderBrush (the row draws no border), so a derived style can tint it without a new
         template. Disabled rows fade their content; focus draws the shared white ring inside the row. -->
    <Style x:Key="GameCenter.ModAction.Row" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.TextMuted}" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Grid x:Name="Content">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           FontWeight="Normal" Foreground="{TemplateBinding BorderBrush}"
                                           VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  RecognizesAccessKey="True">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}, FallbackValue=White}" />
                                            <Setter Property="FontFamily" Value="Segoe UI" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                        <Border x:Name="FocusRing" Margin="1" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource GameCenter.Focus}"
                                Visibility="Collapsed" IsHitTestVisible="False" SnapsToDevicePixels="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Content" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Content" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.ModAction.RowHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.PanelPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Rows that leave the launcher show a quiet trailing glyph: external page or File Explorer. -->
    <Style x:Key="GameCenter.ModAction.ExternalRow" TargetType="Button" BasedOn="{StaticResource GameCenter.ModAction.Row}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding}" />
                        <TextBlock Grid.Column="1" Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   FontWeight="Normal" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource GameCenter.TextMuted}" />
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GameCenter.ModAction.LogFileRow" TargetType="Button" BasedOn="{StaticResource GameCenter.ModAction.Row}">
        <Setter Property="Tag" Value="&#xE8A5;" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding}" />
                        <TextBlock Grid.Column="1" Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   FontWeight="Normal" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource GameCenter.TextMuted}" />
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Update row. Its DataContext is the mod's ServerManagerItemViewModel. Copper glyph, bolder
         label and an "Available" tag only when IsUpdateAvailable confirms the selected release is
         ahead; every other state (current, unknown, busy, failed) stays the quiet row. -->
    <Style x:Key="GameCenter.ModAction.UpdateRow" TargetType="Button" BasedOn="{StaticResource GameCenter.ModAction.Row}">
        <Setter Property="Tag" Value="&#xE777;" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding}" />
                        <Border x:Name="Available" Grid.Column="1" Margin="8,0,0,0" Padding="7,1" CornerRadius="8"
                                BorderThickness="1" BorderBrush="{DynamicResource GameCenter.CopperEdge}"
                                Background="{DynamicResource GameCenter.CopperTint}" Visibility="Collapsed">
                            <TextBlock Text="Available" FontSize="11" />
                        </Border>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsUpdateAvailable, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="True">
                            <Setter TargetName="Available" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.CopperStrong}" />
                <Setter Property="FontWeight" Value="Bold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Uninstall: red text and glyph in the Manage list, no outline; a dark red wash on hover. The
         typed confirmation dialog keeps the filled red. -->
    <Style x:Key="GameCenter.ModAction.DangerRow" TargetType="Button" BasedOn="{StaticResource GameCenter.ModAction.Row}">
        <Setter Property="Tag" Value="&#xE74D;" />
        <Setter Property="Foreground" Value="{DynamicResource GameCenter.DangerText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.DangerText}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.ModAction.DangerRowHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.DangerPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Release row: a non-interactive label row holding the segmented release choice. -->
    <Style x:Key="GameCenter.ModAction.ReleaseRow" TargetType="Grid">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Margin" Value="9,0,3,0" />
    </Style>

    <!-- Segmented release choice over the manager's own Branches list and SelectedBranch: one
         segment per real option, so Main/Dev mods show two and Dev-only mods show one. A ListBox
         keeps single selection, Tab lands once on the selected segment, and the arrow keys move the
         selection, as in a radio group. Disabled fades the whole control. Segments show and announce
         the release label (Dev reads as Beta); the bound choice itself stays "Main"/"Dev". -->
    <themes:BranchDisplayNameConverter x:Key="GameCenter.BranchDisplayName" />

    <Style x:Key="GameCenter.ModAction.ReleaseSegmentItem" TargetType="ListBoxItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding Converter={StaticResource GameCenter.BranchDisplayName}}" />
        <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Segment" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, FallbackValue=White}" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <Border x:Name="FocusRing" Margin="1" CornerRadius="5" BorderThickness="1"
                                BorderBrush="{DynamicResource GameCenter.Focus}"
                                Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Segment" Property="Background" Value="{DynamicResource GameCenter.PanelHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GameCenter.ModAction.ReleaseSelector" TargetType="ListBox">
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource GameCenter.ModAction.ReleaseSegmentItem}" />
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource GameCenter.BranchDisplayName}}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border x:Name="Track" Background="#1A1A1A" CornerRadius="8" Padding="2" SnapsToDevicePixels="True">
                        <ItemsPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GameCenter.SuccessButton" TargetType="Button" BasedOn="{StaticResource GameCenter.Button}">
        <Setter Property="Background" Value="{DynamicResource GameCenter.Success}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.SuccessHover}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.SuccessHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.SuccessEdge}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.SuccessPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.SuccessEdge}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Ploofy.ai panel: mirrors the dashboard's .dashboard-ploofy frame (dark #0f0e0e, 14px corners,
         cyan hairline and glow that brighten on hover and focus); the whole panel is the link. -->
    <Style x:Key="GameCenter.PloofyLinkButton" TargetType="Button">
        <Setter Property="Background" Value="#0F0E0E" />
        <Setter Property="BorderBrush" Value="#4000E5FF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <Border.Effect>
                                <DropShadowEffect Color="#00E5FF" ShadowDepth="0" BlurRadius="18" Opacity="0.12" />
                            </Border.Effect>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                        <Border x:Name="FocusRing"
                                Margin="-4"
                                CornerRadius="18"
                                BorderBrush="#00E5FF"
                                BorderThickness="2"
                                Visibility="Collapsed"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="#8000E5FF" />
                            <Setter TargetName="Border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#00E5FF" ShadowDepth="0" BlurRadius="22" Opacity="0.22" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="#8000E5FF" />
                            <Setter TargetName="Border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#00E5FF" ShadowDepth="0" BlurRadius="22" Opacity="0.22" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Launcher self-update remains green when actionable and turns neutral when current. -->
    <Style x:Key="GameCenter.LauncherUpdateButton" TargetType="Button" BasedOn="{StaticResource GameCenter.SuccessButton}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="10,8" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource GameCenter.PanelRaised}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.BorderStrong}" />
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GameCenter.DangerButton" TargetType="Button" BasedOn="{StaticResource GameCenter.Button}">
        <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.Danger}" />
        <Setter Property="Foreground" Value="{DynamicResource GameCenter.DangerText}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.DangerHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.Danger}" />
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.DangerPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.Danger}" />
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Filled red destructive action, for the final confirmation of a purge in the uninstall and
         update dialogs. DangerButton is the outline treatment for risky actions; this one is filled
         so the confirming click never reads as just another secondary button. The label
         stays the same near-white in every state - hover and pressed move the fill, not the text -
         which keeps it above 5:1 on the burgundy-red fill and matches the brand buttons next to it. -->
    <Style x:Key="GameCenter.ServerUninstallButton" TargetType="Button" BasedOn="{StaticResource GameCenter.DangerButton}">
        <Setter Property="Background" Value="{DynamicResource GameCenter.Danger}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.Danger}" />
        <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.DangerHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.CopperStrong}" />
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.DangerPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.CopperStrong}" />
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource GameCenter.PanelRaised}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.BorderStrong}" />
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Uninstall inside a mod's action panel: a restrained danger outline under the Manage label
         rather than a red fill, so removal stays clearly destructive without competing with the
         panel's primary action. The typed confirmation in the dialog keeps the filled red. -->
    <Style x:Key="GameCenter.ModAction.UninstallButton" TargetType="Button" BasedOn="{StaticResource GameCenter.DangerButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="10,0" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource GameCenter.PanelRaised}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.BorderStrong}" />
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Force Stop: always labelled and always reachable, but neutral at rest so it does not shout
         beside Start and Stop. Hover, press and keyboard focus switch it to the danger treatment;
         focus also keeps the base template's white focus ring. High contrast uses the system button
         colours, and the trigger order keeps it there over the focus, hover and press tones. -->
    <Style x:Key="GameCenter.ForceStopButton" TargetType="Button" BasedOn="{StaticResource GameCenter.Button}">
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.Danger}" />
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.DangerText}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.DangerHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.Danger}" />
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.DangerPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.Danger}" />
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
            </Trigger>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True" />
                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True" />
                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The header's one Start / Stop runtime button. Green while it starts the server; a Tag of "Stop"
         turns it red while it stops one that is starting or running. Both fills keep the near-white
         label in every state: hover and press darken the fill and take a lighter outline rather than
         lightening it, so the label stays above 4.5:1. Disabled drops to the neutral raised tier, as
         the other filled buttons do. The label always says which action it is, so colour is never
         the only signal, and high contrast swaps to the system button colours; those triggers come
         last so they win over every state above. Based on GameCenter.Button, not PrimaryButton, so
         no burgundy hover can leak through. -->
    <Style x:Key="GameCenter.ServerRuntimeButton" TargetType="Button" BasedOn="{StaticResource GameCenter.Button}">
        <Setter Property="Background" Value="{DynamicResource GameCenter.Success}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.SuccessHover}" />
        <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.SuccessPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.SuccessEdge}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.SuccessPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.SuccessEdge}" />
            </Trigger>
            <Trigger Property="Tag" Value="Stop">
                <Setter Property="Background" Value="{DynamicResource GameCenter.Danger}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.Danger}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Tag" Value="Stop" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource GameCenter.DangerHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.CopperStrong}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Tag" Value="Stop" />
                    <Condition Property="IsPressed" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource GameCenter.DangerPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.CopperStrong}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource GameCenter.PanelRaised}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.BorderStrong}" />
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
            </Trigger>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True" />
                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True" />
                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Constructive actions (Install, Generate logs) in Start Server's green: the same fills, darker hover
         and press, neutral disabled tier, and high-contrast system colours last so they win. It has no
         Stop state; destructive actions keep the burgundy and red styles. -->
    <Style x:Key="GameCenter.GoButton" TargetType="Button" BasedOn="{StaticResource GameCenter.Button}">
        <Setter Property="Background" Value="{DynamicResource GameCenter.Success}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.SuccessHover}" />
        <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.SuccessPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.SuccessEdge}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.SuccessPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.SuccessEdge}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource GameCenter.PanelRaised}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.BorderStrong}" />
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
            </Trigger>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True" />
                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True" />
                    <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Open on the official mod panels: the OpenButton shape (40px, leading glyph) in the GoButton
         green, keeping GoButton's hover, pressed, disabled and high-contrast states. -->
    <Style x:Key="GameCenter.ModAction.GoOpenButton" TargetType="Button" BasedOn="{StaticResource GameCenter.GoButton}">
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Tag" Value="&#xE8A7;" />
        <Setter Property="ContentTemplate" Value="{StaticResource GameCenter.ModAction.GlyphLabelTemplate}" />
    </Style>

    <!-- Dark action menus. Items keep the button type system: Segoe UI
         SemiBold 12 on the raised panel, a copper outline on the highlighted (hovered or arrow-key)
         item, and the muted treatment when an item's command cannot run. The label's TextBlock style
         binds to the item so the app-wide TextBlock style never repaints a disabled item white.
         High contrast swaps to the system menu colours. -->
    <Style x:Key="GameCenter.MenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinWidth" Value="188" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Border" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"
                                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}, FallbackValue=White}" />
                                    <Setter Property="FontFamily" Value="Segoe UI" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Template triggers outrank style setters, so the high-contrast menu text also wins over
                             derived styles such as GameCenter.DangerMenuItem. Later triggers override earlier ones. -->
                        <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.MenuTextBrushKey}}" />
                        </DataTrigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource GameCenter.PanelHover}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource GameCenter.CopperEdge}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
                            <Setter TargetName="Border" Property="Opacity" Value="0.55" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True" />
                                <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True" />
                                <Condition Binding="{Binding IsHighlighted, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Force Stop keeps the danger text tone inside the menu, as the old header button did on focus. -->
    <Style x:Key="GameCenter.DangerMenuItem" TargetType="MenuItem" BasedOn="{StaticResource GameCenter.MenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource GameCenter.DangerText}" />
    </Style>

    <Style x:Key="GameCenter.MenuSeparator" TargetType="Separator">
        <Setter Property="Margin" Value="4,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource GameCenter.Border}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GameCenter.Menu" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource GameCenter.PanelRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Placement" Value="Bottom" />
        <Setter Property="VerticalOffset" Value="4" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource GameCenter.MenuItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.MenuBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.MenuTextBrushKey}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- "Manage server" disclosure in a mod's action panel. Branch choice, rollback and removal sit
         behind it so the everyday view is the webpage, the update and the links. The header is a
         34px outline toggle in the compact secondary tier with a chevron that turns when open; it is
         the only tab stop (the Expander itself takes none) and Space or Enter toggles it. The
         Expander exposes ExpandCollapse to assistive technology. Collapsed content is not in the tab
         order. -->
    <Style x:Key="GameCenter.ModAction.ManageExpander" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="HeaderSite" Cursor="Hand" Height="34" MinHeight="34"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Content="{TemplateBinding Header}"
                                      Foreground="{TemplateBinding Foreground}"
                                      AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}"
                                      AutomationProperties.HelpText="{TemplateBinding AutomationProperties.HelpText}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid>
                                        <Border x:Name="Border" Background="Transparent" BorderBrush="{DynamicResource GameCenter.Border}"
                                                BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
                                            <Grid Margin="10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True">
                                                    <ContentPresenter.Resources>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}, FallbackValue=White}" />
                                                            <Setter Property="FontFamily" Value="Segoe UI" />
                                                            <Setter Property="FontSize" Value="12" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </Style>
                                                    </ContentPresenter.Resources>
                                                </ContentPresenter>
                                                <TextBlock x:Name="Chevron" Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="10" VerticalAlignment="Center"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                                            </Grid>
                                        </Border>
                                        <Border x:Name="FocusRing" Margin="2" CornerRadius="6" BorderBrush="{DynamicResource GameCenter.Focus}"
                                                BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False" SnapsToDevicePixels="True" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource GameCenter.BorderStrong}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource GameCenter.PanelHover}" />
                                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource GameCenter.CopperEdge}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource GameCenter.PanelPressed}" />
                                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource GameCenter.CopperStrong}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Border" Property="Opacity" Value="0.45" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ExpandSite" Margin="0,10,0,0" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GameCenter.NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="Padding" Value="12,12" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"
                                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}, FallbackValue=White}" />
                                    <Setter Property="FontFamily" Value="Segoe UI" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource GameCenter.PanelHover}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource GameCenter.CopperEdge}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource GameCenter.PanelRaised}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource GameCenter.CopperStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource GameCenter.Focus}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quiet sidebar entries. -->
    <Style x:Key="GameCenter.UtilityButton" TargetType="Button" BasedOn="{StaticResource GameCenter.Button}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
        <Setter Property="Padding" Value="10,8" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.PanelHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.CopperEdge}" />
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.PanelPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.CopperStrong}" />
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Window chrome buttons: square, borderless, no copper accent. These keep their own
         template so the rounded, outlined treatment of GameCenter.Button never
         reaches the caption glyphs. -->
    <Style x:Key="GameCenter.CaptionButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}, FallbackValue=White}" />
                                        <Setter Property="FontFamily" Value="Segoe UI" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <Border x:Name="FocusRing"
                                Margin="2"
                                BorderBrush="{DynamicResource GameCenter.Focus}"
                                BorderThickness="1"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.PanelHover}" />
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.PanelPressed}" />
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GameCenter.CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource GameCenter.CaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.CaptionClose}" />
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.DangerPressed}" />
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GameCenter.CheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box"
                                Width="15"
                                Height="15"
                                Background="{DynamicResource GameCenter.Window}"
                                BorderBrush="{DynamicResource GameCenter.BorderStrong}"
                                BorderThickness="1"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <Path x:Name="Check"
                                  Width="9"
                                  Height="7"
                                  Data="M 1,3.5 L 3.5,6 L 8,1"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Margin="5,0,0,0"
                                          RecognizesAccessKey="True"
                                          VerticalAlignment="Center">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground"
                                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type CheckBox}}, FallbackValue=White}" />
                                    <Setter Property="FontFamily" Value="Segoe UI" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource GameCenter.Success}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GameCenter.SuccessHover}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GameCenter.CopperStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GameCenter.CopperStrong}" />
                            <Setter TargetName="Box" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GameCenter.Focus}" />
                            <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Checkbox for a Settings row where the row title IS the label, so the box sits to the
         left of the title and clicking the title toggles the setting. Scoped to that layout on
         purpose: it is larger (20x20 box in a 24x24 target) and carries the row-title type ramp,
         neither of which suits the compact GameCenter.CheckBox used inline elsewhere. -->
    <Style x:Key="GameCenter.SettingCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <!-- Gap between the 24px box column and the label. Description text under the row
             indents by 32 (24 + 8) to line up with the label rather than the box. -->
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Always-present 1px ring so gaining focus never reflows the row. -->
                    <Border x:Name="FocusRing"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="1">
                        <!-- Column 0 is the 24x24 hit target; the visible 20x20 box centres in it. -->
                        <Grid Background="Transparent" MinHeight="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box"
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource GameCenter.Window}"
                                    BorderBrush="{DynamicResource GameCenter.BorderStrong}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    SnapsToDevicePixels="True">
                                <Path x:Name="Check"
                                      Width="12"
                                      Height="9"
                                      Data="M 1,4.5 L 4.5,8 L 11,1"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type CheckBox}}, FallbackValue=White}" />
                                        <Setter Property="FontFamily" Value="Segoe UI" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource GameCenter.Success}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GameCenter.SuccessHover}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GameCenter.CopperStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GameCenter.CopperStrong}" />
                            <Setter TargetName="Box" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <!-- Ring plus box outline: the label is the click target, so the focus
                             cue has to read across the whole control, not just the box. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource GameCenter.Focus}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GameCenter.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dropdown rows are drawn on charcoal with explicit light text so an item can never
         render blank-on-blank, whatever shape the item source has. -->
    <Style x:Key="GameCenter.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource GameCenter.PanelRaised}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource GameCenter.CopperStrong}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource GameCenter.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GameCenter.ComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
        <Setter Property="Background" Value="{DynamicResource GameCenter.PanelRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource GameCenter.ComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="22" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="SelectionBox"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  IsHitTestVisible="False">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                                <Path x:Name="Arrow"
                                      Grid.Column="1"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0,0 L 9,0 L 4.5,5.5 Z"
                                      Fill="{DynamicResource GameCenter.CopperStrong}"
                                      IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <ToggleButton x:Name="DropDownToggle"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsTabStop="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Border x:Name="FocusRing"
                                Margin="2"
                                CornerRadius="2"
                                BorderBrush="{DynamicResource GameCenter.Focus}"
                                BorderThickness="1"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True" />
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               StaysOpen="False"
                               PopupAnimation="None"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{DynamicResource GameCenter.Panel}"
                                    BorderBrush="{DynamicResource GameCenter.CopperStrong}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Margin="0,2,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource GameCenter.PanelHover}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource GameCenter.CopperEdge}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource GameCenter.CopperStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource GameCenter.TextMuted}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Left sidebar game rows: a flat icon-and-name row, not a card. Selection is a quiet dark
         fill plus the copper accent bar; keyboard focus adds a separate outline in the row's text
         colour, so focus and selection never look the same. The template only reads the item's
         Background, Foreground and BorderBrush (the accent bar), so the high contrast triggers
         below can swap all three for system colours without fighting template setters. -->
    <Style x:Key="GameCenter.RailItem" TargetType="ListBoxItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding Name, StringFormat={}{0} game}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Padding" Value="10,0,6,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                        <Border Width="3" Margin="0,9" HorizontalAlignment="Left" CornerRadius="1.5"
                                Background="{TemplateBinding BorderBrush}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <Border x:Name="FocusRing" BorderBrush="{TemplateBinding Foreground}" BorderThickness="2"
                                CornerRadius="3" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- Later triggers win: hover, then selection, then the high contrast overrides. -->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.PanelHover}" />
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#161616" />
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.CopperStrong}" />
            </Trigger>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True" />
                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Scroll bars: one implicit style so every launcher ScrollViewer (including those inside TextBox,
         ListBox and ComboBox templates) picks it up without per-control changes. Only the
         ScrollBar chrome is replaced: PART_Track, the standard ScrollBar line/page commands and
         Track's own viewport sizing, direction and drag handling are kept, and wheel/keyboard
         scrolling stays with ScrollViewer. Dark neutral track, legible grey thumb, copper on hover
         and drag; system colours in high contrast. -->
    <Style x:Key="GameCenter.ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="#6E6E6E" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <!-- Transparent outer border keeps the full bar width draggable; the grip is drawn inset. -->
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <Border x:Name="Grip" Background="{TemplateBinding Background}" CornerRadius="3" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.CopperEdge}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.CopperStrong}" />
            </Trigger>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True" />
                    <Condition Binding="{Binding IsDragging, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Track areas either side of the thumb: invisible, but still page on click/hold. -->
    <Style x:Key="GameCenter.ScrollBar.PageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small chevron line buttons at each end; the chevron is the button's Content. -->
    <Style x:Key="GameCenter.ScrollBar.LineButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="#9A9A9A" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.CopperEdge}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.CopperStrong}" />
            </Trigger>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True" />
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GameCenter.ScrollBar.Chevron" TargetType="Path">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}" />
    </Style>

    <ControlTemplate x:Key="GameCenter.ScrollBar.VerticalTemplate" TargetType="ScrollBar">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                </Grid.RowDefinitions>
                <RepeatButton Grid.Row="0" Style="{StaticResource GameCenter.ScrollBar.LineButton}" Command="ScrollBar.LineUpCommand">
                    <Path Style="{StaticResource GameCenter.ScrollBar.Chevron}" Data="M 0,4 L 3.5,0 L 7,4" Height="4" />
                </RepeatButton>
                <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource GameCenter.ScrollBar.PageButton}" Command="ScrollBar.PageUpCommand" />
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource GameCenter.ScrollBar.PageButton}" Command="ScrollBar.PageDownCommand" />
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource GameCenter.ScrollBar.Thumb}" Padding="3,0" />
                    </Track.Thumb>
                </Track>
                <RepeatButton Grid.Row="2" Style="{StaticResource GameCenter.ScrollBar.LineButton}" Command="ScrollBar.LineDownCommand">
                    <Path Style="{StaticResource GameCenter.ScrollBar.Chevron}" Data="M 0,0 L 3.5,4 L 7,0" Height="4" />
                </RepeatButton>
            </Grid>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="GameCenter.ScrollBar.HorizontalTemplate" TargetType="ScrollBar">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                </Grid.ColumnDefinitions>
                <RepeatButton Grid.Column="0" Style="{StaticResource GameCenter.ScrollBar.LineButton}" Command="ScrollBar.LineLeftCommand">
                    <Path Style="{StaticResource GameCenter.ScrollBar.Chevron}" Data="M 4,0 L 0,3.5 L 4,7" Width="4" />
                </RepeatButton>
                <Track x:Name="PART_Track" Grid.Column="1" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource GameCenter.ScrollBar.PageButton}" Command="ScrollBar.PageLeftCommand" />
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource GameCenter.ScrollBar.PageButton}" Command="ScrollBar.PageRightCommand" />
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource GameCenter.ScrollBar.Thumb}" Padding="0,3" />
                    </Track.Thumb>
                </Track>
                <RepeatButton Grid.Column="2" Style="{StaticResource GameCenter.ScrollBar.LineButton}" Command="ScrollBar.LineRightCommand">
                    <Path Style="{StaticResource GameCenter.ScrollBar.Chevron}" Data="M 0,0 L 4,3.5 L 0,7" Width="4" />
                </RepeatButton>
            </Grid>
        </Border>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="Background" Value="#1A1A1A" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Template" Value="{StaticResource GameCenter.ScrollBar.VerticalTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template" Value="{StaticResource GameCenter.ScrollBar.HorizontalTemplate}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                <Setter Property="BorderThickness" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ScrollViewer: the native Aero2 template part for part (same named parts, bindings, CanContentScroll,
         Padding and computed visibility), only re-colouring the square where both bars meet, which the
         native template fills with the light SystemColors.ControlBrush. The theme style still applies
         underneath; controls that set their own ScrollViewer template are unaffected. -->
    <Style TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Rectangle x:Name="Corner" Grid.Column="1" Grid.Row="1" Fill="#1A1A1A" RadiusX="3" RadiusY="3" />
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Column="0" Grid.Row="0"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                CanHorizontallyScroll="False" CanVerticallyScroll="False"
                                                Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                Margin="{TemplateBinding Padding}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" AutomationProperties.AutomationId="VerticalScrollBar"
                                   Cursor="Arrow" Grid.Column="1" Grid.Row="0" Minimum="0"
                                   Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar" AutomationProperties.AutomationId="HorizontalScrollBar"
                                   Cursor="Arrow" Grid.Column="0" Grid.Row="1" Minimum="0" Orientation="Horizontal"
                                   Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                                   Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                            <Setter TargetName="Corner" Property="Fill" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                            <Setter TargetName="Corner" Property="RadiusX" Value="0" />
                            <Setter TargetName="Corner" Property="RadiusY" Value="0" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
