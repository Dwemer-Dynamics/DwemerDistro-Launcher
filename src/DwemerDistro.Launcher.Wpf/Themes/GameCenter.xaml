    <!-- Compact secondary tier for the supporting actions inside a mod's action panel. The one
         brand-filled action of the current state stays the strong call to action; these sit a
         step down at 34px with a transparent fill and a soft 1px outline, so the panel reads as one
         primary followed by supporting actions instead of a stack of equal-weight buttons.
         Geometry only - hover, pressed, focus, and disabled feedback all come from the base
         GameCenter.Button template, and the label stays full-strength white while enabled so the
         de-emphasis never costs contrast. Disabled falls back to the same neutral PanelRaised /
         BorderStrong / TextMuted treatment every other tier uses. -->
    <Style x:Key="GameCenter.ModAction.SecondaryButton" TargetType="Button" BasedOn="{StaticResource GameCenter.Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="10,0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.PanelHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.CopperEdge}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource GameCenter.PanelPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.CopperStrong}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource GameCenter.PanelRaised}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.BorderStrong}" />
                <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Brand-outlined variants of the compact secondary tier. They keep the mod's colour on the
         outline so a supporting action still belongs to its mod, but never take a brand fill at
         rest - the fill is reserved for that panel's primary action. Hover and pressed move the
         same two channels as the filled brand buttons (fill to the brand tint, outline to the
         brand tone), and disabled drops the brand for the shared neutral treatment. -->
    <Style x:Key="GameCenter.ModAction.ReignSecondaryButton" TargetType="Button" BasedOn="{StaticResource GameCenter.ModAction.SecondaryButton}">
        <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.Gold}" />
    </Style>

