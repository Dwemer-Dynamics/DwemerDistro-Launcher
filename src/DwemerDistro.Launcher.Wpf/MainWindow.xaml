<Window x:Class="DwemerDistro.Launcher.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:DwemerDistro.Launcher.Wpf.Views"
        mc:Ignorable="d"
        Title="Dwemer Launcher"
        Icon="Assets/DwemerDistro.ico"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="680"
        ResizeMode="CanResize"
        WindowStyle="None"
        Background="{DynamicResource GameCenter.Window}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="GameCenter.ActionCardButton" TargetType="Button" BasedOn="{StaticResource GameCenter.Button}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinWidth" Value="196" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style x:Key="GameCenter.LogButton" TargetType="Button" BasedOn="{StaticResource GameCenter.ActionCardButton}">
            <Setter Property="MinWidth" Value="168" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <Style x:Key="GameCenter.HeroUpdateCheckBox" TargetType="CheckBox" BasedOn="{StaticResource GameCenter.CheckBox}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <Grid x:Name="ShellGrid" Background="{DynamicResource GameCenter.Window}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="62" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="ConsoleRow" Height="38" />
            <RowDefinition Height="124" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="178" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="#1A1A1A"
                BorderBrush="{DynamicResource GameCenter.Border}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Chrome_MouseLeftButtonDown"
                MouseRightButtonUp="Chrome_MouseRightButtonUp">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                    <Image Source="Assets/DwemerDistro.png" Width="20" Height="20" Margin="0,0,9,0" />
                    <TextBlock Text="DWEMER LAUNCHER" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="—"
                        Style="{StaticResource GameCenter.CaptionButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Minimize Dwemer Launcher"
                        Click="MinimizeButton_Click" />
                <Button Grid.Column="2"
                        Content="□"
                        Style="{StaticResource GameCenter.CaptionButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Maximize or restore Dwemer Launcher"
                        Click="MaximizeButton_Click" />
                <Button Grid.Column="3"
                        Content="✕"
                        Style="{StaticResource GameCenter.CaptionCloseButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Close Dwemer Launcher"
                        Click="CloseButton_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Grid.RowSpan="4"
                Grid.Column="0"
                Background="#242424"
                BorderBrush="{DynamicResource GameCenter.Border}"
                BorderThickness="0,0,1,0">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <Image Source="Assets/dd_title.png" Height="62" Stretch="Uniform" HorizontalAlignment="Left" Margin="4,4,4,10" />
                    <TextBlock Text="LAUNCHER" Foreground="{DynamicResource GameCenter.Gold}" FontSize="12" FontWeight="Bold" Margin="5,0,0,12" />
                </StackPanel>
                <StackPanel x:Name="UtilityLandmark" Grid.Row="1" KeyboardNavigation.TabNavigation="Local">
                    <Button Style="{StaticResource GameCenter.UtilityButton}" Click="OpenSettingsDestination_Click"
                            AutomationProperties.Name="Settings" AutomationProperties.HelpText="Open launcher settings.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="22" />
                            <AccessText Text="_Settings" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenServerFolderCommand}" Style="{StaticResource GameCenter.UtilityButton}" AutomationProperties.Name="Server Folder">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Width="22" />
                            <AccessText Text="Server _Folder" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenWikiCommand}" Style="{StaticResource GameCenter.UtilityButton}" AutomationProperties.Name="Wiki">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" Width="22" />
                            <AccessText Text="_Wiki" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenDiscordCommand}" Style="{StaticResource GameCenter.UtilityButton}" AutomationProperties.Name="Discord">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" Width="22" />
                            <AccessText Text="_Discord" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="5,12,5,4">
                    <Button Command="{Binding UpdateLauncherCommand}" Style="{StaticResource GameCenter.LauncherUpdateButton}"
                            AutomationProperties.Name="{Binding LauncherUpdateButtonText}" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" Width="22" />
                            <TextBlock Text="{Binding LauncherUpdateButtonText}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding LauncherVersionText}" Foreground="{DynamicResource GameCenter.TextMuted}" FontSize="10" />
                    <TextBlock Text="{Binding LauncherUpdateStatusText}" Foreground="{Binding LauncherUpdateStatusColor}"
                               FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource GameCenter.Panel}"
                BorderBrush="{DynamicResource GameCenter.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="NavigationLandmark" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <RadioButton x:Name="LibraryNavButton" GroupName="Destination" Content="_LIBRARY" IsChecked="True"
                                 Style="{StaticResource GameCenter.NavButton}" Tag="0" Checked="DestinationNav_Checked" />
                    <RadioButton x:Name="SetupNavButton" GroupName="Destination" Content="SET_UP"
                                 Style="{StaticResource GameCenter.NavButton}" Tag="1" Checked="DestinationNav_Checked" />
                    <RadioButton x:Name="SettingsNavButton" GroupName="Destination" Content="_SETTINGS"
                                 Style="{StaticResource GameCenter.NavButton}" Tag="2" Checked="DestinationNav_Checked" />
                    <RadioButton x:Name="LogsNavButton" GroupName="Destination" Content="LO_GS"
                                 Style="{StaticResource GameCenter.NavButton}" Tag="3" Checked="DestinationNav_Checked" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding DistroUpdateButtonText}" Command="{Binding UpdateAllCommand}"
                            Style="{StaticResource GameCenter.AccentButton}" MinWidth="112" Margin="0,0,6,0"
                            AutomationProperties.Name="{Binding DistroUpdateButtonText}"
                            AutomationProperties.HelpText="Update the Dwemer Distro products that are included in updates." />
                    <Button Content="{Binding StartButtonText}" Command="{Binding StartServerCommand}"
                            Style="{StaticResource GameCenter.SuccessButton}" MinWidth="132" Margin="0,0,6,0"
                            AutomationProperties.Name="{Binding StartButtonText}"
                            AutomationProperties.HelpText="Start the complete Dwemer Distro stack." />
                    <Button Content="Stop" Command="{Binding StopServerCommand}" Style="{StaticResource GameCenter.Button}" Margin="0,0,6,0" />
                    <Button Content="Force Stop" Command="{Binding ForceStopServerCommand}" Style="{StaticResource GameCenter.DangerButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="2" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0"
                    MinHeight="0" ClipToBounds="True"
                    KeyboardNavigation.TabNavigation="Continue">
            <TabControl.Resources>
                <Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed" /></Style>
            </TabControl.Resources>

            <TabItem Header="Library">
                <Grid x:Name="LibraryLandmark" Margin="18,16,18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.15*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1*" MinWidth="280" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource GameCenter.Card}" Padding="0" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Background="#151515">
                                <Image x:Name="HeroArt" Source="{Binding SelectedGame.HeroImageSource}" Stretch="Uniform"
                                       AutomationProperties.Name="{Binding SelectedGame.Name, StringFormat={}{0} artwork}" />
                                <Border x:Name="HeroHighContrastFallback" Visibility="Collapsed"
                                        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" BorderThickness="2">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedGame.Name}" Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                                   FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedGame.GameTitle}" Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                                   Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Grid.Row="1" Margin="18,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedGame.Name}" Style="{StaticResource GameCenter.Heading}" />
                                    <TextBlock Text="{Binding SelectedGame.GameTitle}" Foreground="{DynamicResource GameCenter.Gold}"
                                               FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0">
                                    <Grid>
                                        <CheckBox x:Name="HeroChimUpdateCheckBox" Content="Updates"
                                                  IsChecked="{Binding IncludeHerikaServerUpdate}"
                                                  IsEnabled="{Binding IsUpdateIncludeReady}"
                                                  Command="{Binding SaveUpdateIncludeCommand}"
                                                  PreviewMouseLeftButtonDown="UpdateCheckBox_PreviewMouseLeftButtonDown"
                                                  AutomationProperties.Name="Include CHIM in updates"
                                                  ToolTip="{Binding UpdateIncludeStatusText}"
                                                  AutomationProperties.HelpText="{Binding UpdateIncludeStatusText}">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox" BasedOn="{StaticResource GameCenter.HeroUpdateCheckBox}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedGame.Key}" Value="CHIM">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                        <CheckBox x:Name="HeroStobeUpdateCheckBox" Content="Updates"
                                                  IsChecked="{Binding IncludeStobeServerUpdate}"
                                                  IsEnabled="{Binding IsUpdateIncludeReady}"
                                                  Command="{Binding SaveUpdateIncludeCommand}"
                                                  PreviewMouseLeftButtonDown="UpdateCheckBox_PreviewMouseLeftButtonDown"
                                                  AutomationProperties.Name="Include STOBE in updates"
                                                  ToolTip="{Binding UpdateIncludeStatusText}"
                                                  AutomationProperties.HelpText="{Binding UpdateIncludeStatusText}">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox" BasedOn="{StaticResource GameCenter.HeroUpdateCheckBox}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedGame.Key}" Value="STOBE">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                        <CheckBox x:Name="HeroDialecticUpdateCheckBox" Content="Updates"
                                                  IsChecked="{Binding IncludeDialecticServerUpdate}"
                                                  IsEnabled="{Binding IsUpdateIncludeReady}"
                                                  Command="{Binding SaveUpdateIncludeCommand}"
                                                  PreviewMouseLeftButtonDown="UpdateCheckBox_PreviewMouseLeftButtonDown"
                                                  AutomationProperties.Name="Include Dialectic in updates"
                                                  ToolTip="{Binding UpdateIncludeStatusText}"
                                                  AutomationProperties.HelpText="{Binding UpdateIncludeStatusText}">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox" BasedOn="{StaticResource GameCenter.HeroUpdateCheckBox}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedGame.Key}" Value="DIALECTIC">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                    </Grid>
                                    <TextBlock Text="Include this product when Update runs."
                                               Style="{StaticResource GameCenter.Caption}" FontSize="11"
                                               MaxWidth="200" TextAlignment="Right" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource GameCenter.Card}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="SERVER DETAILS" Style="{StaticResource GameCenter.SectionHeading}" />
                                <TextBlock Text="Status, branch, and product actions for the selected game."
                                           Style="{StaticResource GameCenter.Caption}" Margin="0,4,0,14" />
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <StackPanel x:Name="ChimDetails" Visibility="Collapsed">
                                    <TextBlock Text="CHIM / HerikaServer" FontWeight="SemiBold" FontSize="16" />
                                    <TextBlock Text="{Binding HerikaStatusText}" Foreground="{Binding HerikaStatusColor}" TextWrapping="Wrap" Margin="0,8,0,14" />
                                    <TextBlock Text="Update branch" Style="{StaticResource GameCenter.Caption}" Margin="0,0,0,5" />
                                    <ComboBox ItemsSource="{Binding HerikaBranches}" SelectedItem="{Binding TargetHerikaBranch}"
                                              Style="{StaticResource GameCenter.ComboBox}" HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="HerikaServer update branch"
                                              AutomationProperties.HelpText="Branch used the next time this product updates." />
                                    <Button Content="Open CHIM" Command="{Binding OpenChimCommand}" Style="{StaticResource GameCenter.Button}" Margin="0,16,0,8" />
                                    <Button Content="Rollback HerikaServer" Command="{Binding OpenHerikaRollbackCommand}" Style="{StaticResource GameCenter.Button}" />
                                </StackPanel>
                                <StackPanel x:Name="StobeDetails" Visibility="Collapsed">
                                    <TextBlock Text="STOBE / StobeServer" FontWeight="SemiBold" FontSize="16" />
                                    <TextBlock Text="{Binding StobeStatusText}" Foreground="{Binding StobeStatusColor}" TextWrapping="Wrap" Margin="0,8,0,14" />
                                    <TextBlock Text="Update branch" Style="{StaticResource GameCenter.Caption}" Margin="0,0,0,5" />
                                    <ComboBox ItemsSource="{Binding StobeBranches}" SelectedItem="{Binding TargetStobeBranch}"
                                              Style="{StaticResource GameCenter.ComboBox}" HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="StobeServer update branch"
                                              AutomationProperties.HelpText="Branch used the next time this product updates." />
                                    <Button Content="Open STOBE" Command="{Binding OpenStobeCommand}" Style="{StaticResource GameCenter.Button}" Margin="0,16,0,8" />
                                    <Button Content="Rollback StobeServer" Command="{Binding OpenStobeRollbackCommand}" Style="{StaticResource GameCenter.Button}" />
                                </StackPanel>
                                <StackPanel x:Name="DialecticDetails" Visibility="Collapsed">
                                    <TextBlock Text="Dialectic / DialecticServer" FontWeight="SemiBold" FontSize="16" />
                                    <TextBlock Text="{Binding DialecticStatusText}" Foreground="{Binding DialecticStatusColor}" TextWrapping="Wrap" Margin="0,8,0,14" />
                                    <TextBlock Text="Update branch" Style="{StaticResource GameCenter.Caption}" Margin="0,0,0,5" />
                                    <ComboBox ItemsSource="{Binding DialecticBranches}" SelectedItem="{Binding TargetDialecticBranch}"
                                              Style="{StaticResource GameCenter.ComboBox}" HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="DialecticServer update branch"
                                              AutomationProperties.HelpText="Branch used the next time this product updates." />
                                    <Button Content="Open Dialectic" Command="{Binding OpenDialecticCommand}" Style="{StaticResource GameCenter.Button}" Margin="0,16,0,8" />
                                    <Button Content="Rollback DialecticServer" Command="{Binding OpenDialecticRollbackCommand}" Style="{StaticResource GameCenter.Button}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Grid.Row="2" Text="{Binding UpdateIncludeStatusText}" Foreground="{Binding UpdateIncludeStatusColor}"
                                       TextWrapping="Wrap" Margin="0,12,0,0" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Setup">
                <Grid x:Name="SetupLandmark" Margin="18,16,18,12" MinHeight="0" ClipToBounds="True">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SETUP" Style="{StaticResource GameCenter.Heading}" />
                            <TextBlock Text="Install services and configure the distro for this PC. Component checks load only when this page opens."
                                       Style="{StaticResource GameCenter.Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Quick Setup" Command="{Binding OpenFirstRunSetupCommand}" Style="{StaticResource GameCenter.Button}" Margin="0,0,8,0" />
                            <Button Content="Configure CUDA" Command="{Binding OpenCudaConfigCommand}" Style="{StaticResource GameCenter.Button}" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource GameCenter.Card}" Padding="0" ClipToBounds="True">
                        <views:InstallComponentsView x:Name="SetupComponentsView" MinHeight="0" />
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer x:Name="SettingsLandmark" VerticalScrollBarVisibility="Auto" Padding="18,16,18,12">
                    <StackPanel>
                        <TextBlock Text="SETTINGS" Style="{StaticResource GameCenter.Heading}" />
                        <TextBlock Text="Launcher preferences, setup, diagnostics, backups, recovery tools, and logs."
                                   Style="{StaticResource GameCenter.Caption}" Margin="0,4,0,16" />
                        <TextBlock Text="SETUP" Style="{StaticResource GameCenter.SectionHeading}" Margin="0,0,0,10" />
                        <WrapPanel>
                            <Button Command="{Binding OpenFirstRunSetupCommand}" Style="{StaticResource GameCenter.ActionCardButton}" Content="Quick Setup" />
                            <Button Command="{Binding OpenCudaConfigCommand}" Style="{StaticResource GameCenter.ActionCardButton}" Content="Configure CUDA" />
                        </WrapPanel>
                        <TextBlock Text="DIAGNOSTICS AND MAINTENANCE" Style="{StaticResource GameCenter.SectionHeading}" Margin="0,12,0,10" />
                        <WrapPanel>
                            <Button Command="{Binding GenerateDiagnosticsCommand}" Style="{StaticResource GameCenter.ActionCardButton}" Content="Create Diagnostic File" />
                            <Button Command="{Binding DistroDoctorCommand}" Style="{StaticResource GameCenter.ActionCardButton}" Content="Run Distro Doctor" />
                            <Button Command="{Binding OpenTerminalCommand}" Style="{StaticResource GameCenter.ActionCardButton}" Content="Open Terminal" />
                            <Button Command="{Binding ViewMemoryUsageCommand}" Style="{StaticResource GameCenter.ActionCardButton}" Content="View Memory Usage" />
                            <Button Command="{Binding FixWslDnsCommand}" Style="{StaticResource GameCenter.ActionCardButton}" Content="Fix WSL DNS" />
                            <Button Command="{Binding ReclaimDistroDiskSpaceCommand}" Style="{StaticResource GameCenter.ActionCardButton}" Content="Reclaim Disk Space" />
                            <Button Command="{Binding ExportDistroCommand}" Style="{StaticResource GameCenter.ActionCardButton}" Content="Export Distro Backup" />
                            <Button Command="{Binding ImportDistroCommand}" Style="{StaticResource GameCenter.ActionCardButton}" Content="Import Distro Backup" />
                            <Button Command="{Binding CleanLogsCommand}" Style="{StaticResource GameCenter.ActionCardButton}" Content="Clean All Logs" />
                        </WrapPanel>
                        <TextBlock Text="ROLLBACK" Style="{StaticResource GameCenter.SectionHeading}" Margin="0,12,0,10" />
                        <WrapPanel>
                            <Button Command="{Binding OpenHerikaRollbackCommand}" Style="{StaticResource GameCenter.ActionCardButton}" Content="Rollback HerikaServer" />
                            <Button Command="{Binding OpenStobeRollbackCommand}" Style="{StaticResource GameCenter.ActionCardButton}" Content="Rollback StobeServer" />
                            <Button Command="{Binding OpenDialecticRollbackCommand}" Style="{StaticResource GameCenter.ActionCardButton}" Content="Rollback DialecticServer" />
                        </WrapPanel>
                        <Border Style="{StaticResource GameCenter.Card}" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Dwemer Dashboard WebUI" Style="{StaticResource GameCenter.SectionHeading}" />
                                    <TextBlock Text="Open the Dashboard when the distro starts. Applies on the next server start."
                                               Style="{StaticResource GameCenter.Caption}" Margin="0,4,14,0" />
                                    <TextBlock Text="{Binding DashboardAutoOpenStatusText}" Foreground="{Binding DashboardAutoOpenStatusColor}"
                                               Margin="0,5,14,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox Grid.Column="1" Content="Open on start" IsChecked="{Binding DashboardAutoOpenEnabled}"
                                          Command="{Binding SaveDashboardAutoOpenCommand}" Style="{StaticResource GameCenter.CheckBox}"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <TextBlock Text="VIEW LOGS" Style="{StaticResource GameCenter.SectionHeading}" Margin="0,22,0,10" />
                        <WrapPanel>
                            <Button Command="{Binding ViewXttsLogsCommand}" Style="{StaticResource GameCenter.LogButton}" Content="Dwemer Distro XTTS" />
                            <Button Command="{Binding ViewChatterboxLogsCommand}" Style="{StaticResource GameCenter.LogButton}" Content="Chatterbox" />
                            <Button Command="{Binding ViewPocketTtsLogsCommand}" Style="{StaticResource GameCenter.LogButton}" Content="PocketTTS" />
                            <Button Command="{Binding ViewMeloTtsLogsCommand}" Style="{StaticResource GameCenter.LogButton}" Content="MeloTTS" />
                            <Button Command="{Binding ViewPiperLogsCommand}" Style="{StaticResource GameCenter.LogButton}" Content="Piper" />
                            <Button Command="{Binding ViewLocalWhisperLogsCommand}" Style="{StaticResource GameCenter.LogButton}" Content="LocalWhisper" />
                            <Button Command="{Binding ViewParakeetLogsCommand}" Style="{StaticResource GameCenter.LogButton}" Content="Parakeet" />
                            <Button Command="{Binding ViewApacheLogsCommand}" Style="{StaticResource GameCenter.LogButton}" Content="Apache" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Logs">
                <ScrollViewer x:Name="LogsLandmark" VerticalScrollBarVisibility="Auto" Padding="18,16,18,12">
                    <StackPanel>
                        <TextBlock Text="LOGS" Style="{StaticResource GameCenter.Heading}" />
                        <TextBlock Text="Collect a debugging bundle, or open a live service log in a terminal window."
                                   Style="{StaticResource GameCenter.Caption}" Margin="0,4,0,14" />
                        <Border Style="{StaticResource GameCenter.Card}" BorderBrush="{DynamicResource GameCenter.Gold}" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="DISTRO DEBUGGING LOGS" Style="{StaticResource GameCenter.SectionHeading}" />
                                    <TextBlock Text="Bundles distro diagnostics into a single file to share when asking for support."
                                               Style="{StaticResource GameCenter.Caption}" Margin="0,4,16,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Generate Distro Debugging Logs"
                                        Command="{Binding GenerateDiagnosticsCommand}"
                                        Style="{StaticResource GameCenter.PrimaryButton}"
                                        MinWidth="238" MinHeight="40" VerticalAlignment="Center"
                                        AutomationProperties.Name="Generate distro debugging logs"
                                        AutomationProperties.HelpText="Create a diagnostic file with distro logs and system details." />
                            </Grid>
                        </Border>
                        <TextBlock Text="LIVE LOGS" Style="{StaticResource GameCenter.SectionHeading}" Margin="0,0,0,4" />
                        <TextBlock Text="Open a live service log in a terminal window." Style="{StaticResource GameCenter.Caption}" Margin="0,0,0,12" />
                        <WrapPanel>
                            <Button Command="{Binding ViewXttsLogsCommand}" Style="{StaticResource GameCenter.LogButton}" Content="Dwemer Distro XTTS" />
                            <Button Command="{Binding ViewChatterboxLogsCommand}" Style="{StaticResource GameCenter.LogButton}" Content="Chatterbox" />
                            <Button Command="{Binding ViewPocketTtsLogsCommand}" Style="{StaticResource GameCenter.LogButton}" Content="PocketTTS" />
                            <Button Command="{Binding ViewMeloTtsLogsCommand}" Style="{StaticResource GameCenter.LogButton}" Content="MeloTTS" />
                            <Button Command="{Binding ViewPiperLogsCommand}" Style="{StaticResource GameCenter.LogButton}" Content="Piper" />
                            <Button Command="{Binding ViewLocalWhisperLogsCommand}" Style="{StaticResource GameCenter.LogButton}" Content="LocalWhisper" />
                            <Button Command="{Binding ViewParakeetLogsCommand}" Style="{StaticResource GameCenter.LogButton}" Content="Parakeet" />
                            <Button Command="{Binding ViewApacheLogsCommand}" Style="{StaticResource GameCenter.LogButton}" Content="Apache" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border x:Name="ConsoleScrim" Grid.Row="2" Grid.Column="1" Background="#99000000" Visibility="Collapsed" Panel.ZIndex="9" />
        <Border x:Name="ConsoleDockHost" Grid.Row="3" Grid.Column="1" Background="#1A1A1A"
                BorderBrush="{DynamicResource GameCenter.BorderStrong}" BorderThickness="0,1,0,0" Panel.ZIndex="10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Button x:Name="ToggleConsoleButton" Content="Expand Output"
                        Style="{StaticResource GameCenter.UtilityButton}" HorizontalContentAlignment="Left" Padding="18,8"
                        AutomationProperties.Name="Expand Output" Click="ToggleConsoleButton_Click" />
                <RichTextBox x:Name="OutputRichTextBox" Grid.Row="1" Margin="14,0,14,12" Padding="10" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="#090909" Foreground="White" BorderBrush="{DynamicResource GameCenter.Border}"
                             BorderThickness="1" FontFamily="Consolas" FontSize="11"
                             AutomationProperties.Name="Dwemer Distro output console" />
            </Grid>
        </Border>

        <Border Grid.Row="4" Grid.Column="1" Background="#1A1A1A" BorderBrush="{DynamicResource GameCenter.Border}"
                BorderThickness="0,1,0,0" Padding="18,12">
            <ListBox x:Name="GameRail" ItemsSource="{Binding GameProfiles}" SelectedItem="{Binding SelectedGame}"
                     ItemContainerStyle="{StaticResource GameCenter.RailItem}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     KeyboardNavigation.DirectionalNavigation="Contained" SelectionChanged="GameRail_SelectionChanged"
                     AutomationProperties.Name="Dwemer game selection">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" Columns="3" /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="96">
                            <Grid ClipToBounds="True" Background="#151515">
                                <Image Source="{Binding RailImageSource}" Stretch="UniformToFill">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <Border Background="#50000000" />
                                <StackPanel Margin="12,10" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" />
                                    <TextBlock Text="{Binding GameTitle}" FontSize="9" Foreground="#E0E0E0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Window>
