<Window x:Class="DwemerDistro.Launcher.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:DwemerDistro.Launcher.Wpf.Views"
        mc:Ignorable="d"
        Title="DWEMER DISTRO"
        Icon="Assets/DwemerDistro.ico"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="680"
        ResizeMode="CanResize"
        WindowStyle="None"
        Background="{DynamicResource GameCenter.Window}"
        BorderBrush="Black"
        BorderThickness="1"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="GameCenter.ActionCardButton" TargetType="Button" BasedOn="{StaticResource GameCenter.Button}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinWidth" Value="196" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <!-- Compact actions for Settings and Logs, matching the Components card buttons: the shared
             GameCenter template (focus ring, pressed, disabled) at 28px, neutral fill, copper edge on hover. -->
        <Style x:Key="GameCenter.CompactButton" TargetType="Button" BasedOn="{StaticResource GameCenter.Button}">
            <Setter Property="Background" Value="{DynamicResource GameCenter.PanelHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.Border}" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="MinHeight" Value="28" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#454545" />
                    <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.CopperEdge}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.CopperEdge}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource GameCenter.PanelPressed}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.CopperStrong}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GameCenter.CompactGoButton" TargetType="Button" BasedOn="{StaticResource GameCenter.GoButton}">
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="76" />
        </Style>
        <!-- Live log chips: sized to their icon and short label, so the row stays one compact strip. -->
        <Style x:Key="GameCenter.LogButton" TargetType="Button" BasedOn="{StaticResource GameCenter.CompactButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="8,3,10,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
        </Style>
        <Style x:Key="GameCenter.LogButtonIcon" TargetType="Image">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        </Style>
        <!-- Settings rows: one full-width card per setting, stacked vertically. The title and
             wrapped explanation take the flexible column so descriptions stay readable down to
             the 980px minimum width; the action stays compact in the Auto column. -->
        <Style x:Key="GameCenter.SettingRow" TargetType="Border" BasedOn="{StaticResource GameCenter.Card}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="GameCenter.SettingRowTitle" TargetType="TextBlock" BasedOn="{StaticResource GameCenter.SectionHeading}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="GameCenter.SettingRowDescription" TargetType="TextBlock" BasedOn="{StaticResource GameCenter.Caption}">
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="GameCenter.SettingRowButton" TargetType="Button" BasedOn="{StaticResource GameCenter.CompactButton}">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Optional custom mod game and author lines collapse when the registry has none. -->
        <Style x:Key="CustomMod.OptionalText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            </Style.Triggers>
        </Style>
        <!-- Component belt status light. Tag carries a ComponentServiceState; only Running is green, and the
             words in the tooltip and accessible status always say the same thing, so colour is never the only cue.
             The dark ring keeps the 7px light legible over any icon. -->
        <Style x:Key="ComponentBelt.Light" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="#8C8C8C" />
            <Setter Property="Stroke" Value="{DynamicResource GameCenter.Panel}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Running"><Setter Property="Fill" Value="#3FCB5A" /></DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Starting"><Setter Property="Fill" Value="#F0A830" /></DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Stopped"><Setter Property="Fill" Value="#EF4444" /></DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="NotResponding"><Setter Property="Fill" Value="#EF4444" /></DataTrigger>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Stroke" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- The two Pocket-TTS runtimes share one mascot, so each wears its hardware mark in the top-left
             corner (NVIDIA for the GPU audio.cpp build, AMD for the CPU Python build) opposite the light.
             Every other component keeps it collapsed. Decorative: the cell's name already names the runtime. -->
        <Style x:Key="ComponentBelt.HardwareBadge" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{DynamicResource GameCenter.Panel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.Panel}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Id}" Value="audiocpp">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Tag" Value="pack://application:,,,/DwemerDistro;component/Assets/nvidia.png" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Id}" Value="pockettts">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Tag" Value="pack://application:,,,/DwemerDistro;component/Assets/amd.png" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- One read-only belt cell: a 28px tile with the component's mark and its light in the bottom-right
             corner. It takes keyboard focus (the arrow keys move within the belt) so the tooltip, which names
             the service, its actual port and its status, opens for keyboard users too. -->
        <Style x:Key="ComponentBelt.Cell" TargetType="ContentControl">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="IsTabStop" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border x:Name="Tile" Background="{DynamicResource GameCenter.PanelRaised}"
                                BorderBrush="{DynamicResource GameCenter.Border}" BorderThickness="1" CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource GameCenter.PanelHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource GameCenter.Focus}" />
                                <Setter TargetName="Tile" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The +N overflow toggle wears the same tile so the belt reads as one strip. -->
        <Style x:Key="ComponentBelt.OverflowToggle" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="6,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Tile" Background="{DynamicResource GameCenter.PanelRaised}"
                                BorderBrush="{DynamicResource GameCenter.Border}" BorderThickness="1" CornerRadius="4"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource GameCenter.PanelHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource GameCenter.CopperStrong}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource GameCenter.Focus}" />
                                <Setter TargetName="Tile" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="ShellGrid" Background="{DynamicResource GameCenter.Window}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="ConsoleRow" Height="38" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="178" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="#1A1A1A"
                BorderBrush="{DynamicResource GameCenter.Border}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Chrome_MouseLeftButtonDown"
                MouseRightButtonUp="Chrome_MouseRightButtonUp">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                    <Image Source="Assets/DwemerDistro.png" Width="20" Height="20" Margin="0,0,9,0" />
                    <TextBlock Text="DWEMER DISTRO" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="—"
                        Style="{StaticResource GameCenter.CaptionButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Minimize Dwemer Distro"
                        Click="MinimizeButton_Click" />
                <Button Grid.Column="2"
                        Content="□"
                        Style="{StaticResource GameCenter.CaptionButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Maximize or restore Dwemer Distro"
                        Click="MaximizeButton_Click" />
                <Button Grid.Column="3"
                        Content="✕"
                        Style="{StaticResource GameCenter.CaptionCloseButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Close Dwemer Distro"
                        Click="CloseButton_Click" />
            </Grid>
        </Border>

        <!-- One header row across the whole window, above the rail: the six destinations on the left
             and the server controls on the right. Spanning the rail column is what lets
             both fit on a single line down to the 980px minimum without shrinking any text, and it
             sits before the rail in the tree so Tab and F6 read the window top to bottom. -->
        <Border x:Name="HeaderBar" Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource GameCenter.Panel}"
                BorderBrush="{DynamicResource GameCenter.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Each destination leads with a decorative 12px MDL2 glyph; the accessible name stays the
                     plain label. The glyphs cost 18px a tab, so these tabs pad 6px a side instead of 12px to
                     leave the component belt room for its compact count at the 980px minimum. -->
                <StackPanel x:Name="NavigationLandmark" Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style x:Key="HeaderNavButton" TargetType="RadioButton" BasedOn="{StaticResource GameCenter.NavButton}">
                            <Setter Property="Padding" Value="6,12" />
                        </Style>
                        <Style x:Key="HeaderNavGlyph" TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="FontWeight" Value="Normal" />
                            <Setter Property="Width" Value="12" />
                            <Setter Property="Margin" Value="0,0,6,0" />
                            <Setter Property="TextAlignment" Value="Center" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </StackPanel.Resources>
                    <RadioButton x:Name="LibraryNavButton" GroupName="Destination" IsChecked="True"
                                 Style="{StaticResource HeaderNavButton}" Tag="0" Checked="DestinationNav_Checked"
                                 AutomationProperties.Name="Mods">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA86;" Style="{StaticResource HeaderNavGlyph}" />
                            <AccessText Text="_Mods" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SetupNavButton" GroupName="Destination"
                                 Style="{StaticResource HeaderNavButton}" Tag="1" Checked="DestinationNav_Checked"
                                 AutomationProperties.Name="Components">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE950;" Style="{StaticResource HeaderNavGlyph}" />
                            <AccessText Text="_Components" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SettingsNavButton" GroupName="Destination"
                                 Style="{StaticResource HeaderNavButton}" Tag="2" Checked="DestinationNav_Checked"
                                 AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource HeaderNavGlyph}" />
                            <AccessText Text="_Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ApiKeysNavButton" GroupName="Destination"
                                 Style="{StaticResource HeaderNavButton}" Tag="5" Checked="DestinationNav_Checked"
                                 AutomationProperties.Name="API Keys">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8D7;" Style="{StaticResource HeaderNavGlyph}" />
                            <AccessText Text="API _Keys" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="AssistantNavButton" GroupName="Destination"
                                 Style="{StaticResource HeaderNavButton}" Tag="4" Checked="DestinationNav_Checked"
                                 AutomationProperties.Name="Assistant">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F2;" Style="{StaticResource HeaderNavGlyph}" />
                            <AccessText Text="_Assistant" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="LogsNavButton" GroupName="Destination"
                                 Style="{StaticResource HeaderNavButton}" Tag="3" Checked="DestinationNav_Checked"
                                 AutomationProperties.Name="Logs">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F9;" Style="{StaticResource HeaderNavGlyph}" />
                            <AccessText Text="Lo_gs" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <!-- Component status belt: the header's spare width between the destinations and the server
                     controls, on every tab. It only takes what is left over (the star column), so the tabs and
                     the command slots keep their widths; cells that do not fit go behind a +N dropdown, and when
                     none fit the dropdown alone is a compact count. Read-only: nothing here starts, stops or
                     changes a service. One Tab stop; the arrow keys move between cells. -->
                <Grid x:Name="ComponentBeltHost" Grid.Column="1" Margin="12,0,0,0" ClipToBounds="True"
                      DataContext="{Binding ComponentBelt}" SizeChanged="ComponentBeltHost_SizeChanged"
                      KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Contained">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ItemsControl x:Name="ComponentBeltItems" ItemsSource="{Binding VisibleItems}" Focusable="False"
                                      AutomationProperties.Name="Component services">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Style="{StaticResource ComponentBelt.Cell}"
                                                    MouseLeftButtonUp="ComponentTest_MouseUp" KeyDown="ComponentTest_KeyDown" Cursor="Hand"
                                                    AutomationProperties.Name="{Binding Name}"
                                                    AutomationProperties.ItemStatus="{Binding StatusText}"
                                                    AutomationProperties.HelpText="{Binding Summary}">
                                        <ContentControl.ToolTip>
                                            <ToolTip>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding PortText}" />
                                                    <TextBlock Text="{Binding ShortStatusText}" />
                                                    <TextBlock Text="Click to test" Margin="0,6,0,0" />
                                                </StackPanel>
                                            </ToolTip>
                                        </ContentControl.ToolTip>
                                        <Grid>
                                            <Image Source="{Binding ArtworkSource}" Width="18" Height="18" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <Ellipse Style="{StaticResource ComponentBelt.Light}" Tag="{Binding State}"
                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                                            <Border Style="{StaticResource ComponentBelt.HardwareBadge}" Margin="1,1,0,0">
                                                <Image Source="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                        </Grid>
                                    </ContentControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ToggleButton x:Name="ComponentBeltOverflowButton" Style="{StaticResource ComponentBelt.OverflowToggle}"
                                      Visibility="{Binding HasOverflow, Converter={StaticResource BoolToVisibility}}"
                                      AutomationProperties.Name="{Binding OverflowAccessibleName}"
                                      ToolTip="{Binding OverflowAccessibleName}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding OverflowText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <!-- The worst hidden state, so a red service never hides behind +N. -->
                                <Ellipse Style="{StaticResource ComponentBelt.Light}" Tag="{Binding OverflowState}"
                                         VerticalAlignment="Bottom" Margin="3,0,0,1" />
                            </StackPanel>
                        </ToggleButton>
                        <Popup x:Name="ComponentBeltOverflowPopup" PlacementTarget="{Binding ElementName=ComponentBeltOverflowButton}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               IsOpen="{Binding IsChecked, ElementName=ComponentBeltOverflowButton, Mode=TwoWay}"
                               Opened="ComponentBeltOverflowPopup_Opened">
                            <Border Background="{DynamicResource GameCenter.PanelRaised}" BorderBrush="{DynamicResource GameCenter.Border}"
                                    BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,4,0,0" MaxWidth="420"
                                    PreviewKeyDown="ComponentBeltOverflowPopup_PreviewKeyDown"
                                    KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
                                <ItemsControl x:Name="ComponentBeltOverflowList" ItemsSource="{Binding OverflowItems}" Focusable="False"
                                              AutomationProperties.Name="More component services">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Rows spell out name, port and status, so the light is never the only cue. -->
                                            <ContentControl Focusable="True" IsTabStop="True" FocusVisualStyle="{x:Null}"
                                                            MouseLeftButtonUp="ComponentTest_MouseUp" KeyDown="ComponentTest_KeyDown" Cursor="Hand"
                                                            AutomationProperties.Name="{Binding Name}"
                                                            AutomationProperties.ItemStatus="{Binding StatusText}"
                                                            AutomationProperties.HelpText="{Binding Summary}">
                                                <ContentControl.Template>
                                                    <ControlTemplate TargetType="ContentControl">
                                                        <Border x:Name="Row" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="6,4">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource GameCenter.Focus}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ContentControl.Template>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="22" Height="22" Margin="0,1,8,0" VerticalAlignment="Top">
                                                        <Image Source="{Binding ArtworkSource}" Width="18" Height="18" Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                        <Ellipse Style="{StaticResource ComponentBelt.Light}" Tag="{Binding State}"
                                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                        <Border Style="{StaticResource ComponentBelt.HardwareBadge}">
                                                            <Image Source="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Border>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                                            <Run Text="{Binding PortText, Mode=OneWay}" FontWeight="Normal"
                                                                 Foreground="{DynamicResource GameCenter.TextMuted}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11"
                                                                   Foreground="{DynamicResource GameCenter.TextMuted}" />
                                                    </StackPanel>
                                                </Grid>
                                            </ContentControl>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                        <!-- Before the first probe there is nothing to list yet; one quiet grey chip says why. -->
                        <ContentControl Style="{StaticResource ComponentBelt.Cell}" Width="Auto" Margin="0"
                                        Visibility="{Binding ShowsPlaceholder, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.Name="Component services"
                                        AutomationProperties.ItemStatus="{Binding PlaceholderText}"
                                        ToolTip="{Binding PlaceholderText}">
                            <StackPanel Orientation="Horizontal" Margin="7,0">
                                <Ellipse Style="{StaticResource ComponentBelt.Light}" Tag="Unknown" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock Text="Services" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource GameCenter.TextMuted}" />
                            </StackPanel>
                        </ContentControl>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <!-- Upgrade DwemerDistro: only while a fresh Debian 13 upgrade is offered (lab rollout), on every tab,
                         immediately left of Start. A press rechecks and asks Upgrade DwemerDistro or Later first; a stale
                         offer says so and nothing runs in its place. The label only changes while its own recheck or run
                         is going. The copper ring around it pulses briefly when the offer appears; only its opacity moves,
                         it is never hit-tested, and MainWindow skips it when Windows turns client-area animation off or
                         uses high contrast. -->
                    <Grid Margin="0,0,8,0" VerticalAlignment="Center"
                          Visibility="{Binding IsDebianUpgradeBarVisible, Converter={StaticResource BoolToVisibility}}">
                        <Button x:Name="UpgradeDwemerDistroButton" Command="{Binding UpgradeDwemerDistroCommand}"
                                Padding="10,6" ToolTipService.ShowOnDisabled="True"
                                AutomationProperties.Name="Upgrade DwemerDistro"
                                AutomationProperties.ItemStatus="{Binding DebianUpgradeTopBarText}"
                                AutomationProperties.HelpText="{Binding DebianUpgradeAvailableText}"
                                ToolTip="{Binding DebianUpgradeAvailableText}">
                            <Button.Style>
                                <!-- Copper fill like the mod panels' primary action; hover, pressed and disabled are
                                     re-stated because the base outline style would otherwise win. -->
                                <Style TargetType="Button" BasedOn="{StaticResource GameCenter.ModAction.CopperOutlineButton}">
                                    <Setter Property="Background" Value="{DynamicResource GameCenter.Copper}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.CopperStrong}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource GameCenter.CopperHover}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource GameCenter.CopperPressed}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource GameCenter.PanelRaised}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.BorderStrong}" />
                                            <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <!-- Decorative glyph: the accessible name already says what the button does. -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontWeight="Normal"
                                           Width="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DebianUpgradeTopBarText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border x:Name="UpgradeDwemerDistroPulse" Margin="-3" CornerRadius="11" BorderThickness="2"
                                BorderBrush="{DynamicResource GameCenter.CopperStrong}"
                                Opacity="0" IsHitTestVisible="False" Focusable="False"
                                SnapsToDevicePixels="True" />
                    </Grid>
                    <!-- One runtime button: green Start while stopped, red Stop while the
                         server is starting or running, each on its own unchanged command and guard, so
                         Stop stays reachable during startup. Startup progress shows as a small spinner
                         beside the label, plus the tooltip, help text and item status, so the label always
                         names what a press will do; the frame reserves the spinner, glyph and longer label
                         in every state so the width never changes. The Preview handlers drop the second press
                         of a double-click and a held Enter key, which would otherwise stop the server the
                         first press had just started. -->
                    <Button x:Name="ServerRuntimeButton" Padding="10,6" Margin="0,0,6,0"
                            ToolTipService.ShowOnDisabled="True"
                            PreviewMouseLeftButtonDown="ServerRuntimeButton_PreviewMouseLeftButtonDown"
                            PreviewKeyDown="ServerRuntimeButton_PreviewKeyDown">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GameCenter.ServerRuntimeButton}">
                                <Setter Property="Command" Value="{Binding StartServerCommand}" />
                                <Setter Property="Content" Value="Start" />
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <!-- Content stays the plain label string. A hidden row reserves the
                                             widest state (spinner + glyph + the longer of Start and Stop) so
                                             the frame hugs its content without jumping; the visible row is
                                             centred inside it. The spinner shows only while starting, turns
                                             only while Windows client-area animation is on, and is
                                             removed from the clock again when startup ends. -->
                                        <DataTemplate>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" Visibility="Hidden">
                                                    <FrameworkElement Width="14" />
                                                    <FrameworkElement Width="18" />
                                                    <Grid>
                                                        <TextBlock Text="Start" />
                                                        <TextBlock Text="Stop" />
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Path x:Name="StartingSpinner"
                                                          Width="10" Height="10" Margin="0,0,4,0"
                                                          VerticalAlignment="Center"
                                                          Data="M5,1 A4,4 0 1 1 1,5"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          RenderTransformOrigin="0.5,0.5"
                                                          Visibility="Collapsed" IsHitTestVisible="False" Focusable="False">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0" />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                    <!-- Decorative play / stop glyph; the accessible name already says what a press does. -->
                                                    <TextBlock x:Name="RuntimeGlyph" Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="12" FontWeight="Normal" Width="12" Margin="0,0,6,0" VerticalAlignment="Center"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                                </StackPanel>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="Stop">
                                                    <Setter TargetName="RuntimeGlyph" Property="Text" Value="&#xE71A;" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.IsServerStarting, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="True">
                                                    <Setter TargetName="StartingSpinner" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding DataContext.IsServerStarting, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="True" />
                                                        <Condition Binding="{Binding Path=(SystemParameters.ClientAreaAnimation)}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="StartingSpin">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="StartingSpinner"
                                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                 From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                    <MultiDataTrigger.ExitActions>
                                                        <RemoveStoryboard BeginStoryboardName="StartingSpin" />
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="AutomationProperties.Name" Value="Start Server" />
                                <Setter Property="AutomationProperties.ItemStatus" Value="Server stopped" />
                                <Setter Property="AutomationProperties.HelpText" Value="Start the complete Dwemer Distro stack." />
                                <Setter Property="ToolTip" Value="Server is stopped. Start the complete Dwemer Distro stack." />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                        <Setter Property="Tag" Value="Stop" />
                                        <Setter Property="Command" Value="{Binding StopServerCommand}" />
                                        <Setter Property="Content" Value="Stop" />
                                        <Setter Property="AutomationProperties.Name" Value="Stop Server" />
                                        <Setter Property="AutomationProperties.ItemStatus" Value="Server running" />
                                        <Setter Property="AutomationProperties.HelpText" Value="Stop the shared Dwemer Distro server." />
                                        <Setter Property="ToolTip" Value="Server is running. Stop the shared Dwemer Distro server." />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsServerStarting}" Value="True">
                                        <Setter Property="Tag" Value="Stop" />
                                        <Setter Property="Command" Value="{Binding StopServerCommand}" />
                                        <Setter Property="Content" Value="Stop" />
                                        <Setter Property="AutomationProperties.Name" Value="Stop Server" />
                                        <Setter Property="AutomationProperties.ItemStatus" Value="Server starting" />
                                        <Setter Property="AutomationProperties.HelpText" Value="The server is starting. Stop Server cancels the startup and stops the shared Dwemer Distro server." />
                                        <Setter Property="ToolTip" Value="Server is starting. Stop Server cancels the startup and stops the shared Dwemer Distro server." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <!-- Force Stop is its own labelled button on the original command and guard, neutral at
                         rest and red on hover, press or focus, so it never competes with Stop Server. -->
                    <Button Content="Force Stop" Command="{Binding ForceStopServerCommand}"
                            Style="{StaticResource GameCenter.ForceStopButton}" Padding="10,6"
                            ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="Force Stop Server"
                            AutomationProperties.HelpText="Terminate the DwemerDistro WSL distribution immediately, without a clean shutdown. Use this only when Stop Server does not respond."
                            ToolTip="Terminate the DwemerDistro WSL distribution immediately. Use this only when Stop Server does not respond." />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Grid.RowSpan="2"
                Grid.Column="0"
                Background="#242424"
                BorderBrush="{DynamicResource GameCenter.Border}"
                BorderThickness="0,0,1,0">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <Image Source="Assets/dd_title.png" Height="50" Stretch="Uniform" HorizontalAlignment="Center" Margin="4,2,4,14" />
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <!-- Top-level Official/Custom switch. Official keeps the existing game rail and
                         details exactly as before; Custom swaps in the distro-owned custom mod list. -->
                    <UniformGrid Columns="2" Margin="0,0,0,10" KeyboardNavigation.TabNavigation="Local"
                                 AutomationProperties.Name="Mods view">
                        <RadioButton GroupName="ModsView" Content="Official mods" Padding="2,7" FontSize="11"
                                     Style="{StaticResource GameCenter.NavButton}"
                                     IsChecked="{Binding IsOfficialModsView, Mode=TwoWay}"
                                     Click="ModsView_Click"
                                     AutomationProperties.Name="Official mods"
                                     AutomationProperties.HelpText="Show the official Dwemer Dynamics mods." />
                        <RadioButton GroupName="ModsView" Content="Custom mods" Padding="2,7" FontSize="11"
                                     Style="{StaticResource GameCenter.NavButton}"
                                     IsChecked="{Binding IsCustomModsView, Mode=TwoWay}"
                                     Click="ModsView_Click"
                                     AutomationProperties.Name="Custom mods"
                                     AutomationProperties.HelpText="Show mods you added from a repository." />
                    </UniformGrid>
                </StackPanel>
                <!-- Games and utilities share one scroll region so the utilities stay directly under
                     the list, and only this middle part scrolls if the window is ever too short.
                     The launcher update block below stays pinned to the bottom. -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel>
                        <ListBox x:Name="GameRail" ItemsSource="{Binding GameProfiles}" SelectedItem="{Binding SelectedGame, Mode=OneWay}"
                                 ItemContainerStyle="{StaticResource GameCenter.RailItem}" Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 KeyboardNavigation.DirectionalNavigation="Contained" SelectionChanged="GameRail_SelectionChanged"
                                 PreviewMouseLeftButtonUp="ModRail_PreviewMouseLeftButtonUp" PreviewKeyDown="ModRail_PreviewKeyDown"
                                 Visibility="{Binding IsOfficialModsView, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Dwemer game selection">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- The mod's own transparent emblem, whole and uncropped.
                                             High contrast drops the art, as the hero does, and keeps the name. -->
                                        <Image x:Name="GameIcon" Source="{Binding IconImageSource}" Width="26" Height="26" Margin="0,0,10,0"
                                               Stretch="Uniform" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <!-- Explicit, because the app-wide TextBlock style would otherwise
                                             replace the item's hover, selected and high contrast colours. -->
                                        <TextBlock Grid.Column="1" Text="{Binding Key}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                                            <Setter TargetName="GameIcon" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- LLM Studio sits with the official games but is not a game: its own list, so SelectedGame
                             keeps a game while this entry is selected. -->
                        <ListBox x:Name="LmStudioRail" Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 SelectionChanged="LmStudioRail_SelectionChanged"
                                 PreviewMouseLeftButtonUp="ModRail_PreviewMouseLeftButtonUp" PreviewKeyDown="ModRail_PreviewKeyDown"
                                 Visibility="{Binding IsOfficialModsView, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Local AI">
                            <ListBoxItem Style="{StaticResource GameCenter.RailItem}" IsSelected="{Binding IsLmStudioSelected, Mode=TwoWay}"
                                         AutomationProperties.Name="LLM Studio">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Centurion core emblem, sized like the game emblems above; high contrast drops it the same way. -->
                                    <Image Source="Assets/centurioncore.png" Width="26" Height="26" Margin="0,0,10,0"
                                           Stretch="Uniform" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <TextBlock Grid.Column="1" Text="LLM Studio" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </ListBoxItem>
                        </ListBox>
                        <StackPanel Visibility="{Binding IsCustomModsView, Converter={StaticResource BoolToVisibility}}"
                                    IsEnabled="{Binding IsComponentInteractionEnabled}">
                            <RadioButton Content="Browse mods" GroupName="CustomModNavigation" Margin="0,0,0,10"
                                         Style="{StaticResource GameCenter.NavButton}"
                                         IsChecked="{Binding IsBrowsingCustomMods, Mode=TwoWay}"
                                         Command="{Binding BrowseCommunityModsCommand}"
                                         AutomationProperties.Name="Browse mods"
                                         AutomationProperties.HelpText="Browse published custom mods in the main panel." />
                            <ListBox x:Name="CustomModRail" ItemsSource="{Binding CustomMods}" SelectedItem="{Binding SelectedCustomMod}"
                                     ItemContainerStyle="{StaticResource GameCenter.RailItem}" Background="Transparent" BorderThickness="0" Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     KeyboardNavigation.DirectionalNavigation="Contained"
                                     PreviewMouseLeftButtonUp="ModRail_PreviewMouseLeftButtonUp" PreviewKeyDown="ModRail_PreviewKeyDown"
                                     AutomationProperties.Name="Custom mod selection">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Installed icon, same size as the official emblems; without one the name stands alone. -->
                                            <Image x:Name="CustomModIcon" Source="{Binding IconImage}" Width="26" Height="26" Margin="0,0,10,0"
                                                   Stretch="Uniform" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IconImage}" Value="{x:Null}">
                                                <Setter TargetName="CustomModIcon" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                                                <Setter TargetName="CustomModIcon" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="No custom mods yet." Foreground="{DynamicResource GameCenter.TextMuted}" FontSize="11" Margin="5,2,0,6"
                                       Visibility="{Binding HasNoCustomMods, Converter={StaticResource BoolToVisibility}}" />
                            <Button Command="{Binding OpenCustomModCreationGuideCommand}" Style="{StaticResource GameCenter.UtilityButton}"
                                    Margin="0,6,0,0" AutomationProperties.Name="Build a Mod!"
                                    AutomationProperties.HelpText="Open the KAGRENAC repository in your browser."
                                    ToolTip="Open the KAGRENAC repository in your browser.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" Width="22" />
                                    <AccessText Text="_Build a Mod!" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="UtilityLandmark" Margin="0,14,0,0" KeyboardNavigation.TabNavigation="Local">
                            <Button Command="{Binding OpenServerFolderCommand}" Style="{StaticResource GameCenter.UtilityButton}" AutomationProperties.Name="Server Folder">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Width="22" />
                                    <AccessText Text="Server _Folder" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenTerminalCommand}" Style="{StaticResource GameCenter.UtilityButton}" AutomationProperties.Name="Terminal"
                                    AutomationProperties.HelpText="Open a shell inside the DwemerAI4Skyrim3 distro as the dwemer user."
                                    ToolTip="Open a shell inside the DwemerAI4Skyrim3 distro as the dwemer user.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" Width="22" />
                                    <AccessText Text="_Terminal" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenWikiCommand}" Style="{StaticResource GameCenter.UtilityButton}" AutomationProperties.Name="Wiki">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" Width="22" />
                                    <AccessText Text="_Wiki" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenDiscordCommand}" Style="{StaticResource GameCenter.UtilityButton}" AutomationProperties.Name="Discord">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" Width="22" />
                                    <AccessText Text="_Discord" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenPatreonCommand}" Style="{StaticResource GameCenter.UtilityButton}" AutomationProperties.Name="Patreon">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE006;" FontFamily="Segoe MDL2 Assets" Width="22" />
                                    <AccessText Text="_Patreon" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="3" Margin="5,12,5,4">
                    <TextBlock Text="Free Alpha!" HorizontalAlignment="Center" Margin="0,0,0,4"
                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GameCenter.Text}" />
                    <Button Command="{Binding OpenPloofyCommand}" Style="{StaticResource GameCenter.PloofyLinkButton}"
                            AutomationProperties.Name="Ploofy.ai"
                            AutomationProperties.HelpText="Open ploofy.ai in your web browser."
                            ToolTip="Open ploofy.ai in your web browser." Margin="0,0,0,12">
                        <Image Source="Assets/ploofy-logo.png" Height="40" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Button>
                    <Button Command="{Binding UpdateLauncherCommand}" Style="{StaticResource GameCenter.LauncherUpdateButton}"
                            AutomationProperties.Name="{Binding LauncherUpdateButtonText}"
                            AutomationProperties.HelpText="{Binding LauncherUpdateStatusText}" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" Width="22" />
                            <TextBlock Text="{Binding LauncherUpdateButtonText}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding LauncherVersionText}" Foreground="{DynamicResource GameCenter.TextMuted}" FontSize="10" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="2" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0"
                    MinHeight="0" ClipToBounds="True"
                    KeyboardNavigation.TabNavigation="Continue"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed" /></Style>
            </TabControl.Resources>

            <TabItem Header="Mods">
                <Grid>
                <Grid x:Name="LibraryLandmark" Margin="18,16,18,12"
                      Visibility="{Binding IsOfficialGameView, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.15*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1*" MinWidth="280" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource GameCenter.Card}" Padding="0" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Background="#151515">
                                <Image x:Name="HeroArt" Source="{Binding SelectedGame.HeroImageSource}" Stretch="Uniform"
                                       AutomationProperties.Name="{Binding SelectedGame.Name, StringFormat={}{0} artwork}" />
                                <Border x:Name="HeroHighContrastFallback" Visibility="Collapsed"
                                        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" BorderThickness="2">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedGame.Name}" Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                                   FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedGame.GameTitle}" Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                                   Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="18,14">
                                <TextBlock Text="{Binding SelectedGame.Name}" Style="{StaticResource GameCenter.ModTitle}" />
                                <TextBlock Text="{Binding SelectedGame.GameTitle}"
                                           Foreground="{DynamicResource GameCenter.Text}"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource GameCenter.Card}">
                        <Grid>
                            <!-- The card scrolls so the extra install/repair/uninstall actions never clip at the
                                 window's minimum size. -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False" Padding="0,0,2,0">
                                <Grid>
                                    <StackPanel x:Name="ChimDetails" Visibility="Collapsed">
                                        <!-- The branded title already sits under the artwork; this card only names the server. -->
                                        <TextBlock Text="HerikaServer" Style="{StaticResource GameCenter.Caption}" FontWeight="SemiBold" />

                                        <!-- Fixed-size status block. The single trimmed status line and the
                                             progress track below it always occupy the same space, so a busy or
                                             failed operation never resizes the actions underneath. -->
                                        <Grid Height="52" Margin="0,8,0,10">
                                            <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{Binding HerikaManager.StatusText}" Foreground="{Binding HerikaManager.StatusColor}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                                       ToolTip="{Binding HerikaManager.AccessibleStatusHelpText}"
                                                       AutomationProperties.Name="HerikaServer status"
                                                       AutomationProperties.HelpText="{Binding HerikaManager.AccessibleStatusHelpText}"
                                                       AutomationProperties.LiveSetting="Polite" />
                                            <ProgressBar Grid.Row="1" Height="6" VerticalAlignment="Top"
                                                         IsIndeterminate="{Binding HerikaManager.IsBusy}"
                                                         Background="#151515" BorderThickness="0"
                                                         Foreground="{DynamicResource GameCenter.CopperStrong}"
                                                         IsTabStop="False" Focusable="False"
                                                         AutomationProperties.Name="HerikaServer operation progress">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Opacity" Value="0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HerikaManager.IsBusy}" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </Grid>

                                        <!-- Not installed: choose the release, then install. Open, update and rollback stay out of reach until the server exists. -->
                                        <StackPanel Visibility="{Binding HerikaManager.ShowNotInstalledActions, Converter={StaticResource BoolToVisibility}}">
                                            <HeaderedContentControl Header="Install" Style="{StaticResource GameCenter.ModAction.RowGroup}">
                                                <StackPanel>
                                                    <Grid Style="{StaticResource GameCenter.ModAction.ReleaseRow}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource GameCenter.TextMuted}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Release" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GameCenter.Text}" VerticalAlignment="Center" />
                                                        <ListBox Grid.Column="2" ItemsSource="{Binding HerikaManager.Branches}" SelectedItem="{Binding HerikaManager.SelectedBranch}"
