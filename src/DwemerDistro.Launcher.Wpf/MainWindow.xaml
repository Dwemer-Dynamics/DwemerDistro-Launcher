                                                    AutomationProperties.HelpText="Download and install this server on the selected branch. Nothing else is changed." />
                                            <!-- Local game plugin log. The plugin can exist without the WSL
                                                 server, so this stays available in every install state and
                                                 never probes or starts WSL. -->
                                            <HeaderedContentControl Header="Logs" Style="{StaticResource GameCenter.ModAction.Group}">
                                                <Button Content="DIALECTIC Logs" Command="{Binding OpenDialecticLogsCommand}" Style="{StaticResource GameCenter.ModAction.LogRow}"
                                                        AutomationProperties.Name="Open DIALECTIC Logs"
                                                        AutomationProperties.HelpText="Open File Explorer with the local Fallout New Vegas dialectic.log selected. The local server is not started or contacted." />
                                            </HeaderedContentControl>
                                        </StackPanel>

                                        <!-- Installed: the webpage, then the update branch directly above the update it
                                             drives, then pages and logs, and rollback with the destructive purge last
                                             under Manage. The webpage is the primary action unless an update is confirmed;
                                             its Tag hands the shared style this mod's manager while the DataContext stays
                                             the view model its command lives on. -->
                                        <StackPanel Visibility="{Binding DialecticManager.ShowInstalledActions, Converter={StaticResource BoolToVisibility}}">
                                            <Button Content="Open DIALECTIC" Command="{Binding OpenDialecticCommand}" Tag="{Binding DialecticManager}"
                                                    Style="{StaticResource GameCenter.ModAction.WebpageButton}" Margin="0,0,0,12" Height="38"
                                                    AutomationProperties.Name="Open DIALECTIC"
                                                    AutomationProperties.HelpText="Open the Dialectic server webpage in your browser. If it is unavailable, the launcher can start the server first." />
                                            <TextBlock Text="Update branch" Style="{StaticResource GameCenter.Caption}" Margin="0,0,0,5" />
                                            <ComboBox ItemsSource="{Binding DialecticManager.Branches}" SelectedItem="{Binding DialecticManager.SelectedBranch}"
                                                      Style="{StaticResource GameCenter.ComboBox}" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="DialecticServer update branch"
                                                      IsEnabled="{Binding DialecticManager.CanUseInstalledFeatures}"
                                                      AutomationProperties.HelpText="Branch used the next time this mod updates. Unavailable while another server, component, or system operation is running." />
                                            <!-- Updates the shared system, then this mod on the branch chosen above.
                                                 Disabled during conflicting operations so controls never shift.
                                                 The manager is this button's DataContext so the shared update
                                                 style can watch IsUpdateAvailable and fill the button green
                                                 only for a confirmed newer version on the selected branch. -->
                                            <Button DataContext="{Binding DialecticManager}"
                                                    Content="{Binding UpdateActionName}" Command="{Binding UpdateCommand}"
                                                    Style="{StaticResource GameCenter.ModAction.UpdateButton}" Margin="0,8,0,0" Height="38"
                                                    AutomationProperties.Name="{Binding UpdateActionName}"
                                                    ToolTip="{Binding UpdateActionHelpText}"
                                                    AutomationProperties.HelpText="{Binding UpdateActionHelpText}" />
                                            <!-- External mod page and local game plugin log. Neither probes or starts
                                                 WSL, so they stay usable while the server is stopped or busy. -->
                                            <HeaderedContentControl Header="Pages and logs" Style="{StaticResource GameCenter.ModAction.Group}">
                                                <StackPanel>
                                                    <Button Content="Download Mod" Command="{Binding OpenDialecticNexusCommand}" Style="{StaticResource GameCenter.ModAction.SecondaryButton}" Margin="0,0,0,4"
                                                            AutomationProperties.Name="Download DIALECTIC from Nexus Mods"
                                                            AutomationProperties.HelpText="Open the Files tab of this mod's Nexus Mods page in your browser to download it. The local server is not started or contacted." />
                                                    <Button Content="DIALECTIC Logs" Command="{Binding OpenDialecticLogsCommand}" Style="{StaticResource GameCenter.ModAction.LogRow}"
                                                            AutomationProperties.Name="Open DIALECTIC Logs"
                                                            AutomationProperties.HelpText="Open File Explorer with the local Fallout New Vegas dialectic.log selected. The local server is not started or contacted." />
                                                </StackPanel>
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="Manage" Style="{StaticResource GameCenter.ModAction.Group}">
                                                <StackPanel>
                                                    <Button Content="Rollback DialecticServer" Command="{Binding OpenDialecticRollbackCommand}" Style="{StaticResource GameCenter.ModAction.SecondaryButton}"
                                                            AutomationProperties.Name="Rollback DialecticServer"
                                                            AutomationProperties.HelpText="Roll this server back to an earlier installed version." />
                                                    <Button Content="Uninstall Dialectic" Command="{Binding DialecticManager.UninstallCommand}"
                                                            Style="{StaticResource GameCenter.ModAction.UninstallButton}" Margin="0,8,0,0"
                                                            AutomationProperties.Name="Uninstall Dialectic"
                                                            AutomationProperties.HelpText="Permanently delete this server, its database, and all of its profiles, memories, settings, logs, uploads, and voices. Asks for a typed confirmation first." />
                                                </StackPanel>
                                            </HeaderedContentControl>
                                        </StackPanel>

                                        <!-- Needs repair: choose the branch and repair in place; logs next, the purge last under Manage. -->
                                        <StackPanel Visibility="{Binding DialecticManager.ShowRepairActions, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Repair branch" Style="{StaticResource GameCenter.Caption}" Margin="0,0,0,5" />
                                            <ComboBox ItemsSource="{Binding DialecticManager.Branches}" SelectedItem="{Binding DialecticManager.SelectedBranch}"
                                                      Style="{StaticResource GameCenter.ComboBox}" HorizontalAlignment="Stretch"
                                                      IsEnabled="{Binding DialecticManager.CanRepair}"
                                                      AutomationProperties.Name="DialecticServer repair branch"
                                                      AutomationProperties.HelpText="Branch this server is repaired onto." />
                                            <Button Content="Repair Installation" Command="{Binding DialecticManager.RepairCommand}"
                                                    Style="{StaticResource GameCenter.ModAction.PrimaryButton}" Margin="0,16,0,0" Height="38"
                                                    AutomationProperties.Name="Repair DialecticServer"
                                                    AutomationProperties.HelpText="Restore this server's files and database without deleting your data." />
                                            <!-- Local game plugin log. Windows-side only, so it never probes
                                                 or starts WSL and stays usable while the server needs repair. -->
                                            <HeaderedContentControl Header="Logs" Style="{StaticResource GameCenter.ModAction.Group}">
                                                <Button Content="DIALECTIC Logs" Command="{Binding OpenDialecticLogsCommand}" Style="{StaticResource GameCenter.ModAction.LogRow}"
                                                        AutomationProperties.Name="Open DIALECTIC Logs"
                                                        AutomationProperties.HelpText="Open File Explorer with the local Fallout New Vegas dialectic.log selected. The local server is not started or contacted." />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="Manage" Style="{StaticResource GameCenter.ModAction.Group}">
                                                <Button Content="Uninstall Dialectic" Command="{Binding DialecticManager.UninstallCommand}"
                                                        Style="{StaticResource GameCenter.ModAction.UninstallButton}"
                                                        AutomationProperties.Name="Uninstall Dialectic"
                                                        AutomationProperties.HelpText="Permanently delete this server, its database, and all of its profiles, memories, settings, logs, uploads, and voices. Asks for a typed confirmation first." />
                                            </HeaderedContentControl>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel x:Name="ReignDetails" Visibility="Collapsed">
                                        <!-- The branded title already sits under the artwork; this card only names the server. -->
                                        <TextBlock Text="ReignServer" Style="{StaticResource GameCenter.Caption}" FontWeight="SemiBold" />
                                        <Grid Height="52" Margin="0,8,0,10">
                                            <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{Binding ReignManager.StatusText}" Foreground="{Binding ReignManager.StatusColor}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                                       ToolTip="{Binding ReignManager.AccessibleStatusHelpText}"
                                                       AutomationProperties.Name="ReignServer status"
                                                       AutomationProperties.HelpText="{Binding ReignManager.AccessibleStatusHelpText}"
                                                       AutomationProperties.LiveSetting="Polite" />
                                            <ProgressBar Grid.Row="1" Height="6" VerticalAlignment="Top"
                                                         IsIndeterminate="{Binding ReignManager.IsBusy}"
                                                         Background="#151515" BorderThickness="0"
                                                         Foreground="{DynamicResource GameCenter.CopperStrong}"
                                                         IsTabStop="False" Focusable="False"
                                                         AutomationProperties.Name="ReignServer operation progress">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Opacity" Value="0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ReignManager.IsBusy}" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </Grid>
                                        <StackPanel Visibility="{Binding ReignManager.ShowNotInstalledActions, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Install branch" Style="{StaticResource GameCenter.Caption}" Margin="0,0,0,5" />
                                            <ComboBox ItemsSource="{Binding ReignManager.Branches}" SelectedItem="{Binding ReignManager.SelectedBranch}"
                                                      Style="{StaticResource GameCenter.ComboBox}" HorizontalAlignment="Stretch"
                                                      IsEnabled="{Binding ReignManager.CanInstall}"
                                                      AutomationProperties.Name="ReignServer install branch"
                                                      AutomationProperties.HelpText="Branch used when this server is installed." />
                                            <Button Content="Install Server" Command="{Binding ReignManager.InstallCommand}"
                                                    Style="{StaticResource GameCenter.ModAction.PrimaryButton}" Margin="0,16,0,0" Height="38"
                                                    AutomationProperties.Name="Install ReignServer"
                                                    AutomationProperties.HelpText="Download and install this server on the selected branch. Nothing else is changed." />
                                            <!-- Local game log. Windows-side only, so it stays available before the server is installed. -->
                                            <HeaderedContentControl Header="Logs" Style="{StaticResource GameCenter.ModAction.Group}">
                                                <Button Content="REIGN Logs" Command="{Binding OpenReignLogsCommand}" Style="{StaticResource GameCenter.ModAction.LogRow}"
                                                        AutomationProperties.Name="Open REIGN Logs"
                                                        AutomationProperties.HelpText="Select the local Bannerlord reignbeta.log in File Explorer, or open its folder if the log has not been created yet." />
                                            </HeaderedContentControl>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding ReignManager.ShowInstalledActions, Converter={StaticResource BoolToVisibility}}">
                                            <Button Content="Open REIGN" Command="{Binding OpenReignCommand}" Tag="{Binding ReignManager}"
                                                    Style="{StaticResource GameCenter.ModAction.WebpageButton}" Margin="0,0,0,12" Height="38"
                                                    AutomationProperties.Name="Open REIGN"
                                                    AutomationProperties.HelpText="Open the Reign server webpage in your browser. If it is unavailable, the launcher can start the server first." />
                                            <TextBlock Text="Update branch" Style="{StaticResource GameCenter.Caption}" Margin="0,0,0,5" />
                                            <ComboBox ItemsSource="{Binding ReignManager.Branches}" SelectedItem="{Binding ReignManager.SelectedBranch}"
                                                      Style="{StaticResource GameCenter.ComboBox}" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="ReignServer update branch"
                                                      IsEnabled="{Binding ReignManager.CanUseInstalledFeatures}"
                                                      AutomationProperties.HelpText="Branch used the next time this mod updates. Unavailable while another server, component, or system operation is running." />
                                            <Button DataContext="{Binding ReignManager}"
                                                    Content="{Binding UpdateActionName}" Command="{Binding UpdateCommand}"
                                                    Style="{StaticResource GameCenter.ModAction.UpdateButton}" Margin="0,8,0,0" Height="38"
                                                    AutomationProperties.Name="{Binding UpdateActionName}"
                                                    ToolTip="{Binding UpdateActionHelpText}"
                                                    AutomationProperties.HelpText="{Binding UpdateActionHelpText}" />
                                            <HeaderedContentControl Header="Logs" Style="{StaticResource GameCenter.ModAction.Group}">
                                                <Button Content="REIGN Logs" Command="{Binding OpenReignLogsCommand}" Style="{StaticResource GameCenter.ModAction.LogRow}"
                                                        AutomationProperties.Name="Open REIGN Logs"
                                                        AutomationProperties.HelpText="Select the local Bannerlord reignbeta.log in File Explorer, or open its folder if the log has not been created yet." />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="Manage" Style="{StaticResource GameCenter.ModAction.Group}">
                                                <StackPanel>
                                                    <Button Content="Rollback ReignServer" Command="{Binding OpenReignRollbackCommand}"
                                                            Style="{StaticResource GameCenter.ModAction.SecondaryButton}"
                                                            AutomationProperties.Name="Rollback ReignServer"
                                                            AutomationProperties.HelpText="Restore a compatible retained ReignServer build while preserving campaigns and settings." />
                                                    <Button Content="Uninstall Reign" Command="{Binding ReignManager.UninstallCommand}"
                                                            Style="{StaticResource GameCenter.ModAction.UninstallButton}" Margin="0,8,0,0"
                                                            AutomationProperties.Name="Uninstall Reign"
                                                            AutomationProperties.HelpText="Remove the installed server. Its database, settings, memories, and previous runtimes are retained. Asks for a typed confirmation first." />
                                                </StackPanel>
                                            </HeaderedContentControl>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding ReignManager.ShowRepairActions, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Repair branch" Style="{StaticResource GameCenter.Caption}" Margin="0,0,0,5" />
                                            <ComboBox ItemsSource="{Binding ReignManager.Branches}" SelectedItem="{Binding ReignManager.SelectedBranch}"
                                                      Style="{StaticResource GameCenter.ComboBox}" HorizontalAlignment="Stretch"
                                                      IsEnabled="{Binding ReignManager.CanRepair}"
                                                      AutomationProperties.Name="ReignServer repair branch"
                                                      AutomationProperties.HelpText="Branch this server is repaired onto." />
                                            <Button Content="Repair Installation" Command="{Binding ReignManager.RepairCommand}"
                                                    Style="{StaticResource GameCenter.ModAction.PrimaryButton}" Margin="0,16,0,0" Height="38"
                                                    AutomationProperties.Name="Repair ReignServer"
                                                    AutomationProperties.HelpText="Restore this server's files and database without deleting your data." />
                                            <HeaderedContentControl Header="Logs" Style="{StaticResource GameCenter.ModAction.Group}">
                                                <Button Content="REIGN Logs" Command="{Binding OpenReignLogsCommand}" Style="{StaticResource GameCenter.ModAction.LogRow}"
                                                        AutomationProperties.Name="Open REIGN Logs"
                                                        AutomationProperties.HelpText="Select the local Bannerlord reignbeta.log in File Explorer, or open its folder if the log has not been created yet." />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="Manage" Style="{StaticResource GameCenter.ModAction.Group}">
                                                <Button Content="Uninstall Reign" Command="{Binding ReignManager.UninstallCommand}"
                                                        Style="{StaticResource GameCenter.ModAction.UninstallButton}"
                                                        AutomationProperties.Name="Uninstall Reign"
                                                        AutomationProperties.HelpText="Remove the installed server. Its database, settings, memories, and previous runtimes are retained. Asks for a typed confirmation first." />
                                            </HeaderedContentControl>
                                        </StackPanel>
                                    </StackPanel>

                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- LLM Studio detail: engine state and controls, the language models LM Studio reports as loaded right now,
                     and the saved startup models (which may differ). Loading, testing and downloads stay on the LLM Studio page. -->
                <Border x:Name="LmStudioLandmark" Margin="18,16,18,12" Style="{StaticResource GameCenter.Card}"
                        Visibility="{Binding IsLmStudioView, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left" KeyboardNavigation.TabNavigation="Local">
                            <TextBlock Text="LLM Studio" Style="{StaticResource GameCenter.ModTitle}" />
                            <TextBlock Text="Local language models for Dwemer Dynamics mods, running inside Dwemer Distro."
                                       Foreground="{DynamicResource GameCenter.TextMuted}" TextWrapping="Wrap" Margin="0,4,0,14" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Engine install" Foreground="{DynamicResource GameCenter.TextMuted}" Margin="0,0,18,4" />
                                <TextBlock Grid.Column="1" Text="{Binding LmStudioInstalledText}" FontWeight="SemiBold"
                                           AutomationProperties.Name="LLM Studio install state" />
                                <TextBlock Grid.Row="1" Text="Engine" Foreground="{DynamicResource GameCenter.TextMuted}" Margin="0,0,18,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LmStudioEngineText}" FontWeight="SemiBold"
                                           AutomationProperties.Name="LLM Studio engine state" />
                            </Grid>
                            <WrapPanel>
                                <Button Content="Start engine" Command="{Binding StartLmStudioCommand}" Visibility="{Binding HasLmStudioEngine, Converter={StaticResource BoolToVisibility}}"
                                        Style="{StaticResource GameCenter.PrimaryButton}" Height="34" Padding="18,0" Margin="0,0,8,6"
                                        AutomationProperties.HelpText="Start the engine and load the saved startup models." />
                                <Button Content="Stop engine" Command="{Binding StopLmStudioCommand}" Visibility="{Binding HasLmStudioEngine, Converter={StaticResource BoolToVisibility}}"
                                        Style="{StaticResource GameCenter.Button}" Height="34" Padding="18,0" Margin="0,0,8,6"
                                        AutomationProperties.HelpText="Unload the models and stop the engine after any running operation finishes." />
                                <Button Content="Force stop engine" Command="{Binding ForceStopLmStudioCommand}" Visibility="{Binding HasLmStudioEngine, Converter={StaticResource BoolToVisibility}}"
                                        Style="{StaticResource GameCenter.DangerButton}" Height="34" Padding="14,0" Margin="0,0,8,6"
                                        ToolTip="Emergency stop for a stuck LLM Studio engine or operation. Asks first. Game servers are not affected."
                                        AutomationProperties.HelpText="Emergency stop. Immediately ends LLM Studio and interrupts any running load, download or reply. Asks for confirmation." />
                                <Button Content="Open LLM Studio page" Command="{Binding OpenLmStudioCommand}"
                                        Style="{StaticResource GameCenter.Button}" Height="34" Padding="16,0" Margin="0,0,8,6"
                                        AutomationProperties.HelpText="Open the LLM Studio page in your browser to load, test or manage models." />
                                <Button Content="Open Quickstart" Command="{Binding OpenFirstRunSetupCommand}"
                                        Style="{StaticResource GameCenter.Button}" Height="34" Padding="16,0" Margin="0,0,8,6"
                                        Visibility="{Binding IsLmStudioMissing, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.HelpText="Set up LLM Studio from Quickstart." />
                                <Button Content="Refresh" Command="{Binding RefreshLmStudioCommand}"
                                        Style="{StaticResource GameCenter.Button}" Height="34" Padding="12,0" Margin="0,0,8,6"
                                        AutomationProperties.HelpText="Read the LLM Studio status again." />
                            </WrapPanel>
                            <StackPanel Margin="0,0,0,10" Visibility="{Binding HasLmStudioEngine, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding LmStudioStartHint}" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource GameCenter.TextMuted}"
                                           Visibility="{Binding HasLmStudioStartHint, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding LmStudioActionText}" TextWrapping="Wrap" Margin="0,4,0,0" FontWeight="SemiBold"
                                           Visibility="{Binding HasLmStudioActionText, Converter={StaticResource BoolToVisibility}}"
                                           AutomationProperties.Name="LLM Studio action result"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                            <TextBlock Text="Loaded models" Style="{StaticResource GameCenter.SectionHeading}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding LmStudioModels}" Focusable="False"
                                          Visibility="{Binding HasLmStudioModels, Converter={StaticResource BoolToVisibility}}"
                                          AutomationProperties.Name="Loaded models">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource GameCenter.Border}" BorderThickness="1" CornerRadius="4"
                                                Padding="10,7" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Name}" />
                                                    <TextBlock Text="{Binding Details}" Foreground="{DynamicResource GameCenter.TextMuted}" FontSize="11"
                                                               Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="{DynamicResource GameCenter.CopperTint}" CornerRadius="3"
                                                        Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding HasRole, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding Role}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource GameCenter.CopperStrong}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding LmStudioMessage}" TextWrapping="Wrap" Margin="0,2,0,12"
                                       Foreground="{DynamicResource GameCenter.TextMuted}"
                                       Visibility="{Binding HasLmStudioMessage, Converter={StaticResource BoolToVisibility}}"
                                       AutomationProperties.Name="LLM Studio status"
                                       AutomationProperties.LiveSetting="Polite" />
                            <StackPanel Margin="0,0,0,12" Visibility="{Binding HasLmStudioEngine, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Startup models" Style="{StaticResource GameCenter.SectionHeading}" Margin="0,0,0,2" />
                                <TextBlock Text="Saved models that Start and Dwemer Distro startup load. Saving does not change what is loaded now."
                                           Foreground="{DynamicResource GameCenter.TextMuted}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8" />
                                <CheckBox Content="Start with Dwemer Distro" IsChecked="{Binding LmStudioAutostart}"
                                          Style="{StaticResource GameCenter.CheckBox}" Margin="0,0,0,8"
                                          AutomationProperties.HelpText="When on, the engine starts and loads the startup models whenever Dwemer Distro starts." />
                                <WrapPanel>
                                    <StackPanel Width="260" Margin="0,0,12,8">
                                        <TextBlock x:Name="LmStudioDialogueLabel" Text="Dialogue model" Foreground="{DynamicResource GameCenter.TextMuted}" Margin="0,0,0,3" />
                                        <ComboBox ItemsSource="{Binding LmStudioStartupChoices}" DisplayMemberPath="Name" SelectedValuePath="Key"
                                                  SelectedValue="{Binding LmStudioStartupDialogue}" Style="{StaticResource GameCenter.ComboBox}"
                                                  AutomationProperties.LabeledBy="{Binding ElementName=LmStudioDialogueLabel}" />
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,12,8">
                                        <TextBlock x:Name="LmStudioDecisionLabel" Text="Decision model (optional)" Foreground="{DynamicResource GameCenter.TextMuted}" Margin="0,0,0,3" />
                                        <ComboBox ItemsSource="{Binding LmStudioStartupChoices}" DisplayMemberPath="Name" SelectedValuePath="Key"
                                                  SelectedValue="{Binding LmStudioStartupDecision}" Style="{StaticResource GameCenter.ComboBox}"
                                                  AutomationProperties.LabeledBy="{Binding ElementName=LmStudioDecisionLabel}" />
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Text="{Binding LmStudioStartupNote}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"
                                           Foreground="{DynamicResource GameCenter.TextMuted}" AutomationProperties.LiveSetting="Polite" />
                                <Button Content="Save startup models" Command="{Binding SaveLmStudioStartupCommand}" HorizontalAlignment="Left"
                                        Style="{StaticResource GameCenter.Button}" Height="34" Padding="16,0"
                                        AutomationProperties.HelpText="Save autostart and the startup models. No model is loaded or unloaded." />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- The catalog and release details share this center panel; neither opens a window. -->
                <views:CommunityModsBrowser x:Name="CustomModBrowser" Margin="18,16,18,12"
                                            Visibility="{Binding IsShowingCustomModBrowser, Converter={StaticResource BoolToVisibility}}"
                                            RepositoryRequested="CommunityMod_Requested" />
                <ContentControl x:Name="CommunityModDetailsHost" Margin="18,16,18,12"
                                Content="{Binding CommunityDetails}"
                                Visibility="{Binding IsShowingCommunityModDetails, Converter={StaticResource BoolToVisibility}}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                <!-- Custom mods detail. Same two cards as the official view: the mod's installed banner, else
                     artwork from its public repository (generic placeholder otherwise) with name and description on the left,
                     status and actions on the right. Everything else comes from ddistro_custom_mod status. -->
                <Grid x:Name="CustomModsLandmark" Margin="18,16,18,12"
                      Visibility="{Binding IsShowingInstalledCustomMod, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.15*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1*" MinWidth="280" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource GameCenter.Card}" Padding="0" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Background="#151515">
                                <Image x:Name="CustomHeroArt" Source="{Binding SelectedCustomModHeroImage}" Stretch="Uniform"
                                       AutomationProperties.Name="{Binding SelectedCustomMod.Name, StringFormat={}{0} artwork}" />
                                <!-- Generic placeholder for mods without a banner or public GitHub artwork, while it loads,
                                     or when it cannot be fetched. -->
                                <StackPanel x:Name="CustomHeroPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedCustomModHeroImage}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Image Source="Assets/dd_title.png" Height="64" Stretch="Uniform" Opacity="0.35"
                                           AutomationProperties.Name="Custom mod placeholder artwork" />
                                    <TextBlock Text="CUSTOM MOD" Foreground="{DynamicResource GameCenter.TextMuted}" FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,10,0,0" />
                                </StackPanel>
                            </Grid>
                            <!-- Plain UI font: the shared title style's brand fonts follow the official selection. -->
                            <!-- Title, the game directly below it, the quieter author credit, then the description. -->
                            <StackPanel Grid.Row="1" Margin="18,14" Visibility="{Binding HasSelectedCustomMod, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding SelectedCustomMod.Name}" Foreground="{DynamicResource GameCenter.Text}"
                                           FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SelectedCustomMod.GameName}" ToolTip="{Binding SelectedCustomMod.GameName}"
                                           Style="{StaticResource CustomMod.OptionalText}" Foreground="{DynamicResource GameCenter.TextMuted}"
                                           FontSize="14" Margin="0,1,0,0" />
                                <TextBlock Text="{Binding SelectedCustomMod.AuthorCredit}" ToolTip="{Binding SelectedCustomMod.AuthorCredit}"
                                           Style="{StaticResource CustomMod.OptionalText}" Foreground="{DynamicResource GameCenter.TextMuted}"
                                           Opacity="0.75" FontSize="11" Margin="0,3,0,0" />
                                <TextBlock Text="{Binding SelectedCustomMod.Description}" ToolTip="{Binding SelectedCustomMod.Description}"
                                           Foreground="{DynamicResource GameCenter.Text}" TextTrimming="CharacterEllipsis"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="18,14" Visibility="{Binding HasNoCustomMods, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Custom mods" Foreground="{DynamicResource GameCenter.Text}" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="PHP/PostgreSQL mod servers added from a public repository."
                                           Foreground="{DynamicResource GameCenter.Text}" TextTrimming="CharacterEllipsis"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource GameCenter.Card}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <!-- Scrolls like the official card so no action clips at the minimum window size. -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False" Padding="0,0,2,0">
                                <Grid>
                                    <StackPanel Visibility="{Binding HasSelectedCustomMod, Converter={StaticResource BoolToVisibility}}">
                                        <!-- The mod name is the title under the artwork; here it is a quiet caption. -->
                                        <TextBlock Text="{Binding SelectedCustomMod.Name}" Style="{StaticResource GameCenter.Caption}" FontWeight="SemiBold"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

                                        <!-- Fixed-height status block, like the official cards, so busy and failed states
                                             never move the actions below. -->
                                        <Grid Height="52" Margin="0,8,0,10">
                                            <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <TextBlock Text="{Binding SelectedCustomModStateText}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource GameCenter.Text}"
                                                       ToolTip="{Binding SelectedCustomModStateText}"
                                                       AutomationProperties.Name="Custom mod status" AutomationProperties.LiveSetting="Polite" />
                                            <ProgressBar Grid.Row="1" Height="6" VerticalAlignment="Top" IsIndeterminate="{Binding IsCustomModBusy}"
                                                         Background="#151515" BorderThickness="0" Foreground="{DynamicResource GameCenter.CopperStrong}"
                                                         IsTabStop="False" Focusable="False" AutomationProperties.Name="Custom mod operation progress">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Opacity" Value="0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCustomModBusy}" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </Grid>

                                        <!-- Installed source, then the dashboard and the update from that source, links and
                                             checks, the separate branch check and switch, and removal last below a rule. -->
                                        <TextBlock Style="{StaticResource GameCenter.Caption}" Margin="0,0,0,5" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SelectedCustomMod.Repository}" Text="{Binding SelectedCustomModVersionText}" />
                                        <TextBlock Text="{Binding SelectedCustomModBranchNotice}" Style="{StaticResource GameCenter.Caption}" TextWrapping="Wrap"
                                                   Margin="0,0,0,5" AutomationProperties.Name="Custom mod branch notice"
                                                   Visibility="{Binding HasSelectedCustomModBranchNotice, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="Open dashboard" Command="{Binding OpenCustomModDashboardCommand}" Style="{StaticResource GameCenter.ModAction.PrimaryButton}"
                                                Margin="0,6,0,8" Height="38"
                                                AutomationProperties.HelpText="Open this mod's local dashboard in your browser." />
                                        <!-- Update has no confirmed-availability signal for custom mods, so it stays a secondary
                                             action and the dashboard is the primary one. Neither moves. -->
                                        <Button Content="Update" Command="{Binding UpdateCustomModCommand}" Style="{StaticResource GameCenter.ModAction.SecondaryButton}"
                                                Height="38"
                                                AutomationProperties.HelpText="Back up, then update from the repository. Refused if you changed the mod's files." />
                                        <!-- External project page (browser only; never probes or starts WSL) and local checks. -->
                                        <HeaderedContentControl Header="Links and checks" Style="{StaticResource GameCenter.ModAction.Group}">
                                            <StackPanel>
                                                <Button Content="{Binding SelectedCustomModRepositoryActionName}" Command="{Binding OpenCustomModRepositoryCommand}"
                                                        Style="{StaticResource GameCenter.ModAction.SecondaryButton}"
                                                        AutomationProperties.Name="{Binding SelectedCustomModRepositoryActionName}"
                                                        ToolTip="{Binding SelectedCustomMod.Repository}"
                                                        AutomationProperties.HelpText="Open this mod's public repository in your browser. The local server is not started or contacted." />
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Button Content="Check status" Command="{Binding CheckCustomModHealthCommand}" Style="{StaticResource GameCenter.ModAction.SecondaryButton}"
                                                            AutomationProperties.HelpText="Ask the distro whether this mod's health page responds." />
                                                    <Button Grid.Column="2" Content="Back up" Command="{Binding BackupCustomModCommand}" Style="{StaticResource GameCenter.ModAction.SecondaryButton}"
                                                            AutomationProperties.HelpText="Save a copy of this mod's settings and database inside the distro." />
                                                </Grid>
                                            </StackPanel>
                                        </HeaderedContentControl>
                                        <!-- The author's offered branches, from the last explicit check stored by the distro.
                                             Kept apart from Update, which always uses the installed source: choosing a branch
                                             changes nothing until Switch branch reviews and confirms it. -->
                                        <HeaderedContentControl Header="Branch" Style="{StaticResource GameCenter.ModAction.Group}"
                                                                Visibility="{Binding SelectedCustomModUsesBranches, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel>
                                                <ComboBox ItemsSource="{Binding SelectedCustomModBranchOptions}" SelectedItem="{Binding SelectedCustomModBranch}"
                                                          Style="{StaticResource GameCenter.ComboBox}" HorizontalAlignment="Stretch"
                                                          AutomationProperties.Name="Custom mod branch"
                                                          IsEnabled="{Binding IsComponentInteractionEnabled}"
                                                          AutomationProperties.HelpText="Branches offered by the mod's author, from the last branch check. Choose one, then Switch branch to review it." />
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Button Content="Check branches" Command="{Binding CheckCustomModBranchesCommand}" Style="{StaticResource GameCenter.ModAction.SecondaryButton}"
                                                            AutomationProperties.HelpText="Ask the repository which branches the author offers now. Nothing is installed." />
                                                    <Button Grid.Column="2" Content="Switch branch" Command="{Binding SwitchCustomModBranchCommand}" Style="{StaticResource GameCenter.ModAction.SecondaryButton}"
                                                            AutomationProperties.HelpText="Review the chosen branch's exact version, then confirm to back up and switch." />
                                                </Grid>
                                            </StackPanel>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="Manage" Style="{StaticResource GameCenter.ModAction.Group}">
                                            <Button Content="{Binding SelectedCustomModUnregisterActionName}" Command="{Binding UnregisterCustomModCommand}" Style="{StaticResource GameCenter.ModAction.UninstallButton}"
                                                    AutomationProperties.HelpText="Review removal. Private data and server files are kept; package installs also remove their owned game client files." />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding HasNoCustomMods, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Custom mods" FontSize="18" Foreground="{DynamicResource GameCenter.Text}" />
                                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource GameCenter.Text}"
                                                   Text="Add a PHP/PostgreSQL mod server from a public repository. It runs inside the distro with its own folder and database." />
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                            <TextBlock Grid.Row="1" Text="{Binding CustomModsStatusText}" Margin="0,8,0,0" MinHeight="16"
                                       Style="{StaticResource GameCenter.Caption}" TextWrapping="Wrap"
                                       AutomationProperties.Name="Custom mods message" AutomationProperties.LiveSetting="Polite" />
                        </Grid>
                    </Border>
                </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Components">
                <Grid x:Name="SetupLandmark" Margin="18,16,18,12" MinHeight="0" ClipToBounds="True">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="COMPONENTS" Style="{StaticResource GameCenter.Heading}" />
                            <TextBlock Text="Install and configure shared services for this PC. System updates never change installed mods."
                                       Style="{StaticResource GameCenter.Caption}" Margin="0,4,0,0" />
                            <!-- One compact system line. It never wraps and its row height is fixed, so no
                                 state can push the components card down; the full sentence stays in the
                                 tooltip and in the accessible help text. Update Distro itself is the top
                                 bar action - this page no longer carries a second copy of it. -->
                            <TextBlock Text="{Binding SystemStatusText}" Foreground="{Binding SystemStatusColor}"
                                       Style="{StaticResource GameCenter.Caption}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Height="18" Margin="0,6,0,0"
                                       ToolTip="{Binding SystemStatusHelpText}"
                                       AutomationProperties.Name="System update status"
                                       AutomationProperties.HelpText="{Binding SystemStatusHelpText}"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                            <Button Content="Configure CUDA" Command="{Binding OpenCudaConfigCommand}"
                                    Style="{StaticResource GameCenter.Button}"
                                    IsEnabled="{Binding IsComponentInteractionEnabled}"
                                    AutomationProperties.HelpText="Configure the CUDA version used by compatible shared components." />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource GameCenter.Card}" Padding="0" ClipToBounds="True">
                        <!-- Empty until Components opens. MainWindow builds the page on entry and
                             drops it on exit so its visual tree can be collected. -->
                        <ContentControl x:Name="SetupComponentsHost" MinHeight="0" Focusable="False"
                                        IsEnabled="{Binding IsComponentInteractionEnabled}" />
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer x:Name="SettingsLandmark" VerticalScrollBarVisibility="Auto" Padding="18,16,18,12">
                    <!-- Every setting lives in this one StackPanel as a full-width SettingRow card:
                         title plus explanation on the left, a single compact action on the right.
                         Section headings break the list up but never split it into columns. -->
                    <StackPanel>
                        <TextBlock Text="SETTINGS" Style="{StaticResource GameCenter.Heading}" />
                        <TextBlock Text="Launcher preferences, setup, diagnostics, and backups."
                                   Style="{StaticResource GameCenter.Caption}" Margin="0,4,0,16" />

                        <TextBlock Text="SETUP" Style="{StaticResource GameCenter.SectionHeading}" Margin="0,0,0,10" />
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="First-Time Setup" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Open the guided setup flow for fresh installs or when you want to rerun the quickstart checks."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Open" Command="{Binding OpenFirstRunSetupCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Open first-time setup"
                                        AutomationProperties.HelpText="Open the guided setup flow for fresh installs or when you want to rerun the quickstart checks." />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Configure CUDA GPU" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Open CUDA setup and repair tools when NVIDIA GPU support needs to be installed or fixed."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Open" Command="{Binding OpenCudaConfigCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Open CUDA GPU configuration"
                                        AutomationProperties.HelpText="Open CUDA setup and repair tools when NVIDIA GPU support needs to be installed or fixed." />
                            </Grid>
                        </Border>

                        <TextBlock Text="DIAGNOSTICS" Style="{StaticResource GameCenter.SectionHeading}" Margin="0,12,0,10" />
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Create Diagnostic File" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Collect launcher, distro, and service troubleshooting data into a single diagnostic output."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Run" Command="{Binding GenerateDiagnosticsCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Create diagnostic file"
                                        AutomationProperties.HelpText="Collect launcher, distro, and service troubleshooting data into a single diagnostic output." />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Open Terminal" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Launch a shell inside the distro for manual inspection, package checks, or direct commands."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Open" Command="{Binding OpenTerminalCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Open terminal"
                                        AutomationProperties.HelpText="Launch a shell inside the distro for manual inspection, package checks, or direct commands." />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Distro Doctor" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Check and repair common distro issues including permissions, Apache, Background Life, ports, disk space, and recent logs."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Run" Command="{Binding DistroDoctorCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Run distro doctor"
                                        AutomationProperties.HelpText="Check and repair common distro issues including permissions, Apache, Background Life, ports, disk space, and recent logs." />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="View Memory Usage" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Open live resource usage inside WSL to inspect RAM, CPU, and process pressure."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Open" Command="{Binding ViewMemoryUsageCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="View memory usage"
                                        AutomationProperties.HelpText="Open live resource usage inside WSL to inspect RAM, CPU, and process pressure." />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Fix WSL DNS (GitHub)" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Repair common WSL DNS issues that block GitHub downloads, updates, or package installs."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Repair" Command="{Binding FixWslDnsCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Fix WSL DNS for GitHub"
                                        AutomationProperties.HelpText="Repair common WSL DNS issues that block GitHub downloads, updates, or package installs." />
                            </Grid>
                        </Border>

                        <TextBlock Text="UPDATE OPTIONS" Style="{StaticResource GameCenter.SectionHeading}" Margin="0,12,0,10" />
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <!-- Checkbox-led row, like Dwemer Dashboard WebUI below: the checkbox label is
                                 the row title, and the description, the standing warning, and the saved
                                 state indent 32px so they hang under the label rather than the box. The
                                 warning is permanent text, not a state message, because the danger applies
                                 whenever the option is on. -->
                            <StackPanel>
                                <CheckBox Content="Force Updates" IsChecked="{Binding ForceGitUpdatesEnabled}"
                                          Command="{Binding ConfirmForceGitUpdatesCommand}" Style="{StaticResource GameCenter.SettingCheckBox}"
                                          AutomationProperties.Name="Force Updates, overwrite manually edited server files"
                                          AutomationProperties.HelpText="Destructive. When checked, launcher updates for managed servers permanently discard your manual edits to files those servers track in Git, with no undo. Git may also replace untracked or ignored files that conflict with the update, so back up custom files first. Turning this on asks for confirmation first; turning it off does not. Off by default." />
                                <TextBlock Text="Allow launcher server updates to overwrite tracked files changed manually. Git may also replace conflicting untracked or ignored files, so back up custom files first."
                                           Style="{StaticResource GameCenter.SettingRowDescription}"
                                           Margin="32,4,0,0" />
                                <TextBlock Text="Warning: while this is on, updating a mod server permanently discards your manual edits to its tracked files. There is no undo."
                                           Foreground="{DynamicResource GameCenter.DangerText}"
                                           FontSize="11" Margin="32,6,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ForceGitUpdatesStatusText}"
                                           Foreground="{Binding ForceGitUpdatesStatusColor}"
                                           AutomationProperties.LiveSetting="Polite"
                                           FontSize="11" Margin="32,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="MAINTENANCE AND BACKUPS" Style="{StaticResource GameCenter.SectionHeading}" Margin="0,12,0,10" />
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Compact Distro" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Delete installer caches the launcher can download again, release that space inside the distro, and hand that space back to Windows. Your mods, installed servers and components, models, voices, databases, settings, logs, and Hugging Face sign-in are kept."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                    <TextBlock Text="This stops the DwemerDistro server and every other running WSL distribution, and Windows asks you to approve an administrator prompt. The server stays stopped afterwards, so start it again when you are ready."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                    <TextBlock x:Name="CompactDistroStatusTextBlock"
                                               Text="{Binding CompactDistroStatusText}"
                                               Foreground="{Binding CompactDistroStatusColor}"
                                               Visibility="{Binding HasCompactDistroStatus, Converter={StaticResource BoolToVisibility}}"
                                               AutomationProperties.LiveSetting="Polite"
                                               FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Compact" Command="{Binding CompactDistroCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Compact distro"
                                        AutomationProperties.HelpText="Delete installer caches the launcher can download again, release that space inside the distro, and hand that space back to Windows. Mods, installed servers and components, models, voices, databases, settings, logs, and Hugging Face sign-in are kept. This stops the DwemerDistro server and every other running WSL distribution, needs Windows administrator approval, and leaves the server stopped. You are asked to confirm first, and the confirmation defaults to No." />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Export Distro Backup" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Create a backup of the distro before major updates, installs, or configuration changes."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Export" Command="{Binding ExportDistroCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Export distro backup"
                                        AutomationProperties.HelpText="Create a backup of the distro before major updates, installs, or configuration changes." />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Import Distro Backup" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Restore a previously exported distro backup. Use this when you need to roll the full distro state back."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Import" Command="{Binding ImportDistroCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Import distro backup"
                                        AutomationProperties.HelpText="Restore a previously exported distro backup. Use this when you need to roll the full distro state back." />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Clean All Logs" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Clear accumulated service and Apache logs so fresh troubleshooting runs start with clean output."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Clean" Command="{Binding CleanLogsCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Clean all logs"
                                        AutomationProperties.HelpText="Clear accumulated service and Apache logs so fresh troubleshooting runs start with clean output." />
                            </Grid>
                        </Border>

                        <TextBlock Text="STARTUP OPTIONS" Style="{StaticResource GameCenter.SectionHeading}" Margin="0,12,0,10" />
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <!-- Checkbox-led row: the row title is the checkbox label, so the box reads as
                                 part of the setting name and clicking "Dwemer Dashboard WebUI" toggles it.
                                 The description and status line indent 32px (24px box column + 8px gap) so
                                 they hang under the label instead of under the box. -->
                            <StackPanel>
                                <CheckBox Content="Dwemer Dashboard WebUI" IsChecked="{Binding DashboardAutoOpenEnabled}"
                                          Command="{Binding SaveDashboardAutoOpenCommand}" Style="{StaticResource GameCenter.SettingCheckBox}"
                                          AutomationProperties.Name="Dwemer Dashboard WebUI, open on server start"
                                          AutomationProperties.HelpText="When checked, starting the DwemerDistro server opens the Dwemer Dashboard WebUI in your default browser on this PC. Leave it unchecked for headless or remote use. The change applies on the next server start." />
                                <TextBlock Text="Open the Dwemer Dashboard when the server starts. Turn this off for headless or remote setups. Applies on the next server start."
                                           Style="{StaticResource GameCenter.SettingRowDescription}"
                                           Margin="32,4,0,0" />
                                <TextBlock Text="{Binding DashboardAutoOpenStatusText}"
                                           Foreground="{Binding DashboardAutoOpenStatusColor}"
                                           AutomationProperties.LiveSetting="Polite"
                                           FontSize="11" Margin="32,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Logs">
                <ScrollViewer x:Name="LogsLandmark" VerticalScrollBarVisibility="Auto" Padding="18,16,18,12">
                    <StackPanel>
                        <TextBlock Text="LOGS" Style="{StaticResource GameCenter.Heading}" />
                        <TextBlock Text="Collect a debugging bundle, or open a live service log in a terminal window."
                                   Style="{StaticResource GameCenter.Caption}" Margin="0,4,0,14" />
                        <Border Style="{StaticResource GameCenter.Card}" BorderBrush="{DynamicResource GameCenter.CopperEdge}" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="DISTRO DEBUGGING LOGS" Style="{StaticResource GameCenter.SectionHeading}" />
                                    <TextBlock Text="Bundles distro diagnostics into a single file to share when asking for support."
                                               Style="{StaticResource GameCenter.Caption}" Margin="0,4,16,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Generate Distro Debugging Logs"
                                        Command="{Binding GenerateDiagnosticsCommand}"
                                        Style="{StaticResource GameCenter.PrimaryButton}"
                                        MinWidth="238" MinHeight="40" VerticalAlignment="Center"
                                        AutomationProperties.Name="Generate distro debugging logs"
                                        AutomationProperties.HelpText="Create a diagnostic file with distro logs and system details." />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GameCenter.Card}" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding RefreshConnectionDetailsCommand}"
                                            Style="{StaticResource GameCenter.Button}" Width="32" Height="32" MinWidth="32" MinHeight="32"
                                            Padding="0" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                                            ToolTip="Refresh" AutomationProperties.Name="Refresh"
                                            AutomationProperties.HelpText="Read current addresses without starting a stopped distro.">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" FontWeight="Normal" />
                                    </Button>
                                    <TextBlock Text="CONNECTION DETAILS" Style="{StaticResource GameCenter.SectionHeading}" VerticalAlignment="Center" />
                                </DockPanel>
                                <Grid Margin="0,10,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="ThisPcAddressLabel" Text="This PC" Style="{StaticResource GameCenter.Caption}" Margin="0,0,12,8" />
                                    <TextBlock Grid.Column="1" Text="{Binding ThisPcAddressText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                               AutomationProperties.LabeledBy="{Binding ElementName=ThisPcAddressLabel}" />
                                    <TextBlock x:Name="WslAddressLabel" Grid.Row="1" Text="WSL address" Style="{StaticResource GameCenter.Caption}" Margin="0,0,12,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WslAddressText}" TextWrapping="Wrap"
                                               AutomationProperties.LabeledBy="{Binding ElementName=WslAddressLabel}" />
                                </Grid>
                                <TextBlock Text="On this PC, use the mod's Open button. These addresses are for troubleshooting; LAN access may require additional setup."
                                           Style="{StaticResource GameCenter.Caption}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <TextBlock x:Name="ConnectionDetailsStatusTextBlock" Text="{Binding ConnectionDetailsStatus}"
                                           Style="{StaticResource GameCenter.Caption}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="LIVE LOGS" Style="{StaticResource GameCenter.SectionHeading}" Margin="0,0,0,4" />
                        <TextBlock Text="Open a live service log in a terminal window." Style="{StaticResource GameCenter.Caption}" Margin="0,0,0,12" />
                        <WrapPanel x:Name="LiveLogButtons">
                            <Button Command="{Binding ViewXttsLogsCommand}" Style="{StaticResource GameCenter.LogButton}"
                                    ToolTip="Dwemer Distro XTTS log" AutomationProperties.Name="Dwemer Distro XTTS log">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="Assets/component-xtts.png" Style="{StaticResource GameCenter.LogButtonIcon}" />
                                    <TextBlock Text="XTTS" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ViewChatterboxLogsCommand}" Style="{StaticResource GameCenter.LogButton}"
                                    ToolTip="Chatterbox log" AutomationProperties.Name="Chatterbox log">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="Assets/component-chatterbox.png" Style="{StaticResource GameCenter.LogButtonIcon}" />
                                    <TextBlock Text="Chatterbox" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ViewPocketTtsLogsCommand}" Style="{StaticResource GameCenter.LogButton}"
                                    ToolTip="PocketTTS log" AutomationProperties.Name="PocketTTS log">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="Assets/component-pocket-tts.png" Style="{StaticResource GameCenter.LogButtonIcon}" />
                                    <TextBlock Text="PocketTTS" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ViewPiperLogsCommand}" Style="{StaticResource GameCenter.LogButton}"
                                    ToolTip="Piper log" AutomationProperties.Name="Piper log">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="Assets/component-piper.png" Style="{StaticResource GameCenter.LogButtonIcon}" />
                                    <TextBlock Text="Piper" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ViewLocalWhisperLogsCommand}" Style="{StaticResource GameCenter.LogButton}"
                                    ToolTip="LocalWhisper log" AutomationProperties.Name="LocalWhisper log">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="Assets/component-whisper.png" Style="{StaticResource GameCenter.LogButtonIcon}" />
                                    <TextBlock Text="LocalWhisper" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ViewParakeetLogsCommand}" Style="{StaticResource GameCenter.LogButton}"
                                    ToolTip="Parakeet log" AutomationProperties.Name="Parakeet log">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="Assets/nvidia.png" Style="{StaticResource GameCenter.LogButtonIcon}" />
                                    <TextBlock Text="Parakeet" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ViewApacheLogsCommand}" Style="{StaticResource GameCenter.LogButton}"
                                    ToolTip="Apache error log" AutomationProperties.Name="Apache error log">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="14" FontWeight="Normal"
                                               Width="16" Margin="0,0,8,0" TextAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Text="Apache" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Assistant">
                <!-- The view model is created on first binding and runs nothing until Connect. -->
                <views:AssistantView x:Name="AssistantLandmark" DataContext="{Binding Assistant}" />
            </TabItem>
            <TabItem Header="API Keys">
                <ContentControl x:Name="ApiKeysHost" KeyboardNavigation.TabNavigation="Continue" />
            </TabItem>
        </TabControl>

        <Border x:Name="ConsoleScrim" Grid.Row="2" Grid.Column="1" Background="#99000000" Visibility="Collapsed" Panel.ZIndex="9" />
        <Border x:Name="ConsoleDockHost" Grid.Row="3" Grid.Column="1" Background="#1A1A1A"
                BorderBrush="{DynamicResource GameCenter.BorderStrong}" BorderThickness="0,1,0,0" Panel.ZIndex="10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Button x:Name="ToggleConsoleButton" Content="Show Console"
                        Style="{StaticResource GameCenter.UtilityButton}" HorizontalContentAlignment="Left" Padding="18,8"
                        AutomationProperties.Name="Show Console" Click="ToggleConsoleButton_Click" />
                <!-- The console control is mounted only while expanded so its FlowDocument and
                     accessibility tree do not stay resident during normal launcher use. -->
                <ContentControl x:Name="OutputConsoleHost" Grid.Row="1" Focusable="False" />
            </Grid>
        </Border>
    </Grid>
</Window>
