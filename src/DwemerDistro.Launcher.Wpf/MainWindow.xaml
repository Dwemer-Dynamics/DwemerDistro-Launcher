<Window x:Class="DwemerDistro.Launcher.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="DWEMER DISTRO"
        Icon="Assets/DwemerDistro.ico"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="680"
        ResizeMode="CanResize"
        WindowStyle="None"
        Background="{DynamicResource GameCenter.Window}"
        BorderBrush="Black"
        BorderThickness="1"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="GameCenter.ActionCardButton" TargetType="Button" BasedOn="{StaticResource GameCenter.Button}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinWidth" Value="196" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style x:Key="GameCenter.LogButton" TargetType="Button" BasedOn="{StaticResource GameCenter.ActionCardButton}">
            <Setter Property="MinWidth" Value="168" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <!-- Settings rows: one full-width card per setting, stacked vertically. The title and
             wrapped explanation take the flexible column so descriptions stay readable down to
             the 980px minimum width; the action stays compact in the Auto column. -->
        <Style x:Key="GameCenter.SettingRow" TargetType="Border" BasedOn="{StaticResource GameCenter.Card}">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="GameCenter.SettingRowTitle" TargetType="TextBlock" BasedOn="{StaticResource GameCenter.SectionHeading}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="GameCenter.SettingRowDescription" TargetType="TextBlock" BasedOn="{StaticResource GameCenter.Caption}">
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="GameCenter.SettingRowButton" TargetType="Button" BasedOn="{StaticResource GameCenter.PrimaryButton}">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid x:Name="ShellGrid" Background="{DynamicResource GameCenter.Window}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="62" />
            <RowDefinition Height="*" />
            <RowDefinition x:Name="ConsoleRow" Height="38" />
            <RowDefinition Height="124" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="178" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="#1A1A1A"
                BorderBrush="{DynamicResource GameCenter.Border}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Chrome_MouseLeftButtonDown"
                MouseRightButtonUp="Chrome_MouseRightButtonUp">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                    <Image Source="Assets/DwemerDistro.png" Width="20" Height="20" Margin="0,0,9,0" />
                    <TextBlock Text="DWEMER DISTRO" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="—"
                        Style="{StaticResource GameCenter.CaptionButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Minimize Dwemer Distro"
                        Click="MinimizeButton_Click" />
                <Button Grid.Column="2"
                        Content="□"
                        Style="{StaticResource GameCenter.CaptionButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Maximize or restore Dwemer Distro"
                        Click="MaximizeButton_Click" />
                <Button Grid.Column="3"
                        Content="✕"
                        Style="{StaticResource GameCenter.CaptionCloseButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Close Dwemer Distro"
                        Click="CloseButton_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Grid.RowSpan="4"
                Grid.Column="0"
                Background="#242424"
                BorderBrush="{DynamicResource GameCenter.Border}"
                BorderThickness="0,0,1,0">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <Image Source="Assets/dd_title.png" Height="62" Stretch="Uniform" HorizontalAlignment="Left" Margin="4,4,4,16" />
                </StackPanel>
                <StackPanel x:Name="UtilityLandmark" Grid.Row="1" KeyboardNavigation.TabNavigation="Local">
                    <Button Command="{Binding OpenServerFolderCommand}" Style="{StaticResource GameCenter.UtilityButton}" AutomationProperties.Name="Server Folder">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Width="22" />
                            <AccessText Text="Server _Folder" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenWikiCommand}" Style="{StaticResource GameCenter.UtilityButton}" AutomationProperties.Name="Wiki">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" Width="22" />
                            <AccessText Text="_Wiki" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenDiscordCommand}" Style="{StaticResource GameCenter.UtilityButton}" AutomationProperties.Name="Discord">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" Width="22" />
                            <AccessText Text="_Discord" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="5,12,5,4">
                    <Button Command="{Binding UpdateLauncherCommand}" Style="{StaticResource GameCenter.LauncherUpdateButton}"
                            AutomationProperties.Name="{Binding LauncherUpdateButtonText}"
                            AutomationProperties.HelpText="{Binding LauncherUpdateStatusText}" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" Width="22" />
                            <TextBlock Text="{Binding LauncherUpdateButtonText}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding LauncherVersionText}" Foreground="{DynamicResource GameCenter.TextMuted}" FontSize="10" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource GameCenter.Panel}"
                BorderBrush="{DynamicResource GameCenter.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="NavigationLandmark" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <RadioButton x:Name="LibraryNavButton" GroupName="Destination" Content="_MODS" IsChecked="True"
                                 Style="{StaticResource GameCenter.NavButton}" Tag="0" Checked="DestinationNav_Checked" />
                    <RadioButton x:Name="SetupNavButton" GroupName="Destination" Content="_COMPONENTS"
                                 Style="{StaticResource GameCenter.NavButton}" Tag="1" Checked="DestinationNav_Checked" />
                    <RadioButton x:Name="SettingsNavButton" GroupName="Destination" Content="_SETTINGS"
                                 Style="{StaticResource GameCenter.NavButton}" Tag="2" Checked="DestinationNav_Checked" />
                    <RadioButton x:Name="LogsNavButton" GroupName="Destination" Content="LO_GS"
                                 Style="{StaticResource GameCenter.NavButton}" Tag="3" Checked="DestinationNav_Checked" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- The one Update System action in the normal launcher. The badge lives in its own
                         fixed-width column, so a state change never moves the label; the label column
                         keeps reserving the widest running text for the same reason. The button stays
                         enabled whenever no other operation is running, because it is also the recovery
                         action for a distro that cannot report itself. -->
                    <Button Command="{Binding UpdateSystemCommand}"
                            Style="{StaticResource GameCenter.AccentButton}" MinWidth="140" Margin="0,0,6,0"
                            AutomationProperties.Name="{Binding SystemUpdateAccessibleName}"
                            AutomationProperties.HelpText="{Binding UpdateSystemHelpText}"
                            ToolTip="{Binding SystemStatusHelpText}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <!-- Hidden content reserves the widest running state without changing accessibility text. -->
                                <TextBlock Text="Updating System..." Visibility="Hidden" />
                                <TextBlock Text="{Binding SystemUpdateButtonText}" HorizontalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Column="1" Text="{Binding SystemUpdateBadgeGlyph}"
                                       Foreground="{Binding SystemUpdateBadgeColor}"
                                       FontFamily="Segoe MDL2 Assets" FontSize="12" FontWeight="Normal"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Visibility="{Binding IsSystemUpdateBadgeVisible, Converter={StaticResource BoolToVisibility}}"
                                       AutomationProperties.Name="{Binding SystemStatusText}"
                                       AutomationProperties.LiveSetting="Polite" />
                        </Grid>
                    </Button>
                    <Button Command="{Binding StartServerCommand}"
                            Style="{StaticResource GameCenter.SuccessButton}" MinWidth="132" Margin="0,0,6,0"
                            AutomationProperties.Name="{Binding StartButtonText}"
                            AutomationProperties.HelpText="Start the complete Dwemer Distro stack.">
                        <Grid>
                            <!-- Hidden content reserves the widest animation state without changing accessibility text. -->
                            <TextBlock Text="Server is Starting ..." Visibility="Hidden" />
                            <TextBlock Text="{Binding StartButtonText}" HorizontalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Content="Stop" Command="{Binding StopServerCommand}" Style="{StaticResource GameCenter.Button}" Margin="0,0,6,0" />
                    <Button Content="Force Stop" Command="{Binding ForceStopServerCommand}" Style="{StaticResource GameCenter.DangerButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="2" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0"
                    MinHeight="0" ClipToBounds="True"
                    KeyboardNavigation.TabNavigation="Continue"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed" /></Style>
            </TabControl.Resources>

            <TabItem Header="Mods">
                <Grid x:Name="LibraryLandmark" Margin="18,16,18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.15*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1*" MinWidth="280" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource GameCenter.Card}" Padding="0" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Background="#151515">
                                <Image x:Name="HeroArt" Source="{Binding SelectedGame.HeroImageSource}" Stretch="Uniform"
                                       AutomationProperties.Name="{Binding SelectedGame.Name, StringFormat={}{0} artwork}" />
                                <Border x:Name="HeroHighContrastFallback" Visibility="Collapsed"
                                        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" BorderThickness="2">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedGame.Name}" Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                                   FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedGame.GameTitle}" Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                                                   Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="18,14">
                                <TextBlock Text="{Binding SelectedGame.Name}" Style="{StaticResource GameCenter.ModTitle}" />
                                <TextBlock Text="{Binding SelectedGame.GameTitle}" Foreground="{DynamicResource GameCenter.Gold}"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource GameCenter.Card}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <!-- The card scrolls so the extra install/repair/uninstall actions never clip at the
                                 window's minimum size. -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False" Padding="0,0,2,0">
                                <Grid>
                                    <StackPanel x:Name="ChimDetails" Visibility="Collapsed">
                                        <TextBlock FontWeight="SemiBold" FontSize="16"><Run Text="CHIM" Style="{StaticResource GameCenter.ModNameRun}" /><Run Text=" / HerikaServer" /></TextBlock>

                                        <!-- Fixed-size status block. The single trimmed status line and the
                                             progress track below it always occupy the same space, so a busy or
                                             failed operation never resizes the actions underneath. -->
                                        <Grid Height="52" Margin="0,8,0,10">
                                            <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{Binding HerikaManager.StatusText}" Foreground="{Binding HerikaManager.StatusColor}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                                       ToolTip="{Binding HerikaManager.AccessibleStatusHelpText}"
                                                       AutomationProperties.Name="HerikaServer status"
                                                       AutomationProperties.HelpText="{Binding HerikaManager.AccessibleStatusHelpText}"
                                                       AutomationProperties.LiveSetting="Polite" />
                                            <ProgressBar Grid.Row="1" Height="6" VerticalAlignment="Top"
                                                         IsIndeterminate="{Binding HerikaManager.IsBusy}"
                                                         Background="#151515" BorderThickness="0"
                                                         Foreground="{DynamicResource GameCenter.Gold}"
                                                         IsTabStop="False" Focusable="False"
                                                         AutomationProperties.Name="HerikaServer operation progress">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Opacity" Value="0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HerikaManager.IsBusy}" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </Grid>

                                        <!-- Not installed: pick a branch, then install. Webpage, rollback and the
                                             update checkbox stay out of reach until the server exists. -->
                                        <StackPanel Visibility="{Binding HerikaManager.ShowNotInstalledActions, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Install branch" Style="{StaticResource GameCenter.Caption}" Margin="0,0,0,5" />
                                            <ComboBox ItemsSource="{Binding HerikaManager.Branches}" SelectedItem="{Binding HerikaManager.SelectedBranch}"
                                                      Style="{StaticResource GameCenter.ComboBox}" HorizontalAlignment="Stretch"
                                                      IsEnabled="{Binding HerikaManager.CanInstall}"
                                                      AutomationProperties.Name="HerikaServer install branch"
                                                      AutomationProperties.HelpText="Branch used when this server is installed." />
                                            <Button Content="Install Server" Command="{Binding HerikaManager.InstallCommand}"
                                                    Style="{StaticResource GameCenter.Brand.ChimButton}" Margin="0,16,0,0" Height="38"
                                                    AutomationProperties.Name="Install HerikaServer"
                                                    AutomationProperties.HelpText="Download and install this server on the selected branch. Nothing else is changed." />
                                        </StackPanel>

                                        <!-- Installed: branch, system + mod update, webpage, rollback, then the destructive purge. -->
                                        <StackPanel Visibility="{Binding HerikaManager.ShowInstalledActions, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Update branch" Style="{StaticResource GameCenter.Caption}" Margin="0,0,0,5" />
                                            <ComboBox ItemsSource="{Binding HerikaManager.Branches}" SelectedItem="{Binding HerikaManager.SelectedBranch}"
                                                      Style="{StaticResource GameCenter.ComboBox}" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="HerikaServer update branch"
                                                      IsEnabled="{Binding HerikaManager.CanUseInstalledFeatures}"
                                                      AutomationProperties.HelpText="Branch used the next time this mod updates. Unavailable while another server, component, or system operation is running." />
                                            <!-- Updates the shared system, then this mod on the chosen branch.
                                                 Disabled during conflicting operations so controls never shift. -->
                                            <Button Content="{Binding HerikaManager.UpdateActionName}" Command="{Binding HerikaManager.UpdateCommand}"
                                                    Style="{StaticResource GameCenter.Brand.ChimButton}" Margin="0,16,0,12" Height="40"
                                                    AutomationProperties.Name="{Binding HerikaManager.UpdateActionName}"
                                                    ToolTip="{Binding HerikaManager.UpdateActionHelpText}"
                                                    AutomationProperties.HelpText="{Binding HerikaManager.UpdateActionHelpText}" />
                                            <Button Content="CHIM Webpage" Command="{Binding OpenChimCommand}" Style="{StaticResource GameCenter.ModAction.ChimSecondaryButton}" Margin="0,0,0,6"
                                                    AutomationProperties.Name="CHIM Webpage"
                                                    AutomationProperties.HelpText="Open the CHIM server webpage. If it is unavailable, the launcher can start the server first." />
                                            <!-- External mod page. It opens the browser immediately and never
                                                 probes or starts WSL, so it stays usable while the installed server
                                                 is stopped. Neutral styling keeps it distinct from the
                                                 brand-coloured local actions above it. -->
                                            <Button Content="CHIM Nexus Page" Command="{Binding OpenChimNexusCommand}" Style="{StaticResource GameCenter.ModAction.SecondaryButton}" Margin="0,0,0,6"
                                                    AutomationProperties.Name="CHIM Nexus Page"
                                                    AutomationProperties.HelpText="Open this mod's page on Nexus Mods in your browser. The local server is not started or contacted." />
                                            <Button Content="Rollback HerikaServer" Command="{Binding OpenHerikaRollbackCommand}" Style="{StaticResource GameCenter.ModAction.ChimSecondaryButton}"
                                                    AutomationProperties.Name="Rollback HerikaServer"
                                                    AutomationProperties.HelpText="Roll this server back to an earlier installed version." />
                                            <!-- Decorative rule only. It ends the reversible actions so the purge below reads as a
                                                 separate decision; it is not focusable and adds nothing to the tab order. -->
                                            <Border Style="{StaticResource GameCenter.ModAction.Separator}" />
                                            <Button Content="Uninstall CHIM" Command="{Binding HerikaManager.UninstallCommand}"
                                                    Style="{StaticResource GameCenter.ServerUninstallButton}" Height="38"
                                                    AutomationProperties.Name="Uninstall CHIM"
                                                    AutomationProperties.HelpText="Permanently delete this server, its database, and all of its profiles, memories, settings, logs, uploads, and voices. Asks for a typed confirmation first." />
                                        </StackPanel>

                                        <!-- Needs repair: repair in place, or purge and start over. -->
                                        <StackPanel Visibility="{Binding HerikaManager.ShowRepairActions, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Repair branch" Style="{StaticResource GameCenter.Caption}" Margin="0,0,0,5" />
                                            <ComboBox ItemsSource="{Binding HerikaManager.Branches}" SelectedItem="{Binding HerikaManager.SelectedBranch}"
                                                      Style="{StaticResource GameCenter.ComboBox}" HorizontalAlignment="Stretch"
                                                      IsEnabled="{Binding HerikaManager.CanRepair}"
                                                      AutomationProperties.Name="HerikaServer repair branch"
                                                      AutomationProperties.HelpText="Branch this server is repaired onto." />
                                            <Button Content="Repair Installation" Command="{Binding HerikaManager.RepairCommand}"
                                                    Style="{StaticResource GameCenter.Brand.ChimButton}" Margin="0,16,0,8" Height="38"
                                                    AutomationProperties.Name="Repair HerikaServer"
                                                    AutomationProperties.HelpText="Restore this server's files and database without deleting your data." />
                                            <Button Content="Uninstall CHIM" Command="{Binding HerikaManager.UninstallCommand}"
                                                    Style="{StaticResource GameCenter.ServerUninstallButton}" Height="38"
                                                    AutomationProperties.Name="Uninstall CHIM"
                                                    AutomationProperties.HelpText="Permanently delete this server, its database, and all of its profiles, memories, settings, logs, uploads, and voices. Asks for a typed confirmation first." />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel x:Name="StobeDetails" Visibility="Collapsed">
                                        <TextBlock FontWeight="SemiBold" FontSize="16"><Run Text="STOBE" Style="{StaticResource GameCenter.ModNameRun}" /><Run Text=" / StobeServer" /></TextBlock>

                                        <!-- Fixed-size status block. The single trimmed status line and the
                                             progress track below it always occupy the same space, so a busy or
                                             failed operation never resizes the actions underneath. -->
                                        <Grid Height="52" Margin="0,8,0,10">
                                            <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{Binding StobeManager.StatusText}" Foreground="{Binding StobeManager.StatusColor}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                                       ToolTip="{Binding StobeManager.AccessibleStatusHelpText}"
                                                       AutomationProperties.Name="StobeServer status"
                                                       AutomationProperties.HelpText="{Binding StobeManager.AccessibleStatusHelpText}"
                                                       AutomationProperties.LiveSetting="Polite" />
                                            <ProgressBar Grid.Row="1" Height="6" VerticalAlignment="Top"
                                                         IsIndeterminate="{Binding StobeManager.IsBusy}"
                                                         Background="#151515" BorderThickness="0"
                                                         Foreground="{DynamicResource GameCenter.Gold}"
                                                         IsTabStop="False" Focusable="False"
                                                         AutomationProperties.Name="StobeServer operation progress">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Opacity" Value="0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StobeManager.IsBusy}" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </Grid>

                                        <!-- Not installed: pick a branch, then install. Webpage, rollback and the
                                             update checkbox stay out of reach until the server exists. -->
                                        <StackPanel Visibility="{Binding StobeManager.ShowNotInstalledActions, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Install branch" Style="{StaticResource GameCenter.Caption}" Margin="0,0,0,5" />
                                            <ComboBox ItemsSource="{Binding StobeManager.Branches}" SelectedItem="{Binding StobeManager.SelectedBranch}"
                                                      Style="{StaticResource GameCenter.ComboBox}" HorizontalAlignment="Stretch"
                                                      IsEnabled="{Binding StobeManager.CanInstall}"
                                                      AutomationProperties.Name="StobeServer install branch"
                                                      AutomationProperties.HelpText="Branch used when this server is installed." />
                                            <Button Content="Install Server" Command="{Binding StobeManager.InstallCommand}"
                                                    Style="{StaticResource GameCenter.Brand.StobeButton}" Margin="0,16,0,0" Height="38"
                                                    AutomationProperties.Name="Install StobeServer"
                                                    AutomationProperties.HelpText="Download and install this server on the selected branch. Nothing else is changed." />
                                        </StackPanel>

                                        <!-- Installed: branch, system + mod update, webpage, rollback, then the destructive purge. -->
                                        <StackPanel Visibility="{Binding StobeManager.ShowInstalledActions, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Update branch" Style="{StaticResource GameCenter.Caption}" Margin="0,0,0,5" />
                                            <ComboBox ItemsSource="{Binding StobeManager.Branches}" SelectedItem="{Binding StobeManager.SelectedBranch}"
                                                      Style="{StaticResource GameCenter.ComboBox}" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="StobeServer update branch"
                                                      IsEnabled="{Binding StobeManager.CanUseInstalledFeatures}"
                                                      AutomationProperties.HelpText="Branch used the next time this mod updates. Unavailable while another server, component, or system operation is running." />
                                            <!-- Updates the shared system, then this mod on the chosen branch.
                                                 Disabled during conflicting operations so controls never shift. -->
                                            <Button Content="{Binding StobeManager.UpdateActionName}" Command="{Binding StobeManager.UpdateCommand}"
                                                    Style="{StaticResource GameCenter.Brand.StobeButton}" Margin="0,16,0,12" Height="40"
                                                    AutomationProperties.Name="{Binding StobeManager.UpdateActionName}"
                                                    ToolTip="{Binding StobeManager.UpdateActionHelpText}"
                                                    AutomationProperties.HelpText="{Binding StobeManager.UpdateActionHelpText}" />
                                            <Button Content="STOBE Webpage" Command="{Binding OpenStobeCommand}" Style="{StaticResource GameCenter.ModAction.StobeSecondaryButton}" Margin="0,0,0,6"
                                                    AutomationProperties.Name="STOBE Webpage"
                                                    AutomationProperties.HelpText="Open the STOBE server webpage. If it is unavailable, the launcher can start the server first." />
                                            <!-- External mod page. It opens the browser immediately and never
                                                 probes or starts WSL, so it stays usable while the installed server
                                                 is stopped. Neutral styling keeps it distinct from the
                                                 brand-coloured local actions above it. -->
                                            <Button Content="STOBE Nexus Page" Command="{Binding OpenStobeNexusCommand}" Style="{StaticResource GameCenter.ModAction.SecondaryButton}" Margin="0,0,0,6"
                                                    AutomationProperties.Name="STOBE Nexus Page"
                                                    AutomationProperties.HelpText="Open this mod's page on Nexus Mods in your browser. The local server is not started or contacted." />
                                            <Button Content="Rollback StobeServer" Command="{Binding OpenStobeRollbackCommand}" Style="{StaticResource GameCenter.ModAction.StobeSecondaryButton}"
                                                    AutomationProperties.Name="Rollback StobeServer"
                                                    AutomationProperties.HelpText="Roll this server back to an earlier installed version." />
                                            <!-- Decorative rule only. It ends the reversible actions so the purge below reads as a
                                                 separate decision; it is not focusable and adds nothing to the tab order. -->
                                            <Border Style="{StaticResource GameCenter.ModAction.Separator}" />
                                            <Button Content="Uninstall STOBE" Command="{Binding StobeManager.UninstallCommand}"
                                                    Style="{StaticResource GameCenter.ServerUninstallButton}" Height="38"
                                                    AutomationProperties.Name="Uninstall STOBE"
                                                    AutomationProperties.HelpText="Permanently delete this server, its database, and all of its profiles, memories, settings, logs, uploads, and voices. Asks for a typed confirmation first." />
                                        </StackPanel>

                                        <!-- Needs repair: repair in place, or purge and start over. -->
                                        <StackPanel Visibility="{Binding StobeManager.ShowRepairActions, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Repair branch" Style="{StaticResource GameCenter.Caption}" Margin="0,0,0,5" />
                                            <ComboBox ItemsSource="{Binding StobeManager.Branches}" SelectedItem="{Binding StobeManager.SelectedBranch}"
                                                      Style="{StaticResource GameCenter.ComboBox}" HorizontalAlignment="Stretch"
                                                      IsEnabled="{Binding StobeManager.CanRepair}"
                                                      AutomationProperties.Name="StobeServer repair branch"
                                                      AutomationProperties.HelpText="Branch this server is repaired onto." />
                                            <Button Content="Repair Installation" Command="{Binding StobeManager.RepairCommand}"
                                                    Style="{StaticResource GameCenter.Brand.StobeButton}" Margin="0,16,0,8" Height="38"
                                                    AutomationProperties.Name="Repair StobeServer"
                                                    AutomationProperties.HelpText="Restore this server's files and database without deleting your data." />
                                            <Button Content="Uninstall STOBE" Command="{Binding StobeManager.UninstallCommand}"
                                                    Style="{StaticResource GameCenter.ServerUninstallButton}" Height="38"
                                                    AutomationProperties.Name="Uninstall STOBE"
                                                    AutomationProperties.HelpText="Permanently delete this server, its database, and all of its profiles, memories, settings, logs, uploads, and voices. Asks for a typed confirmation first." />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel x:Name="DialecticDetails" Visibility="Collapsed">
                                        <TextBlock FontWeight="SemiBold" FontSize="16"><Run Text="Dialectic" Style="{StaticResource GameCenter.ModNameRun}" /><Run Text=" / DialecticServer" /></TextBlock>

                                        <!-- Fixed-size status block. The single trimmed status line and the
                                             progress track below it always occupy the same space, so a busy or
                                             failed operation never resizes the actions underneath. -->
                                        <Grid Height="52" Margin="0,8,0,10">
                                            <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{Binding DialecticManager.StatusText}" Foreground="{Binding DialecticManager.StatusColor}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                                       ToolTip="{Binding DialecticManager.AccessibleStatusHelpText}"
                                                       AutomationProperties.Name="DialecticServer status"
                                                       AutomationProperties.HelpText="{Binding DialecticManager.AccessibleStatusHelpText}"
                                                       AutomationProperties.LiveSetting="Polite" />
                                            <ProgressBar Grid.Row="1" Height="6" VerticalAlignment="Top"
                                                         IsIndeterminate="{Binding DialecticManager.IsBusy}"
                                                         Background="#151515" BorderThickness="0"
                                                         Foreground="{DynamicResource GameCenter.Gold}"
                                                         IsTabStop="False" Focusable="False"
                                                         AutomationProperties.Name="DialecticServer operation progress">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Opacity" Value="0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DialecticManager.IsBusy}" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </Grid>

                                        <!-- Not installed: pick a branch, then install. Webpage, rollback and the
                                             update checkbox stay out of reach until the server exists. -->
                                        <StackPanel Visibility="{Binding DialecticManager.ShowNotInstalledActions, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Install branch" Style="{StaticResource GameCenter.Caption}" Margin="0,0,0,5" />
                                            <ComboBox ItemsSource="{Binding DialecticManager.Branches}" SelectedItem="{Binding DialecticManager.SelectedBranch}"
                                                      Style="{StaticResource GameCenter.ComboBox}" HorizontalAlignment="Stretch"
                                                      IsEnabled="{Binding DialecticManager.CanInstall}"
                                                      AutomationProperties.Name="DialecticServer install branch"
                                                      AutomationProperties.HelpText="Branch used when this server is installed." />
                                            <Button Content="Install Server" Command="{Binding DialecticManager.InstallCommand}"
                                                    Style="{StaticResource GameCenter.Brand.DialecticButton}" Margin="0,16,0,0" Height="38"
                                                    AutomationProperties.Name="Install DialecticServer"
                                                    AutomationProperties.HelpText="Download and install this server on the selected branch. Nothing else is changed." />
                                        </StackPanel>

                                        <!-- Installed: branch, system + mod update, webpage, rollback, then the destructive purge. -->
                                        <StackPanel Visibility="{Binding DialecticManager.ShowInstalledActions, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Update branch" Style="{StaticResource GameCenter.Caption}" Margin="0,0,0,5" />
                                            <ComboBox ItemsSource="{Binding DialecticManager.Branches}" SelectedItem="{Binding DialecticManager.SelectedBranch}"
                                                      Style="{StaticResource GameCenter.ComboBox}" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="DialecticServer update branch"
                                                      IsEnabled="{Binding DialecticManager.CanUseInstalledFeatures}"
                                                      AutomationProperties.HelpText="Branch used the next time this mod updates. Unavailable while another server, component, or system operation is running." />
                                            <!-- Updates the shared system, then this mod on the chosen branch.
                                                 Disabled during conflicting operations so controls never shift. -->
                                            <Button Content="{Binding DialecticManager.UpdateActionName}" Command="{Binding DialecticManager.UpdateCommand}"
                                                    Style="{StaticResource GameCenter.Brand.DialecticButton}" Margin="0,16,0,12" Height="40"
                                                    AutomationProperties.Name="{Binding DialecticManager.UpdateActionName}"
                                                    ToolTip="{Binding DialecticManager.UpdateActionHelpText}"
                                                    AutomationProperties.HelpText="{Binding DialecticManager.UpdateActionHelpText}" />
                                            <Button Content="DIALECTIC Webpage" Command="{Binding OpenDialecticCommand}" Style="{StaticResource GameCenter.ModAction.DialecticSecondaryButton}" Margin="0,0,0,6"
                                                    AutomationProperties.Name="DIALECTIC Webpage"
                                                    AutomationProperties.HelpText="Open the Dialectic server webpage. If it is unavailable, the launcher can start the server first." />
                                            <!-- External mod page. It opens the browser immediately and never
                                                 probes or starts WSL, so it stays usable while the installed server
                                                 is stopped. Neutral styling keeps it distinct from the
                                                 brand-coloured local actions above it. -->
                                            <Button Content="DIALECTIC Nexus Page" Command="{Binding OpenDialecticNexusCommand}" Style="{StaticResource GameCenter.ModAction.SecondaryButton}" Margin="0,0,0,6"
                                                    AutomationProperties.Name="DIALECTIC Nexus Page"
                                                    AutomationProperties.HelpText="Open this mod's page on Nexus Mods in your browser. The local server is not started or contacted." />
                                            <Button Content="Rollback DialecticServer" Command="{Binding OpenDialecticRollbackCommand}" Style="{StaticResource GameCenter.ModAction.DialecticSecondaryButton}"
                                                    AutomationProperties.Name="Rollback DialecticServer"
                                                    AutomationProperties.HelpText="Roll this server back to an earlier installed version." />
                                            <!-- Decorative rule only. It ends the reversible actions so the purge below reads as a
                                                 separate decision; it is not focusable and adds nothing to the tab order. -->
                                            <Border Style="{StaticResource GameCenter.ModAction.Separator}" />
                                            <Button Content="Uninstall Dialectic" Command="{Binding DialecticManager.UninstallCommand}"
                                                    Style="{StaticResource GameCenter.ServerUninstallButton}" Height="38"
                                                    AutomationProperties.Name="Uninstall Dialectic"
                                                    AutomationProperties.HelpText="Permanently delete this server, its database, and all of its profiles, memories, settings, logs, uploads, and voices. Asks for a typed confirmation first." />
                                        </StackPanel>

                                        <!-- Needs repair: repair in place, or purge and start over. -->
                                        <StackPanel Visibility="{Binding DialecticManager.ShowRepairActions, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Repair branch" Style="{StaticResource GameCenter.Caption}" Margin="0,0,0,5" />
                                            <ComboBox ItemsSource="{Binding DialecticManager.Branches}" SelectedItem="{Binding DialecticManager.SelectedBranch}"
                                                      Style="{StaticResource GameCenter.ComboBox}" HorizontalAlignment="Stretch"
                                                      IsEnabled="{Binding DialecticManager.CanRepair}"
                                                      AutomationProperties.Name="DialecticServer repair branch"
                                                      AutomationProperties.HelpText="Branch this server is repaired onto." />
                                            <Button Content="Repair Installation" Command="{Binding DialecticManager.RepairCommand}"
                                                    Style="{StaticResource GameCenter.Brand.DialecticButton}" Margin="0,16,0,8" Height="38"
                                                    AutomationProperties.Name="Repair DialecticServer"
                                                    AutomationProperties.HelpText="Restore this server's files and database without deleting your data." />
                                            <Button Content="Uninstall Dialectic" Command="{Binding DialecticManager.UninstallCommand}"
                                                    Style="{StaticResource GameCenter.ServerUninstallButton}" Height="38"
                                                    AutomationProperties.Name="Uninstall Dialectic"
                                                    AutomationProperties.HelpText="Permanently delete this server, its database, and all of its profiles, memories, settings, logs, uploads, and voices. Asks for a typed confirmation first." />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                            <TextBlock Grid.Row="1" Text="{Binding ServerManagementStatusText}" Foreground="{Binding ServerManagementStatusColor}"
                                       TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"
                                       AutomationProperties.Name="Installed servers summary"
                                       AutomationProperties.LiveSetting="Polite" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Components">
                <Grid x:Name="SetupLandmark" Margin="18,16,18,12" MinHeight="0" ClipToBounds="True">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="COMPONENTS" Style="{StaticResource GameCenter.Heading}" />
                            <TextBlock Text="Install and configure shared services for this PC. System updates never change installed mods."
                                       Style="{StaticResource GameCenter.Caption}" Margin="0,4,0,0" />
                            <!-- One compact system line. It never wraps and its row height is fixed, so no
                                 state can push the components card down; the full sentence stays in the
                                 tooltip and in the accessible help text. Update System itself is the top
                                 bar action - this page no longer carries a second copy of it. -->
                            <TextBlock Text="{Binding SystemStatusText}" Foreground="{Binding SystemStatusColor}"
                                       Style="{StaticResource GameCenter.Caption}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Height="18" Margin="0,6,0,0"
                                       ToolTip="{Binding SystemStatusHelpText}"
                                       AutomationProperties.Name="System update status"
                                       AutomationProperties.HelpText="{Binding SystemStatusHelpText}"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                            <Button Content="Configure CUDA" Command="{Binding OpenCudaConfigCommand}"
                                    Style="{StaticResource GameCenter.Button}"
                                    IsEnabled="{Binding IsComponentInteractionEnabled}"
                                    AutomationProperties.HelpText="Configure the CUDA version used by compatible shared components." />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource GameCenter.Card}" Padding="0" ClipToBounds="True">
                        <!-- Empty until Components opens. MainWindow builds the page on entry and
                             drops it on exit so its visual tree can be collected. -->
                        <ContentControl x:Name="SetupComponentsHost" MinHeight="0" Focusable="False"
                                        IsEnabled="{Binding IsComponentInteractionEnabled}" />
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer x:Name="SettingsLandmark" VerticalScrollBarVisibility="Auto" Padding="18,16,18,12">
                    <!-- Every setting lives in this one StackPanel as a full-width SettingRow card:
                         title plus explanation on the left, a single compact action on the right.
                         Section headings break the list up but never split it into columns. -->
                    <StackPanel>
                        <TextBlock Text="SETTINGS" Style="{StaticResource GameCenter.Heading}" />
                        <TextBlock Text="Launcher preferences, setup, diagnostics, and backups."
                                   Style="{StaticResource GameCenter.Caption}" Margin="0,4,0,16" />

                        <TextBlock Text="SETUP" Style="{StaticResource GameCenter.SectionHeading}" Margin="0,0,0,10" />
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="First-Time Setup" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Open the guided setup flow for fresh installs or when you want to rerun the quickstart checks."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Open" Command="{Binding OpenFirstRunSetupCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Open first-time setup"
                                        AutomationProperties.HelpText="Open the guided setup flow for fresh installs or when you want to rerun the quickstart checks." />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Configure CUDA GPU" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Open CUDA setup and repair tools when NVIDIA GPU support needs to be installed or fixed."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Open" Command="{Binding OpenCudaConfigCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Open CUDA GPU configuration"
                                        AutomationProperties.HelpText="Open CUDA setup and repair tools when NVIDIA GPU support needs to be installed or fixed." />
                            </Grid>
                        </Border>

                        <TextBlock Text="DIAGNOSTICS" Style="{StaticResource GameCenter.SectionHeading}" Margin="0,12,0,10" />
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Create Diagnostic File" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Collect launcher, distro, and service troubleshooting data into a single diagnostic output."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Run" Command="{Binding GenerateDiagnosticsCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Create diagnostic file"
                                        AutomationProperties.HelpText="Collect launcher, distro, and service troubleshooting data into a single diagnostic output." />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Open Terminal" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Launch a shell inside the distro for manual inspection, package checks, or direct commands."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Open" Command="{Binding OpenTerminalCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Open terminal"
                                        AutomationProperties.HelpText="Launch a shell inside the distro for manual inspection, package checks, or direct commands." />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Distro Doctor" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Check and repair common distro issues including permissions, Apache, Background Life, ports, disk space, and recent logs."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Run" Command="{Binding DistroDoctorCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Run distro doctor"
                                        AutomationProperties.HelpText="Check and repair common distro issues including permissions, Apache, Background Life, ports, disk space, and recent logs." />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="View Memory Usage" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Open live resource usage inside WSL to inspect RAM, CPU, and process pressure."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Open" Command="{Binding ViewMemoryUsageCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="View memory usage"
                                        AutomationProperties.HelpText="Open live resource usage inside WSL to inspect RAM, CPU, and process pressure." />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Fix WSL DNS (GitHub)" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Repair common WSL DNS issues that block GitHub downloads, updates, or package installs."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Repair" Command="{Binding FixWslDnsCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Fix WSL DNS for GitHub"
                                        AutomationProperties.HelpText="Repair common WSL DNS issues that block GitHub downloads, updates, or package installs." />
                            </Grid>
                        </Border>

                        <TextBlock Text="MAINTENANCE AND BACKUPS" Style="{StaticResource GameCenter.SectionHeading}" Margin="0,12,0,10" />
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Reclaim Distro Disk Space" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Compact and recover unused WSL disk space after large installs, updates, or cleanup work."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Run" Command="{Binding ReclaimDistroDiskSpaceCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Reclaim distro disk space"
                                        AutomationProperties.HelpText="Compact and recover unused WSL disk space after large installs, updates, or cleanup work." />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Export Distro Backup" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Create a backup of the distro before major updates, installs, or configuration changes."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Export" Command="{Binding ExportDistroCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Export distro backup"
                                        AutomationProperties.HelpText="Create a backup of the distro before major updates, installs, or configuration changes." />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Import Distro Backup" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Restore a previously exported distro backup. Use this when you need to roll the full distro state back."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Import" Command="{Binding ImportDistroCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Import distro backup"
                                        AutomationProperties.HelpText="Restore a previously exported distro backup. Use this when you need to roll the full distro state back." />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Clean All Logs" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Clear accumulated service and Apache logs so fresh troubleshooting runs start with clean output."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Clean" Command="{Binding CleanLogsCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Clean all logs"
                                        AutomationProperties.HelpText="Clear accumulated service and Apache logs so fresh troubleshooting runs start with clean output." />
                            </Grid>
                        </Border>

                        <TextBlock Text="STARTUP OPTIONS" Style="{StaticResource GameCenter.SectionHeading}" Margin="0,12,0,10" />
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <!-- Checkbox-led row: the row title is the checkbox label, so the box reads as
                                 part of the setting name and clicking "Dwemer Dashboard WebUI" toggles it.
                                 The description and status line indent 32px (24px box column + 8px gap) so
                                 they hang under the label instead of under the box. -->
                            <StackPanel>
                                <CheckBox Content="Dwemer Dashboard WebUI" IsChecked="{Binding DashboardAutoOpenEnabled}"
                                          Command="{Binding SaveDashboardAutoOpenCommand}" Style="{StaticResource GameCenter.SettingCheckBox}"
                                          AutomationProperties.Name="Dwemer Dashboard WebUI, open on server start"
                                          AutomationProperties.HelpText="When checked, starting the DwemerDistro server opens the Dwemer Dashboard WebUI in your default browser on this PC. Leave it unchecked for headless or remote use. The change applies on the next server start." />
                                <TextBlock Text="Open the Dwemer Dashboard when the server starts. Turn this off for headless or remote setups. Applies on the next server start."
                                           Style="{StaticResource GameCenter.SettingRowDescription}"
                                           Margin="32,4,0,0" />
                                <TextBlock Text="{Binding DashboardAutoOpenStatusText}"
                                           Foreground="{Binding DashboardAutoOpenStatusColor}"
                                           AutomationProperties.LiveSetting="Polite"
                                           FontSize="11" Margin="32,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Logs">
                <ScrollViewer x:Name="LogsLandmark" VerticalScrollBarVisibility="Auto" Padding="18,16,18,12">
                    <StackPanel>
                        <TextBlock Text="LOGS" Style="{StaticResource GameCenter.Heading}" />
                        <TextBlock Text="Collect a debugging bundle, or open a live service log in a terminal window."
                                   Style="{StaticResource GameCenter.Caption}" Margin="0,4,0,14" />
                        <Border Style="{StaticResource GameCenter.Card}" BorderBrush="{DynamicResource GameCenter.Gold}" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="DISTRO DEBUGGING LOGS" Style="{StaticResource GameCenter.SectionHeading}" />
                                    <TextBlock Text="Bundles distro diagnostics into a single file to share when asking for support."
                                               Style="{StaticResource GameCenter.Caption}" Margin="0,4,16,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Generate Distro Debugging Logs"
                                        Command="{Binding GenerateDiagnosticsCommand}"
                                        Style="{StaticResource GameCenter.PrimaryButton}"
                                        MinWidth="238" MinHeight="40" VerticalAlignment="Center"
                                        AutomationProperties.Name="Generate distro debugging logs"
                                        AutomationProperties.HelpText="Create a diagnostic file with distro logs and system details." />
                            </Grid>
                        </Border>
                        <TextBlock Text="LIVE LOGS" Style="{StaticResource GameCenter.SectionHeading}" Margin="0,0,0,4" />
                        <TextBlock Text="Open a live service log in a terminal window." Style="{StaticResource GameCenter.Caption}" Margin="0,0,0,12" />
                        <WrapPanel>
                            <Button Command="{Binding ViewXttsLogsCommand}" Style="{StaticResource GameCenter.LogButton}" Content="Dwemer Distro XTTS" />
                            <Button Command="{Binding ViewChatterboxLogsCommand}" Style="{StaticResource GameCenter.LogButton}" Content="Chatterbox" />
                            <Button Command="{Binding ViewPocketTtsLogsCommand}" Style="{StaticResource GameCenter.LogButton}" Content="PocketTTS" />
                            <Button Command="{Binding ViewMeloTtsLogsCommand}" Style="{StaticResource GameCenter.LogButton}" Content="MeloTTS" />
                            <Button Command="{Binding ViewPiperLogsCommand}" Style="{StaticResource GameCenter.LogButton}" Content="Piper" />
                            <Button Command="{Binding ViewLocalWhisperLogsCommand}" Style="{StaticResource GameCenter.LogButton}" Content="LocalWhisper" />
                            <Button Command="{Binding ViewParakeetLogsCommand}" Style="{StaticResource GameCenter.LogButton}" Content="Parakeet" />
                            <Button Command="{Binding ViewApacheLogsCommand}" Style="{StaticResource GameCenter.LogButton}" Content="Apache" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border x:Name="ConsoleScrim" Grid.Row="2" Grid.Column="1" Background="#99000000" Visibility="Collapsed" Panel.ZIndex="9" />
        <Border x:Name="ConsoleDockHost" Grid.Row="3" Grid.Column="1" Background="#1A1A1A"
                BorderBrush="{DynamicResource GameCenter.BorderStrong}" BorderThickness="0,1,0,0" Panel.ZIndex="10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Button x:Name="ToggleConsoleButton" Content="Show Console"
                        Style="{StaticResource GameCenter.UtilityButton}" HorizontalContentAlignment="Left" Padding="18,8"
                        AutomationProperties.Name="Show Console" Click="ToggleConsoleButton_Click" />
                <!-- The console control is mounted only while expanded so its FlowDocument and
                     accessibility tree do not stay resident during normal launcher use. -->
                <ContentControl x:Name="OutputConsoleHost" Grid.Row="1" Focusable="False" />
            </Grid>
        </Border>

        <Border Grid.Row="4" Grid.Column="1" Background="#1A1A1A" BorderBrush="{DynamicResource GameCenter.Border}"
                BorderThickness="0,1,0,0" Padding="18,12">
            <ListBox x:Name="GameRail" ItemsSource="{Binding GameProfiles}" SelectedItem="{Binding SelectedGame}"
                     ItemContainerStyle="{StaticResource GameCenter.RailItem}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     KeyboardNavigation.DirectionalNavigation="Contained" SelectionChanged="GameRail_SelectionChanged"
                     AutomationProperties.Name="Dwemer game selection">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" Columns="3" /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="96">
                            <Grid ClipToBounds="True" Background="#151515">
                                <Image Source="{Binding RailImageSource}" Stretch="UniformToFill">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <Border Background="#50000000" />
                                <StackPanel Margin="12,10" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource GameCenter.ModCardTitle}" />
                                    <!-- Live branch | date version | semantic version for this product.
                                         The rail item's DataContext is the GameProfile, so each card reaches
                                         the matching MainWindowViewModel status through the window. -->
                                    <TextBlock FontSize="9"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Foreground" Value="#E0E0E0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Key}" Value="CHIM">
                                                        <Setter Property="Text" Value="{Binding DataContext.HerikaStatusText, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                        <Setter Property="Foreground" Value="{Binding DataContext.HerikaStatusColor, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Key}" Value="STOBE">
                                                        <Setter Property="Text" Value="{Binding DataContext.StobeStatusText, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                        <Setter Property="Foreground" Value="{Binding DataContext.StobeStatusColor, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Key}" Value="DIALECTIC">
                                                        <Setter Property="Text" Value="{Binding DataContext.DialecticStatusText, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                        <Setter Property="Foreground" Value="{Binding DataContext.DialecticStatusColor, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Window>
