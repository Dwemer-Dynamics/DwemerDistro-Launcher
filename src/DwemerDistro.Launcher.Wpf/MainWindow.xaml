                <Border x:Name="LmStudioLandmark" Margin="18,16,18,12" Style="{StaticResource GameCenter.Card}"
                        Visibility="{Binding IsLmStudioView, Converter={StaticResource BoolToVisibility}}">
                    <Border.Resources>
                        <Style x:Key="Lm.Card" TargetType="Border">
                            <Setter Property="Background" Value="#262626" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.Border}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="CornerRadius" Value="10" />
                            <Setter Property="Padding" Value="14,12" />
                            <Setter Property="Margin" Value="0,0,0,12" />
                        </Style>
                        <Style x:Key="Lm.Tile" TargetType="Border">
                            <Setter Property="Background" Value="#1E1E1E" />
                            <Setter Property="BorderBrush" Value="#454545" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="Padding" Value="12,10" />
                        </Style>
                        <Style x:Key="Lm.Title" TargetType="TextBlock" BasedOn="{StaticResource GameCenter.SectionHeading}">
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                        <Style x:Key="Lm.Sub" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
                            <Setter Property="FontSize" Value="11.5" />
                            <Setter Property="Margin" Value="8,0,0,0" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                        <Style x:Key="Lm.Note" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
                            <Setter Property="FontSize" Value="11.5" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                        <Style x:Key="Lm.Label" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
                            <Setter Property="FontSize" Value="11.5" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Margin" Value="0,0,0,3" />
                        </Style>
                        <Style x:Key="Lm.TextBox" TargetType="TextBox">
                            <Setter Property="Background" Value="#191919" />
                            <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
                            <Setter Property="CaretBrush" Value="{DynamicResource GameCenter.Text}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.BorderStrong}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="MinHeight" Value="32" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource GameCenter.CopperEdge}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource GameCenter.Focus}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Frame" Property="Opacity" Value="0.55" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <!-- Read-only values to select and copy: the same field, quieter. -->
                        <Style x:Key="Lm.ValueBox" TargetType="TextBox" BasedOn="{StaticResource Lm.TextBox}">
                            <Setter Property="IsReadOnly" Value="True" />
                            <Setter Property="IsReadOnlyCaretVisible" Value="True" />
                            <Setter Property="Background" Value="#1E1E1E" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.Border}" />
                            <Setter Property="FontFamily" Value="Consolas" />
                        </Style>
                        <Style x:Key="Lm.Chip" TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource GameCenter.CopperTint}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.CopperEdge}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="CornerRadius" Value="9" />
                            <Setter Property="Padding" Value="7,0,7,1" />
                            <Setter Property="Margin" Value="0,3,6,0" />
                        </Style>
                        <Style x:Key="Lm.ChipText" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource GameCenter.CopperStrong}" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                        <Style x:Key="Lm.GoodChip" TargetType="Border" BasedOn="{StaticResource Lm.Chip}">
                            <Setter Property="Background" Value="#1C2E1F" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.SuccessHover}" />
                        </Style>
                        <Style x:Key="Lm.GoodChipText" TargetType="TextBlock" BasedOn="{StaticResource Lm.ChipText}">
                            <Setter Property="Foreground" Value="{DynamicResource GameCenter.SuccessEdge}" />
                        </Style>
                        <Style x:Key="Lm.PlainChip" TargetType="Border" BasedOn="{StaticResource Lm.Chip}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.BorderStrong}" />
                        </Style>
                        <Style x:Key="Lm.PlainChipText" TargetType="TextBlock" BasedOn="{StaticResource Lm.ChipText}">
                            <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
                            <Setter Property="FontWeight" Value="Normal" />
                        </Style>
                        <!-- The row's Delete: compact like Load and Unload, with the danger outline so it never reads as either. -->
                        <Style x:Key="Lm.DeleteButton" TargetType="Button" BasedOn="{StaticResource GameCenter.DangerButton}">
                            <Setter Property="Padding" Value="10,3" />
                            <Setter Property="MinHeight" Value="28" />
                        </Style>
                        <Style x:Key="Lm.Field" TargetType="StackPanel">
                            <Setter Property="Width" Value="150" />
                            <Setter Property="Margin" Value="0,0,12,8" />
                        </Style>
                    </Border.Resources>
                    <ScrollViewer x:Name="LmStudioScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel MaxWidth="1180" KeyboardNavigation.TabNavigation="Local" Margin="0,0,4,0">
                            <!-- Title: the centurion core and the CHIM title face, as the game panels brand theirs. -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="Assets/centurioncore.png" Width="42" Height="42" Margin="0,0,12,0" VerticalAlignment="Center"
                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Centurion core">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <!-- Pelagiad's capitals reach the top of its line box and leave empty descender room below, so
                                         the heading moves down by that room; the block keeps its height and stays centred on the core.
                                         Pelagiad's word space is narrow, so an en space separates the words; the accessible name keeps a normal space. -->
                                    <TextBlock Text="LLM&#x2002;Studio" FontSize="28" Foreground="White" Margin="0,3,0,-3"
                                               AutomationProperties.Name="LLM Studio" AutomationProperties.HeadingLevel="Level1">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontFamily" Value="{StaticResource GameCenter.Font.Chim}" />
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                                                        <Setter Property="FontFamily" Value="Segoe UI" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Local language models for Dwemer Dynamics mods, running inside Dwemer Distro."
                                               Foreground="{DynamicResource GameCenter.TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Engine: state, slots in use and free memory, Start or Stop, the full studio and More (Refresh, Force stop). -->
                            <Border AutomationProperties.Name="Engine">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Lm.Card}">
                                        <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.Copper}" />
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#2E2620" Offset="0" />
                                                    <GradientStop Color="#262626" Offset="0.75" />
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <WrapPanel>
                                                <TextBlock Text="Engine" Style="{StaticResource Lm.Title}" FontSize="15" Margin="0,0,10,0"
                                                           AutomationProperties.HeadingLevel="Level2" />
                                                <Border CornerRadius="10" Padding="9,1,9,2" BorderThickness="1" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource GameCenter.PanelRaised}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.BorderStrong}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LmStudioEngineText}" Value="Running">
                                                                    <Setter Property="Background" Value="#1C2E1F" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.SuccessHover}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LmStudioEngineText}" Value="Unavailable">
                                                                    <Setter Property="Background" Value="{DynamicResource GameCenter.CopperTint}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.CopperEdge}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LmStudioEngineText}" Value="Not installed">
                                                                    <Setter Property="Background" Value="{DynamicResource GameCenter.CopperTint}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.CopperEdge}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding LmStudioEngineText}" FontSize="11.5" FontWeight="SemiBold"
                                                               AutomationProperties.Name="LLM Studio engine state">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding LmStudioEngineText}" Value="Running">
                                                                        <Setter Property="Foreground" Value="{DynamicResource GameCenter.SuccessEdge}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding LmStudioEngineText}" Value="Unavailable">
                                                                        <Setter Property="Foreground" Value="{DynamicResource GameCenter.CopperStrong}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding LmStudioEngineText}" Value="Not installed">
                                                                        <Setter Property="Foreground" Value="{DynamicResource GameCenter.CopperStrong}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding LmStudioEngineLine}" Style="{StaticResource Lm.Note}" FontSize="12" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding LmStudioResourcesText}" Style="{StaticResource Lm.Note}" Margin="0,2,0,0"
                                                       Visibility="{Binding HasLmStudioResources, Converter={StaticResource BoolToVisibility}}"
                                                       AutomationProperties.Name="Free memory and disk inside Dwemer Distro"
                                                       ToolTip="Measured inside Dwemer Distro by the LLM Studio helper." />
                                        </StackPanel>
                                        <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Button Content="Start" Command="{Binding StartLmStudioCommand}" Tag="&#xE768;"
                                                    Visibility="{Binding IsLmStudioStopped, Converter={StaticResource BoolToVisibility}}"
                                                    Style="{StaticResource GameCenter.GoButton}" Height="36" MinWidth="92" Padding="16,0" Margin="0,0,8,0"
                                                    ContentTemplate="{StaticResource GameCenter.ModAction.GlyphLabelTemplate}"
                                                    AutomationProperties.Name="Start engine"
                                                    AutomationProperties.HelpText="Start the engine and load the saved startup models." />
                                            <Button Content="Stop" Command="{Binding StopLmStudioCommand}" Tag="&#xE71A;"
                                                    Visibility="{Binding IsLmStudioRunning, Converter={StaticResource BoolToVisibility}}"
                                                    Style="{StaticResource GameCenter.Button}" Height="36" MinWidth="92" Padding="16,0" Margin="0,0,8,0"
                                                    ContentTemplate="{StaticResource GameCenter.ModAction.GlyphLabelTemplate}"
                                                    AutomationProperties.Name="Stop engine"
                                                    AutomationProperties.HelpText="Unload the models and stop the engine after any running operation finishes." />
                                            <Button Content="Open full studio" Command="{Binding OpenLmStudioCommand}" Tag="&#xE8A7;"
                                                    Style="{StaticResource GameCenter.GoButton}" Height="36" Padding="14,0" Margin="0,0,8,0"
                                                    ContentTemplate="{StaticResource GameCenter.ModAction.GlyphLabelTemplate}"
                                                    Visibility="{Binding HasLmStudioEngine, Converter={StaticResource BoolToVisibility}}"
                                                    AutomationProperties.HelpText="Open the full LLM Studio page in your browser for search, import, test presets and every load option." />
                                            <Button Content="Open Quickstart" Command="{Binding OpenFirstRunSetupCommand}"
                                                    Style="{StaticResource GameCenter.GoButton}" Height="36" Padding="16,0" Margin="0,0,8,0"
                                                    Visibility="{Binding IsLmStudioMissing, Converter={StaticResource BoolToVisibility}}"
                                                    AutomationProperties.HelpText="Set up LLM Studio from Quickstart." />
                                            <Button x:Name="LmStudioMoreButton" Content="&#x22EF;" Click="LmStudioMoreButton_Click"
                                                    Style="{StaticResource GameCenter.Button}" Height="36" MinWidth="40" FontSize="16" Padding="8,0,8,4"
                                                    AutomationProperties.Name="More engine actions"
                                                    AutomationProperties.HelpText="Refresh the status, or force stop a stuck engine."
                                                    ToolTip="More: refresh, force stop">
                                                <Button.ContextMenu>
                                                    <ContextMenu x:Name="LmStudioMoreMenu" Style="{StaticResource GameCenter.Menu}">
                                                        <MenuItem Header="Refresh status" Command="{Binding RefreshLmStudioCommand}"
                                                                  AutomationProperties.HelpText="Read the LLM Studio status again. Nothing is started or loaded." />
                                                        <Separator Style="{StaticResource GameCenter.MenuSeparator}" />
                                                        <MenuItem Header="Force stop engine…" Command="{Binding ForceStopLmStudioCommand}"
                                                                  Style="{StaticResource GameCenter.DangerMenuItem}"
                                                                  AutomationProperties.HelpText="Emergency stop. Immediately ends LLM Studio and interrupts any running load, download or reply. Asks for confirmation." />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </WrapPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding LmStudioStartHint}" Style="{StaticResource Lm.Note}" Margin="0,10,0,0"
                                               Visibility="{Binding HasLmStudioStartHint, Converter={StaticResource BoolToVisibility}}" />
                                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasLmStudioJob, Converter={StaticResource BoolToVisibility}}"
                                                AutomationProperties.Name="Operation in progress">
                                        <TextBlock Text="{Binding LmStudioJobText}" Style="{StaticResource Lm.Note}" Foreground="{DynamicResource GameCenter.Text}"
                                                   AutomationProperties.LiveSetting="Polite" />
                                        <ProgressBar Height="6" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="{Binding LmStudioJobPercent, Mode=OneWay}"
                                                     IsIndeterminate="{Binding IsLmStudioJobIndeterminate}" Background="#151515" BorderThickness="0"
                                                     Foreground="{DynamicResource GameCenter.CopperStrong}" IsTabStop="False" Focusable="False"
                                                     AutomationProperties.Name="LLM Studio operation progress" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding LmStudioActionText}" TextWrapping="Wrap" Margin="0,10,0,0" FontWeight="SemiBold"
                                               Visibility="{Binding HasLmStudioActionText, Converter={StaticResource BoolToVisibility}}"
                                               AutomationProperties.Name="LLM Studio action result"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock Text="{Binding LmStudioMessage}" Style="{StaticResource Lm.Note}" Margin="0,8,0,0"
                                               Visibility="{Binding HasLmStudioMessage, Converter={StaticResource BoolToVisibility}}"
                                               AutomationProperties.Name="LLM Studio status"
                                               AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Border>

                            <Grid x:Name="LmStudioColumns" SizeChanged="LmStudioColumns_SizeChanged"
                                  Visibility="{Binding HasLmStudioEngine, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="4*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel x:Name="LmStudioMainColumn">
                                    <!-- Loaded models: one tile per slot, each with Test and Unload. -->
                                    <Border Style="{StaticResource Lm.Card}" AutomationProperties.Name="Loaded models">
                                        <StackPanel>
                                            <WrapPanel Margin="0,0,0,10">
                                                <TextBlock Text="Loaded models" Style="{StaticResource Lm.Title}" AutomationProperties.HeadingLevel="Level2" />
                                                <TextBlock Text="{Binding LmStudioSlotsText}" Style="{StaticResource Lm.Sub}" />
                                            </WrapPanel>
                                            <TextBlock Text="Loaded models appear when LLM Studio's status is read." Style="{StaticResource Lm.Note}"
                                                       Visibility="{Binding IsLmStudioStatusUnknown, Converter={StaticResource BoolToVisibility}}" />
                                            <ItemsControl ItemsSource="{Binding LmStudioSlots}" Focusable="False" AutomationProperties.Name="Model slots">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="2" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,8,8" AutomationProperties.Name="{Binding Title}">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource Lm.Tile}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFilled}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.SuccessHover}" />
                                                                            <Setter Property="Background" Value="#1D241E" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <WrapPanel>
                                                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Margin="0,3,8,0"
                                                                               Foreground="{DynamicResource GameCenter.CopperStrong}" />
                                                                    <Border Style="{StaticResource Lm.Chip}" ToolTip="Saved startup role"
                                                                            Visibility="{Binding Model.HasRole, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                                                        <TextBlock Text="{Binding Model.Role}" Style="{StaticResource Lm.ChipText}" />
                                                                    </Border>
                                                                </WrapPanel>
                                                                <StackPanel Visibility="{Binding IsFilled, Converter={StaticResource BoolToVisibility}}">
                                                                    <TextBlock Text="{Binding Model.Name}" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,6,0,0"
                                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Model.Name}" />
                                                                    <TextBlock Text="{Binding Model.Details}" Style="{StaticResource Lm.Note}" Margin="0,2,0,0"
                                                                               Visibility="{Binding Model.HasDetails, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                                                                    <WrapPanel Margin="0,10,0,0">
                                                                        <Button Content="Test" Command="{Binding TestCommand}" Style="{StaticResource GameCenter.CompactGoButton}" Margin="0,0,8,0"
                                                                                AutomationProperties.Name="{Binding Model.Name, StringFormat=Test {0}}"
                                                                                AutomationProperties.HelpText="Choose this model in Try a model and move to its prompt. Nothing is sent yet." />
                                                                        <Button Content="Unload" Command="{Binding UnloadCommand}" Style="{StaticResource GameCenter.CompactButton}"
                                                                                AutomationProperties.Name="{Binding Model.Name, StringFormat=Unload {0}}"
                                                                                AutomationProperties.HelpText="Unload this model and free its slot. It stays downloaded." />
                                                                    </WrapPanel>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Lm.Note}" Margin="0,6,0,0"
                                                                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Library: every downloaded language model; Load opens its options inline, a loaded one offers Unload, and Delete removes the file after confirmation. -->
                                    <Border Style="{StaticResource Lm.Card}" AutomationProperties.Name="Model library"
                                            Visibility="{Binding HasLmStudioStatus, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <WrapPanel Margin="0,0,0,8">
                                                <TextBlock Text="Model library" Style="{StaticResource Lm.Title}" AutomationProperties.HeadingLevel="Level2" />
                                                <TextBlock Text="{Binding LmStudioLibraryCountText}" Style="{StaticResource Lm.Sub}" />
                                            </WrapPanel>
                                            <TextBlock Text="{Binding LmStudioLibraryNote}" Style="{StaticResource Lm.Note}" Margin="0,0,0,8"
                                                       Visibility="{Binding HasLmStudioLibraryNote, Converter={StaticResource BoolToVisibility}}"
                                                       AutomationProperties.LiveSetting="Polite" />
                                            <ItemsControl x:Name="LmStudioLibraryList" ItemsSource="{Binding LmStudioLibrary}" Focusable="False" AutomationProperties.Name="Downloaded models">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource Lm.Tile}" Margin="0,0,0,8" AutomationProperties.Name="{Binding Name}">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Margin="0,0,10,0">
                                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="White"
                                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Key}" />
                                                                        <WrapPanel>
                                                                            <TextBlock Text="{Binding Facts}" Style="{StaticResource Lm.Note}" Margin="0,3,8,0"
                                                                                       Visibility="{Binding HasFacts, Converter={StaticResource BoolToVisibility}}" />
                                                                            <Border Style="{StaticResource Lm.GoodChip}" Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibility}}">
                                                                                <TextBlock Text="{Binding LoadedText}" Style="{StaticResource Lm.GoodChipText}" />
                                                                            </Border>
                                                                            <Border Style="{StaticResource Lm.Chip}" Visibility="{Binding HasStartupRole, Converter={StaticResource BoolToVisibility}}">
                                                                                <TextBlock Text="{Binding StartupRole}" Style="{StaticResource Lm.ChipText}" />
                                                                            </Border>
                                                                            <Border Style="{StaticResource Lm.PlainChip}" Visibility="{Binding HasDefaults, Converter={StaticResource BoolToVisibility}}"
                                                                                    ToolTip="Remembered load settings. Load and startup use them.">
                                                                                <TextBlock Text="Saved settings" Style="{StaticResource Lm.PlainChipText}" />
                                                                            </Border>
                                                                            <Border Style="{StaticResource Lm.Chip}" Visibility="{Binding MayNotFit, Converter={StaticResource BoolToVisibility}}"
                                                                                    ToolTip="Larger than free RAM and VRAM less 2 GB headroom, the check LLM Studio makes before loading. Free memory or lower GPU offload.">
                                                                                <TextBlock Text="May not fit" Style="{StaticResource Lm.ChipText}" />
                                                                            </Border>
                                                                        </WrapPanel>
                                                                        <TextBlock Text="{Binding DeleteNote}" Style="{StaticResource Lm.Note}" FontSize="11" Margin="0,4,0,0"
                                                                                   Visibility="{Binding HasDeleteNote, Converter={StaticResource BoolToVisibility}}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Grid VerticalAlignment="Center">
                                                                            <Button Content="Load…" Command="{Binding ToggleLoadCommand}" Style="{StaticResource GameCenter.CompactGoButton}"
                                                                                    Visibility="{Binding ShowLoad, Converter={StaticResource BoolToVisibility}}"
                                                                                    AutomationProperties.Name="{Binding Name, StringFormat=Load {0}}"
                                                                                    AutomationProperties.HelpText="Show load options for this model. Nothing loads until you choose Load." />
                                                                            <Button Content="Close" Command="{Binding ToggleLoadCommand}" Style="{StaticResource GameCenter.CompactButton}"
                                                                                    Visibility="{Binding IsLoadOpen, Converter={StaticResource BoolToVisibility}}"
                                                                                    AutomationProperties.Name="{Binding Name, StringFormat=Close load options for {0}}" />
                                                                            <Button Content="Unload" Command="{Binding UnloadCommand}" Style="{StaticResource GameCenter.CompactButton}"
                                                                                    Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisibility}}"
                                                                                    AutomationProperties.Name="{Binding Name, StringFormat=Unload {0}}"
                                                                                    AutomationProperties.HelpText="Unload this model and free its slot. It stays downloaded." />
                                                                        </Grid>
                                                                        <!-- Permanent removal from disk, always after a confirmation whose default is Cancel. -->
                                                                        <Button Content="Delete…" Command="{Binding DeleteCommand}" Style="{StaticResource Lm.DeleteButton}" Margin="8,0,0,0"
                                                                                ToolTip="{Binding DeleteHint}" ToolTipService.ShowOnDisabled="True"
                                                                                AutomationProperties.Name="{Binding Name, StringFormat=Delete {0}}"
                                                                                AutomationProperties.HelpText="{Binding DeleteHint}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                                <ContentControl Content="{Binding LoadForm}" Focusable="False" IsTabStop="False"
                                                                                Visibility="{Binding IsLoadOpen, Converter={StaticResource BoolToVisibility}}">
                                                                    <ContentControl.ContentTemplate>
                                                                        <DataTemplate>
                                                                            <Border Margin="0,10,0,0" Padding="12" CornerRadius="8" Background="#232323" BorderThickness="1"
                                                                                    BorderBrush="{DynamicResource GameCenter.CopperEdge}" KeyboardNavigation.TabNavigation="Local"
                                                                                    AutomationProperties.Name="{Binding Name, StringFormat=Load options for {0}}">
                                                                                <StackPanel>
                                                                                    <WrapPanel>
                                                                                        <StackPanel Style="{StaticResource Lm.Field}">
                                                                                            <TextBlock x:Name="ContextLabel" Text="Context length" Style="{StaticResource Lm.Label}" />
                                                                                            <TextBox Text="{Binding Context, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Lm.TextBox}" MaxLength="6"
                                                                                                     AutomationProperties.LabeledBy="{Binding ElementName=ContextLabel}"
                                                                                                     AutomationProperties.HelpText="Tokens, 512 to 131,072. More context needs more memory." />
                                                                                            <TextBlock Text="tokens, 512–131,072" Style="{StaticResource Lm.Note}" FontSize="11" Margin="0,2,0,0" />
                                                                                        </StackPanel>
                                                                                        <StackPanel Style="{StaticResource Lm.Field}">
                                                                                            <TextBlock x:Name="GpuLabel" Text="GPU offload" Style="{StaticResource Lm.Label}" />
                                                                                            <TextBox Text="{Binding Gpu, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Lm.TextBox}" MaxLength="3"
                                                                                                     AutomationProperties.LabeledBy="{Binding ElementName=GpuLabel}"
                                                                                                     AutomationProperties.HelpText="Percent of the model kept in GPU memory, 0 to 100. Lower it if VRAM is short." />
                                                                                            <TextBlock Text="% in GPU memory, 0–100" Style="{StaticResource Lm.Note}" FontSize="11" Margin="0,2,0,0" />
                                                                                        </StackPanel>
                                                                                        <StackPanel Style="{StaticResource Lm.Field}">
                                                                                            <TextBlock x:Name="IdleLabel" Text="Unload after idle" Style="{StaticResource Lm.Label}" />
                                                                                            <TextBox Text="{Binding IdleMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Lm.TextBox}" MaxLength="4"
                                                                                                     AutomationProperties.LabeledBy="{Binding ElementName=IdleLabel}"
                                                                                                     AutomationProperties.HelpText="Minutes, 1 to 1,440. LM Studio unloads the model when nothing uses it for this long." />
                                                                                            <TextBlock Text="minutes, 1–1,440" Style="{StaticResource Lm.Note}" FontSize="11" Margin="0,2,0,0" />
                                                                                        </StackPanel>
                                                                                        <StackPanel Style="{StaticResource Lm.Field}">
                                                                                            <TextBlock x:Name="SlotLabel" Text="Slot" Style="{StaticResource Lm.Label}" />
                                                                                            <ComboBox ItemsSource="{Binding SlotChoices}" SelectedItem="{Binding Slot}" Style="{StaticResource GameCenter.ComboBox}"
                                                                                                      Visibility="{Binding HasSlotChoice, Converter={StaticResource BoolToVisibility}}"
                                                                                                      AutomationProperties.LabeledBy="{Binding ElementName=SlotLabel}" />
                                                                                            <TextBlock Text="{Binding SlotText}" Style="{StaticResource Lm.Note}" Margin="0,7,0,0" />
                                                                                        </StackPanel>
                                                                                    </WrapPanel>
                                                                                    <WrapPanel Visibility="{Binding AdvancedAvailable, Converter={StaticResource BoolToVisibility}}">
                                                                                        <StackPanel Style="{StaticResource Lm.Field}">
                                                                                            <TextBlock x:Name="FlashLabel" Text="Flash attention" Style="{StaticResource Lm.Label}" />
                                                                                            <ComboBox ItemsSource="{Binding ToggleChoices}" SelectedItem="{Binding FlashAttention}" Style="{StaticResource GameCenter.ComboBox}"
                                                                                                      AutomationProperties.LabeledBy="{Binding ElementName=FlashLabel}" />
                                                                                        </StackPanel>
                                                                                        <StackPanel Style="{StaticResource Lm.Field}">
                                                                                            <TextBlock x:Name="KeepLabel" Text="Keep in memory" Style="{StaticResource Lm.Label}" />
                                                                                            <ComboBox ItemsSource="{Binding ToggleChoices}" SelectedItem="{Binding KeepInMemory}" Style="{StaticResource GameCenter.ComboBox}"
                                                                                                      AutomationProperties.LabeledBy="{Binding ElementName=KeepLabel}" />
                                                                                        </StackPanel>
                                                                                        <StackPanel Style="{StaticResource Lm.Field}">
                                                                                            <TextBlock x:Name="KCacheLabel" Text="K cache type" Style="{StaticResource Lm.Label}" />
                                                                                            <ComboBox ItemsSource="{Binding CacheChoices}" SelectedItem="{Binding KCache}" Style="{StaticResource GameCenter.ComboBox}"
                                                                                                      AutomationProperties.LabeledBy="{Binding ElementName=KCacheLabel}" />
                                                                                        </StackPanel>
                                                                                        <StackPanel Style="{StaticResource Lm.Field}">
                                                                                            <TextBlock x:Name="VCacheLabel" Text="V cache type" Style="{StaticResource Lm.Label}" />
                                                                                            <ComboBox ItemsSource="{Binding CacheChoices}" SelectedItem="{Binding VCache}" Style="{StaticResource GameCenter.ComboBox}"
                                                                                                      AutomationProperties.LabeledBy="{Binding ElementName=VCacheLabel}"
                                                                                                      AutomationProperties.HelpText="A quantized V cache needs Flash attention set to On." />
                                                                                        </StackPanel>
                                                                                    </WrapPanel>
                                                                                    <TextBlock Text="{Binding AdvancedNote}" Style="{StaticResource Lm.Note}" Margin="0,0,0,8"
                                                                                               Visibility="{Binding HasAdvancedNote, Converter={StaticResource BoolToVisibility}}" />
                                                                                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,8"
                                                                                               Foreground="{DynamicResource GameCenter.DangerText}"
                                                                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                                                                                               AutomationProperties.LiveSetting="Polite" />
                                                                                    <CheckBox Content="Remember these settings for this model (startup uses them too)" IsChecked="{Binding Remember}"
                                                                                              Style="{StaticResource GameCenter.CheckBox}" Margin="0,0,0,10" />
                                                                                    <WrapPanel>
                                                                                        <Button Content="Load" Command="{Binding LoadCommand}" Style="{StaticResource GameCenter.GoButton}"
                                                                                                MinWidth="92" Margin="0,0,8,0"
                                                                                                AutomationProperties.Name="{Binding Name, StringFormat=Load {0} now}"
                                                                                                AutomationProperties.HelpText="Load this model into the chosen slot. LLM Studio checks free memory first and never replaces a loaded model." />
                                                                                        <Button Content="Cancel" Command="{Binding CloseCommand}" Style="{StaticResource GameCenter.Button}" MinWidth="80" />
                                                                                    </WrapPanel>
                                                                                    <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,0"
                                                                                               Visibility="{Binding HasOutcome, Converter={StaticResource BoolToVisibility}}"
                                                                                               AutomationProperties.LiveSetting="Polite" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ContentControl.ContentTemplate>
                                                                </ContentControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="LmStudioSideColumn" Grid.Column="2">
                                    <!-- Try a model: one prompt to a model that is already loaded. -->
                                    <Border Style="{StaticResource Lm.Card}" AutomationProperties.Name="Try a model"
                                            Visibility="{Binding HasLmStudioStatus, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="Try a model" Style="{StaticResource Lm.Title}" Margin="0,0,0,10" AutomationProperties.HeadingLevel="Level2" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock x:Name="LmStudioTestModelLabel" Text="Loaded model" Style="{StaticResource Lm.Label}" />
                                                    <ComboBox ItemsSource="{Binding LmStudioModels}" SelectedItem="{Binding LmStudioTestModel}" Style="{StaticResource GameCenter.ComboBox}"
                                                              MinWidth="0" IsEnabled="{Binding HasLmStudioModels}" AutomationProperties.LabeledBy="{Binding ElementName=LmStudioTestModelLabel}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="0,0,0,8">
                                                    <TextBlock x:Name="LmStudioReasoningLabel" Text="Reasoning" Style="{StaticResource Lm.Label}" />
                                                    <ComboBox ItemsSource="{Binding LmStudioReasoningChoices}" SelectedItem="{Binding LmStudioTestReasoning}" Style="{StaticResource GameCenter.ComboBox}"
                                                              MinWidth="0" AutomationProperties.LabeledBy="{Binding ElementName=LmStudioReasoningLabel}"
                                                              AutomationProperties.HelpText="Default turns thinking off when the model allows it, so a short test gets an answer." />
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                                    <TextBlock x:Name="LmStudioMaxTokensLabel" Text="Max reply length (tokens)" Style="{StaticResource Lm.Label}" />
                                                    <TextBox Text="{Binding LmStudioTestMaxTokens, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Lm.TextBox}" MaxLength="4"
                                                             AutomationProperties.LabeledBy="{Binding ElementName=LmStudioMaxTokensLabel}"
                                                             AutomationProperties.HelpText="1 to 4,096 tokens." />
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                                                    <TextBlock x:Name="LmStudioTemperatureLabel" Text="Temperature (0–1)" Style="{StaticResource Lm.Label}" />
                                                    <TextBox Text="{Binding LmStudioTestTemperature, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Lm.TextBox}" MaxLength="5"
                                                             AutomationProperties.LabeledBy="{Binding ElementName=LmStudioTemperatureLabel}"
                                                             AutomationProperties.HelpText="0 to 1. Lower is more predictable." />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock x:Name="LmStudioPromptLabel" Text="Prompt" Style="{StaticResource Lm.Label}" />
                                            <TextBox x:Name="LmStudioPromptBox" Text="{Binding LmStudioTestPrompt, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Lm.TextBox}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000" Height="76" VerticalContentAlignment="Top"
                                                     VerticalScrollBarVisibility="Auto"
                                                     AutomationProperties.LabeledBy="{Binding ElementName=LmStudioPromptLabel}" />
                                            <TextBlock Text="{Binding LmStudioTestPromptCount}" Style="{StaticResource Lm.Note}" FontSize="11" HorizontalAlignment="Right" Margin="0,2,0,6" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Content="Run test" Command="{Binding RunLmStudioTestCommand}" Tag="&#xE8BD;"
                                                        Style="{StaticResource GameCenter.GoButton}" Height="34" Padding="14,0" Margin="0,0,10,0" VerticalAlignment="Top"
                                                        ContentTemplate="{StaticResource GameCenter.ModAction.GlyphLabelTemplate}"
                                                        AutomationProperties.HelpText="Send this prompt once to the selected loaded model. A test never starts the engine or loads a model." />
                                                <TextBlock Grid.Column="1" Text="{Binding LmStudioTestNote}" Style="{StaticResource Lm.Note}" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="{Binding LmStudioTestResult}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,10,0,0"
                                                       Visibility="{Binding HasLmStudioTestResult, Converter={StaticResource BoolToVisibility}}"
                                                       AutomationProperties.Name="Test result" AutomationProperties.LiveSetting="Polite" />
                                            <TextBox Text="{Binding LmStudioTestOutput, Mode=OneWay}" Style="{StaticResource Lm.TextBox}" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                                     TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0,6,0,0"
                                                     Background="#1E1E1E" Visibility="{Binding HasLmStudioTestOutput, Converter={StaticResource BoolToVisibility}}"
                                                     AutomationProperties.Name="Model reply" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Startup: saved separately from what is loaded now. -->
                                    <Border Style="{StaticResource Lm.Card}" AutomationProperties.Name="Startup models">
                                        <StackPanel>
                                            <WrapPanel Margin="0,0,0,10">
                                                <TextBlock Text="Startup" Style="{StaticResource Lm.Title}" AutomationProperties.HeadingLevel="Level2" />
                                                <TextBlock Text="What loads when the engine starts" Style="{StaticResource Lm.Sub}" />
                                            </WrapPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock x:Name="LmStudioDialogueLabel" Text="Dialogue model" Style="{StaticResource Lm.Label}" />
                                                    <ComboBox ItemsSource="{Binding LmStudioStartupChoices}" DisplayMemberPath="Name" SelectedValuePath="Key"
                                                              SelectedValue="{Binding LmStudioStartupDialogue}" Style="{StaticResource GameCenter.ComboBox}" MinWidth="0"
                                                              AutomationProperties.LabeledBy="{Binding ElementName=LmStudioDialogueLabel}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="0,0,0,8">
                                                    <TextBlock x:Name="LmStudioDecisionLabel" Text="Decision model (optional)" Style="{StaticResource Lm.Label}" />
                                                    <ComboBox ItemsSource="{Binding LmStudioStartupChoices}" DisplayMemberPath="Name" SelectedValuePath="Key"
                                                              SelectedValue="{Binding LmStudioStartupDecision}" Style="{StaticResource GameCenter.ComboBox}" MinWidth="0"
                                                              AutomationProperties.LabeledBy="{Binding ElementName=LmStudioDecisionLabel}" />
                                                </StackPanel>
                                            </Grid>
                                            <CheckBox Content="Start LLM Studio when Dwemer Distro starts" IsChecked="{Binding LmStudioAutostart}"
                                                      Style="{StaticResource GameCenter.CheckBox}" Margin="0,2,0,8"
                                                      ToolTip="On by default. Turn off to start LLM Studio manually. Shared with the Dashboard."
                                                      AutomationProperties.HelpText="On by default: the engine starts and loads the startup models whenever Dwemer Distro starts. Turn off to start it manually. The Dashboard shares this setting." />
                                            <TextBlock Text="{Binding LmStudioStartupNote}" Style="{StaticResource Lm.Note}" Margin="0,0,0,10"
                                                       AutomationProperties.LiveSetting="Polite" />
                                            <Button Content="Save startup" Command="{Binding SaveLmStudioStartupCommand}" HorizontalAlignment="Left"
                                                    Style="{StaticResource GameCenter.Button}" Height="34" Padding="16,0"
                                                    AutomationProperties.Name="Save startup models"
                                                    AutomationProperties.HelpText="Save autostart and the startup models. No model is loaded or unloaded." />
                                        </StackPanel>
                                    </Border>

                                    <!-- Recommended models: the distro catalog's pinned presets, read only when this opens. -->
                                    <Expander Header="Recommended models" IsExpanded="{Binding IsLmStudioDownloadsExpanded}"
                                              Style="{StaticResource GameCenter.ModAction.ManageExpander}" Margin="0,0,0,10"
                                              Visibility="{Binding HasLmStudioStatus, Converter={StaticResource BoolToVisibility}}"
                                              AutomationProperties.Name="Recommended models"
                                              AutomationProperties.HelpText="Show the pinned models this distro recommends and download one. Downloading never loads a model.">
                                        <Border Style="{StaticResource Lm.Card}" Margin="0">
                                            <StackPanel>
                                                <TextBlock Text="Pinned, verified downloads from this distro's catalog. They are not game-tested and VRAM figures are estimates. Downloading does not load a model."
                                                           Style="{StaticResource Lm.Note}" Margin="0,0,0,8" />
                                                <TextBlock Text="{Binding LmStudioCatalogNote}" Style="{StaticResource Lm.Note}" Margin="0,0,0,8"
                                                           Visibility="{Binding HasLmStudioCatalogNote, Converter={StaticResource BoolToVisibility}}"
                                                           AutomationProperties.LiveSetting="Polite" />
                                                <TextBlock Text="{Binding LmStudioDownloadText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"
                                                           Visibility="{Binding HasLmStudioDownloadText, Converter={StaticResource BoolToVisibility}}"
                                                           AutomationProperties.LiveSetting="Polite" />
                                                <Button Content="Try again" Command="{Binding ReloadLmStudioCatalogCommand}" HorizontalAlignment="Left"
                                                        Style="{StaticResource GameCenter.CompactButton}" Margin="0,0,0,8"
                                                        Visibility="{Binding HasLmStudioCatalogNote, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="Dialogue models" Style="{StaticResource Lm.Label}" Foreground="White"
                                                           Visibility="{Binding HasLmStudioCatalogDialogue, Converter={StaticResource BoolToVisibility}}" />
                                                <ItemsControl ItemsSource="{Binding LmStudioCatalogDialogue}" Focusable="False"
                                                              Visibility="{Binding HasLmStudioCatalogDialogue, Converter={StaticResource BoolToVisibility}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource Lm.Tile}" Margin="0,0,0,6" AutomationProperties.Name="{Binding Title}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Margin="0,0,10,0">
                                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding Model.Purpose}" Style="{StaticResource Lm.Note}" Margin="0,2,0,0" />
                                                                        <TextBlock Text="{Binding Model.Facts}" Style="{StaticResource Lm.Note}" FontSize="11" Margin="0,2,0,0" />
                                                                    </StackPanel>
                                                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                                                        <Button Content="Download" Command="{Binding DownloadCommand}" Style="{StaticResource GameCenter.CompactGoButton}"
                                                                                Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibility}}"
                                                                                AutomationProperties.Name="{Binding Model.Name, StringFormat=Download {0}}"
                                                                                AutomationProperties.HelpText="Download and verify this pinned file. It does not load the model." />
                                                                        <Border Style="{StaticResource Lm.GoodChip}" Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                                                                            <TextBlock Text="Downloaded" Style="{StaticResource Lm.GoodChipText}" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="Decision models (optional)" Style="{StaticResource Lm.Label}" Foreground="White" Margin="0,6,0,3"
                                                           Visibility="{Binding HasLmStudioCatalogDecision, Converter={StaticResource BoolToVisibility}}" />
                                                <ItemsControl ItemsSource="{Binding LmStudioCatalogDecision}" Focusable="False"
                                                              Visibility="{Binding HasLmStudioCatalogDecision, Converter={StaticResource BoolToVisibility}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource Lm.Tile}" Margin="0,0,0,6" AutomationProperties.Name="{Binding Title}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Margin="0,0,10,0">
                                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                                                                        <TextBlock Text="{Binding Model.Purpose}" Style="{StaticResource Lm.Note}" Margin="0,2,0,0" />
                                                                        <TextBlock Text="{Binding Model.Facts}" Style="{StaticResource Lm.Note}" FontSize="11" Margin="0,2,0,0" />
                                                                    </StackPanel>
                                                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                                                        <Button Content="Download" Command="{Binding DownloadCommand}" Style="{StaticResource GameCenter.CompactGoButton}"
                                                                                Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibility}}"
                                                                                AutomationProperties.Name="{Binding Model.Name, StringFormat=Download {0}}"
                                                                                AutomationProperties.HelpText="Download and verify this pinned file. It does not load the model." />
                                                                        <Border Style="{StaticResource Lm.GoodChip}" Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                                                                            <TextBlock Text="Downloaded" Style="{StaticResource Lm.GoodChipText}" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Expander>

                                    <!-- Connection details: the fixed endpoint inside the distro and the loaded instance ids connectors use. -->
                                    <Expander Header="Connection details" Style="{StaticResource GameCenter.ModAction.ManageExpander}" Margin="0,0,0,10"
                                              Visibility="{Binding HasLmStudioStatus, Converter={StaticResource BoolToVisibility}}"
                                              AutomationProperties.Name="Connection details"
                                              AutomationProperties.HelpText="The engine's address inside Dwemer Distro and the model IDs mods connect to.">
                                        <Border Style="{StaticResource Lm.Card}" Margin="0">
                                            <StackPanel>
                                                <TextBlock Text="These addresses work inside Dwemer Distro, where the game servers run. 127.0.0.1 here is the distro, not your Windows PC."
                                                           Style="{StaticResource Lm.Note}" Margin="0,0,0,8" />
                                                <TextBlock x:Name="LmStudioEndpointLabel" Text="Base URL (inside Dwemer Distro)" Style="{StaticResource Lm.Label}" />
                                                <TextBox Text="{Binding LmStudioEndpoint, Mode=OneWay}" Style="{StaticResource Lm.ValueBox}" Margin="0,0,0,8"
                                                         AutomationProperties.LabeledBy="{Binding ElementName=LmStudioEndpointLabel}" />
                                                <TextBlock x:Name="LmStudioChatUrlLabel" Text="Chat URL (inside Dwemer Distro)" Style="{StaticResource Lm.Label}" />
                                                <TextBox Text="{Binding LmStudioChatUrl, Mode=OneWay}" Style="{StaticResource Lm.ValueBox}" Margin="0,0,0,8"
                                                         AutomationProperties.LabeledBy="{Binding ElementName=LmStudioChatUrlLabel}" />
                                                <TextBlock Text="Model IDs of loaded models" Style="{StaticResource Lm.Label}" />
                                                <TextBlock Text="No model is loaded." Style="{StaticResource Lm.Note}"
                                                           Visibility="{Binding HasNoLmStudioModels, Converter={StaticResource BoolToVisibility}}" />
                                                <ItemsControl ItemsSource="{Binding LmStudioModels}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,6">
                                                                <TextBlock Text="{Binding}" Style="{StaticResource Lm.Note}" Margin="0,0,0,2" />
                                                                <TextBox Text="{Binding InstanceId, Mode=OneWay}" Style="{StaticResource Lm.ValueBox}"
                                                                         AutomationProperties.Name="{Binding Name, StringFormat=Model ID of {0}}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Expander>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- The catalog and release details share this center panel; neither opens a window. -->
                <views:CommunityModsBrowser x:Name="CustomModBrowser" Margin="18,16,18,12"
                                            Visibility="{Binding IsShowingCustomModBrowser, Converter={StaticResource BoolToVisibility}}"
                                            RepositoryRequested="CommunityMod_Requested" />
                <ContentControl x:Name="CommunityModDetailsHost" Margin="18,16,18,12"
                                Content="{Binding CommunityDetails}"
                                Visibility="{Binding IsShowingCommunityModDetails, Converter={StaticResource BoolToVisibility}}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                <!-- Custom mods detail. Same two cards as the official view: the mod's installed banner, else
                     artwork from its public repository (generic placeholder otherwise) with name and description on the left,
                     status and actions on the right. Everything else comes from ddistro_custom_mod status. -->
                <Grid x:Name="CustomModsLandmark" Margin="18,16,18,12"
                      Visibility="{Binding IsShowingInstalledCustomMod, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.15*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1*" MinWidth="280" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource GameCenter.Card}" Padding="0" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Background="#151515">
                                <Image x:Name="CustomHeroArt" Source="{Binding SelectedCustomModHeroImage}" Stretch="Uniform"
                                       AutomationProperties.Name="{Binding SelectedCustomMod.Name, StringFormat={}{0} artwork}" />
                                <!-- Generic placeholder for mods without a banner or public GitHub artwork, while it loads,
                                     or when it cannot be fetched. -->
                                <StackPanel x:Name="CustomHeroPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedCustomModHeroImage}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Image Source="Assets/dd_title.png" Height="64" Stretch="Uniform" Opacity="0.35"
                                           AutomationProperties.Name="Custom mod placeholder artwork" />
                                    <TextBlock Text="CUSTOM MOD" Foreground="{DynamicResource GameCenter.TextMuted}" FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,10,0,0" />
                                </StackPanel>
                            </Grid>
                            <!-- Plain UI font: the shared title style's brand fonts follow the official selection. -->
                            <!-- Title, the game directly below it, the quieter author credit, then the description. -->
                            <StackPanel Grid.Row="1" Margin="18,14" Visibility="{Binding HasSelectedCustomMod, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding SelectedCustomMod.Name}" Foreground="{DynamicResource GameCenter.Text}"
                                           FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SelectedCustomMod.GameName}" ToolTip="{Binding SelectedCustomMod.GameName}"
                                           Style="{StaticResource CustomMod.OptionalText}" Foreground="{DynamicResource GameCenter.TextMuted}"
                                           FontSize="14" Margin="0,1,0,0" />
                                <TextBlock Text="{Binding SelectedCustomMod.AuthorCredit}" ToolTip="{Binding SelectedCustomMod.AuthorCredit}"
                                           Style="{StaticResource CustomMod.OptionalText}" Foreground="{DynamicResource GameCenter.TextMuted}"
                                           Opacity="0.75" FontSize="11" Margin="0,3,0,0" />
                                <TextBlock Text="{Binding SelectedCustomMod.Description}" ToolTip="{Binding SelectedCustomMod.Description}"
                                           Foreground="{DynamicResource GameCenter.Text}" TextTrimming="CharacterEllipsis"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="18,14" Visibility="{Binding HasNoCustomMods, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Custom mods" Foreground="{DynamicResource GameCenter.Text}" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="PHP/PostgreSQL mod servers added from a public repository."
                                           Foreground="{DynamicResource GameCenter.Text}" TextTrimming="CharacterEllipsis"
                                           FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource GameCenter.Card}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <!-- Scrolls like the official card so no action clips at the minimum window size. -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False" Padding="0,0,2,0">
                                <Grid>
                                    <StackPanel Visibility="{Binding HasSelectedCustomMod, Converter={StaticResource BoolToVisibility}}">
                                        <!-- The mod name is the title under the artwork; here it is a quiet caption. -->
                                        <TextBlock Text="{Binding SelectedCustomMod.Name}" Style="{StaticResource GameCenter.Caption}" FontWeight="SemiBold"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

                                        <!-- Fixed-height status block, like the official cards, so busy and failed states
                                             never move the actions below. -->
                                        <Grid Height="52" Margin="0,8,0,10">
                                            <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                            <TextBlock Text="{Binding SelectedCustomModStateText}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource GameCenter.Text}"
                                                       ToolTip="{Binding SelectedCustomModStateText}"
                                                       AutomationProperties.Name="Custom mod status" AutomationProperties.LiveSetting="Polite" />
                                            <ProgressBar Grid.Row="1" Height="6" VerticalAlignment="Top" IsIndeterminate="{Binding IsCustomModBusy}"
                                                         Background="#151515" BorderThickness="0" Foreground="{DynamicResource GameCenter.CopperStrong}"
                                                         IsTabStop="False" Focusable="False" AutomationProperties.Name="Custom mod operation progress">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Opacity" Value="0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCustomModBusy}" Value="True">
                                                                <Setter Property="Opacity" Value="1" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                        </Grid>

                                        <!-- Installed source, then the dashboard and the update from that source, links and
                                             checks, the separate branch check and switch, and removal last below a rule. -->
                                        <TextBlock Style="{StaticResource GameCenter.Caption}" Margin="0,0,0,5" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SelectedCustomMod.Repository}" Text="{Binding SelectedCustomModVersionText}" />
                                        <TextBlock Text="{Binding SelectedCustomModBranchNotice}" Style="{StaticResource GameCenter.Caption}" TextWrapping="Wrap"
                                                   Margin="0,0,0,5" AutomationProperties.Name="Custom mod branch notice"
                                                   Visibility="{Binding HasSelectedCustomModBranchNotice, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="Open dashboard" Command="{Binding OpenCustomModDashboardCommand}" Style="{StaticResource GameCenter.ModAction.PrimaryButton}"
                                                Margin="0,6,0,8" Height="38"
                                                AutomationProperties.HelpText="Open this mod's local dashboard in your browser." />
                                        <!-- Update has no confirmed-availability signal for custom mods, so it stays a secondary
                                             action and the dashboard is the primary one. Neither moves. -->
                                        <Button Content="Update" Command="{Binding UpdateCustomModCommand}" Style="{StaticResource GameCenter.ModAction.SecondaryButton}"
                                                Height="38"
                                                AutomationProperties.HelpText="Back up, then update from the repository. Refused if you changed the mod's files." />
                                        <!-- External project page (browser only; never probes or starts WSL) and local checks. -->
                                        <HeaderedContentControl Header="Links and checks" Style="{StaticResource GameCenter.ModAction.Group}">
                                            <StackPanel>
                                                <Button Content="{Binding SelectedCustomModRepositoryActionName}" Command="{Binding OpenCustomModRepositoryCommand}"
                                                        Style="{StaticResource GameCenter.ModAction.SecondaryButton}"
                                                        AutomationProperties.Name="{Binding SelectedCustomModRepositoryActionName}"
                                                        ToolTip="{Binding SelectedCustomMod.Repository}"
                                                        AutomationProperties.HelpText="Open this mod's public repository in your browser. The local server is not started or contacted." />
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Button Content="Check status" Command="{Binding CheckCustomModHealthCommand}" Style="{StaticResource GameCenter.ModAction.SecondaryButton}"
                                                            AutomationProperties.HelpText="Ask the distro whether this mod's health page responds." />
                                                    <Button Grid.Column="2" Content="Back up" Command="{Binding BackupCustomModCommand}" Style="{StaticResource GameCenter.ModAction.SecondaryButton}"
                                                            AutomationProperties.HelpText="Save a copy of this mod's settings and database inside the distro." />
                                                </Grid>
                                            </StackPanel>
                                        </HeaderedContentControl>
                                        <!-- The author's offered branches, from the last explicit check stored by the distro.
                                             Kept apart from Update, which always uses the installed source: choosing a branch
                                             changes nothing until Switch branch reviews and confirms it. -->
                                        <HeaderedContentControl Header="Branch" Style="{StaticResource GameCenter.ModAction.Group}"
                                                                Visibility="{Binding SelectedCustomModUsesBranches, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel>
                                                <ComboBox ItemsSource="{Binding SelectedCustomModBranchOptions}" SelectedItem="{Binding SelectedCustomModBranch}"
                                                          Style="{StaticResource GameCenter.ComboBox}" HorizontalAlignment="Stretch"
                                                          AutomationProperties.Name="Custom mod branch"
                                                          IsEnabled="{Binding IsComponentInteractionEnabled}"
                                                          AutomationProperties.HelpText="Branches offered by the mod's author, from the last branch check. Choose one, then Switch branch to review it." />
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Button Content="Check branches" Command="{Binding CheckCustomModBranchesCommand}" Style="{StaticResource GameCenter.ModAction.SecondaryButton}"
                                                            AutomationProperties.HelpText="Ask the repository which branches the author offers now. Nothing is installed." />
                                                    <Button Grid.Column="2" Content="Switch branch" Command="{Binding SwitchCustomModBranchCommand}" Style="{StaticResource GameCenter.ModAction.SecondaryButton}"
                                                            AutomationProperties.HelpText="Review the chosen branch's exact version, then confirm to back up and switch." />
                                                </Grid>
                                            </StackPanel>
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="Manage" Style="{StaticResource GameCenter.ModAction.Group}">
                                            <Button Content="{Binding SelectedCustomModUnregisterActionName}" Command="{Binding UnregisterCustomModCommand}" Style="{StaticResource GameCenter.ModAction.UninstallButton}"
                                                    AutomationProperties.HelpText="Review removal. Private data and server files are kept; package installs also remove their owned game client files." />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding HasNoCustomMods, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Custom mods" FontSize="18" Foreground="{DynamicResource GameCenter.Text}" />
                                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource GameCenter.Text}"
                                                   Text="Add a PHP/PostgreSQL mod server from a public repository. It runs inside the distro with its own folder and database." />
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                            <TextBlock Grid.Row="1" Text="{Binding CustomModsStatusText}" Margin="0,8,0,0" MinHeight="16"
                                       Style="{StaticResource GameCenter.Caption}" TextWrapping="Wrap"
                                       AutomationProperties.Name="Custom mods message" AutomationProperties.LiveSetting="Polite" />
                        </Grid>
                    </Border>
                </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Components">
                <Grid x:Name="SetupLandmark" Margin="18,16,18,12" MinHeight="0" ClipToBounds="True">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="COMPONENTS" Style="{StaticResource GameCenter.Heading}" />
                            <TextBlock Text="Install and configure shared services for this PC. System updates never change installed mods."
                                       Style="{StaticResource GameCenter.Caption}" Margin="0,4,0,0" />
                            <!-- One compact system line. It never wraps and its row height is fixed, so no
                                 state can push the components card down; the full sentence stays in the
                                 tooltip and in the accessible help text. -->
                            <TextBlock Text="{Binding SystemStatusText}" Foreground="{Binding SystemStatusColor}"
                                       Style="{StaticResource GameCenter.Caption}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Height="18" Margin="0,6,0,0"
                                       ToolTip="{Binding SystemStatusHelpText}"
                                       AutomationProperties.Name="System update status"
                                       AutomationProperties.HelpText="{Binding SystemStatusHelpText}"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                            <Button Content="Configure CUDA" Command="{Binding OpenCudaConfigCommand}"
                                    Style="{StaticResource GameCenter.Button}"
                                    IsEnabled="{Binding IsComponentInteractionEnabled}"
                                    AutomationProperties.HelpText="Configure the CUDA version used by compatible shared components." />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource GameCenter.Card}" Padding="0" ClipToBounds="True">
                        <!-- Empty until Components opens. MainWindow builds the page on entry and
                             drops it on exit so its visual tree can be collected. -->
                        <ContentControl x:Name="SetupComponentsHost" MinHeight="0" Focusable="False"
                                        IsEnabled="{Binding IsComponentInteractionEnabled}" />
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer x:Name="SettingsLandmark" VerticalScrollBarVisibility="Auto" Padding="18,16,18,12">
                    <!-- Every setting lives in this one StackPanel as a full-width SettingRow card:
                         title plus explanation on the left, a single compact action on the right.
                         Section headings break the list up but never split it into columns. -->
                    <StackPanel>
                        <TextBlock Text="SETTINGS" Style="{StaticResource GameCenter.Heading}" />
                        <TextBlock Text="Launcher preferences, setup, diagnostics, and backups."
                                   Style="{StaticResource GameCenter.Caption}" Margin="0,4,0,16" />

                        <!-- First-Time Setup is also where a routine distro update is retried by hand: its Update Distro step.
                             The launcher otherwise updates on its own when it opens, and the Debian 13 upgrade
                             is the top bar's Upgrade DwemerDistro. -->
                        <TextBlock Text="SETUP" Style="{StaticResource GameCenter.SectionHeading}" Margin="0,0,0,10" />
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="First-Time Setup" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Open the guided setup flow for fresh installs or when you want to rerun the quickstart checks."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button x:Name="FirstTimeSetupButton" Grid.Column="1" Content="Open" Command="{Binding OpenFirstRunSetupCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Open first-time setup"
                                        AutomationProperties.HelpText="Open the guided setup flow for fresh installs or when you want to rerun the quickstart checks." />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Configure CUDA GPU" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Open CUDA setup and repair tools when NVIDIA GPU support needs to be installed or fixed."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Open" Command="{Binding OpenCudaConfigCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Open CUDA GPU configuration"
                                        AutomationProperties.HelpText="Open CUDA setup and repair tools when NVIDIA GPU support needs to be installed or fixed." />
                            </Grid>
                        </Border>

                        <TextBlock Text="DIAGNOSTICS" Style="{StaticResource GameCenter.SectionHeading}" Margin="0,12,0,10" />
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Create Diagnostic File" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Collect launcher, distro, and service troubleshooting data into a single diagnostic output."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Run" Command="{Binding GenerateDiagnosticsCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Create diagnostic file"
                                        AutomationProperties.HelpText="Collect launcher, distro, and service troubleshooting data into a single diagnostic output." />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Open Terminal" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Launch a shell inside the distro for manual inspection, package checks, or direct commands."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Open" Command="{Binding OpenTerminalCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Open terminal"
                                        AutomationProperties.HelpText="Launch a shell inside the distro for manual inspection, package checks, or direct commands." />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Distro Doctor" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Check and repair common distro issues including permissions, Apache, Background Life, ports, disk space, and recent logs."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Run" Command="{Binding DistroDoctorCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Run distro doctor"
                                        AutomationProperties.HelpText="Check and repair common distro issues including permissions, Apache, Background Life, ports, disk space, and recent logs." />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="View Memory Usage" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Open live resource usage inside WSL to inspect RAM, CPU, and process pressure."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Open" Command="{Binding ViewMemoryUsageCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="View memory usage"
                                        AutomationProperties.HelpText="Open live resource usage inside WSL to inspect RAM, CPU, and process pressure." />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Fix WSL DNS (GitHub)" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Repair common WSL DNS issues that block GitHub downloads, updates, or package installs."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Repair" Command="{Binding FixWslDnsCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Fix WSL DNS for GitHub"
                                        AutomationProperties.HelpText="Repair common WSL DNS issues that block GitHub downloads, updates, or package installs." />
                            </Grid>
                        </Border>

                        <TextBlock Text="UPDATE OPTIONS" Style="{StaticResource GameCenter.SectionHeading}" Margin="0,12,0,10" />
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <!-- Checkbox-led row, like Dwemer Dashboard WebUI below: the checkbox label is
                                 the row title, and the description, the standing warning, and the saved
                                 state indent 32px so they hang under the label rather than the box. The
                                 warning is permanent text, not a state message, because the danger applies
                                 whenever the option is on. -->
                            <StackPanel>
                                <CheckBox Content="Force Updates" IsChecked="{Binding ForceGitUpdatesEnabled}"
                                          Command="{Binding ConfirmForceGitUpdatesCommand}" Style="{StaticResource GameCenter.SettingCheckBox}"
                                          AutomationProperties.Name="Force Updates, overwrite manually edited server files"
                                          AutomationProperties.HelpText="Destructive. When checked, launcher updates for managed servers permanently discard your manual edits to files those servers track in Git, with no undo. Git may also replace untracked or ignored files that conflict with the update, so back up custom files first. Turning this on asks for confirmation first; turning it off does not. Off by default." />
                                <TextBlock Text="Allow launcher server updates to overwrite tracked files changed manually. Git may also replace conflicting untracked or ignored files, so back up custom files first."
                                           Style="{StaticResource GameCenter.SettingRowDescription}"
                                           Margin="32,4,0,0" />
                                <TextBlock Text="Warning: while this is on, updating a mod server permanently discards your manual edits to its tracked files. There is no undo."
                                           Foreground="{DynamicResource GameCenter.DangerText}"
                                           FontSize="11" Margin="32,6,0,0" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ForceGitUpdatesStatusText}"
                                           Foreground="{Binding ForceGitUpdatesStatusColor}"
                                           AutomationProperties.LiveSetting="Polite"
                                           FontSize="11" Margin="32,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="MAINTENANCE AND BACKUPS" Style="{StaticResource GameCenter.SectionHeading}" Margin="0,12,0,10" />
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Compact Distro" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Delete installer caches the launcher can download again, release that space inside the distro, and hand that space back to Windows. Your mods, installed servers and components, models, voices, databases, settings, logs, and Hugging Face sign-in are kept."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                    <TextBlock Text="This stops the DwemerDistro server and every other running WSL distribution, and Windows asks you to approve an administrator prompt. The server stays stopped afterwards, so start it again when you are ready."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                    <TextBlock x:Name="CompactDistroStatusTextBlock"
                                               Text="{Binding CompactDistroStatusText}"
                                               Foreground="{Binding CompactDistroStatusColor}"
                                               Visibility="{Binding HasCompactDistroStatus, Converter={StaticResource BoolToVisibility}}"
                                               AutomationProperties.LiveSetting="Polite"
                                               FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Compact" Command="{Binding CompactDistroCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Compact distro"
                                        AutomationProperties.HelpText="Delete installer caches the launcher can download again, release that space inside the distro, and hand that space back to Windows. Mods, installed servers and components, models, voices, databases, settings, logs, and Hugging Face sign-in are kept. This stops the DwemerDistro server and every other running WSL distribution, needs Windows administrator approval, and leaves the server stopped. You are asked to confirm first, and the confirmation defaults to No." />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Database Maintenance" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Upgrade the database to PostgreSQL 17, or roll back to PostgreSQL 15."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                    <TextBlock Text="The automatic distro update also does this on its own, with no questions. It waits while a supported game is open and finishes once you close it."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                    <TextBlock Text="Rollback checks for changed data before restoring PostgreSQL 15."
                                               Foreground="{DynamicResource GameCenter.DangerText}"
                                               FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DatabaseMaintenanceStatusText}"
                                               Foreground="{Binding DatabaseMaintenanceStatusColor}"
                                               Visibility="{Binding HasDatabaseMaintenanceStatus, Converter={StaticResource BoolToVisibility}}"
                                               AutomationProperties.LiveSetting="Polite"
                                               FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Content="Upgrade" Command="{Binding UpgradeDatabaseCommand}"
                                            Style="{StaticResource GameCenter.SettingRowButton}"
                                            AutomationProperties.Name="Upgrade database to PostgreSQL 17"
                                            AutomationProperties.HelpText="Runs the distro's PostgreSQL 17 upgrade as root. You are asked to confirm first, and the confirmation defaults to No. Rollback is only possible before anything is written to the upgraded database." />
                                    <Button Content="Roll back" Command="{Binding RollbackDatabaseCommand}"
                                            Style="{StaticResource GameCenter.SettingRowButton}" Margin="0,8,0,0"
                                            AutomationProperties.Name="Roll back PostgreSQL 17 database upgrade"
                                            AutomationProperties.HelpText="Rolls back a PostgreSQL 17 upgrade. Only use this before anything is written to the upgraded database; data written since the upgrade is not carried back. You are asked to confirm first, and the confirmation defaults to No." />
                                    <!-- Shown only while a distro update holds its database upgrade for an open game, so
                                         the wait can always be ended from where its status is shown. -->
                                    <Button Content="Stop waiting" Command="{Binding StopDatabaseUpgradeWaitCommand}"
                                            Visibility="{Binding IsDatabaseUpgradeWaiting, Converter={StaticResource BoolToVisibility}}"
                                            Style="{StaticResource GameCenter.SettingRowButton}" Margin="0,8,0,0"
                                            AutomationProperties.Name="Stop waiting to upgrade the database"
                                            AutomationProperties.HelpText="The distro update is waiting for an open game to close before upgrading the database to PostgreSQL 17. Stopping postpones the upgrade, changes nothing, and leaves the distro update unfinished so it runs again later." />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Export Distro Backup" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Create a backup of the distro before major updates, installs, or configuration changes."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Export" Command="{Binding ExportDistroCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Export distro backup"
                                        AutomationProperties.HelpText="Create a backup of the distro before major updates, installs, or configuration changes." />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Import Distro Backup" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Restore a previously exported distro backup. Use this when you need to roll the full distro state back."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Import" Command="{Binding ImportDistroCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Import distro backup"
                                        AutomationProperties.HelpText="Restore a previously exported distro backup. Use this when you need to roll the full distro state back." />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Clean All Logs" Style="{StaticResource GameCenter.SettingRowTitle}" />
                                    <TextBlock Text="Clear accumulated service and Apache logs so fresh troubleshooting runs start with clean output."
                                               Style="{StaticResource GameCenter.SettingRowDescription}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Clean" Command="{Binding CleanLogsCommand}"
                                        Style="{StaticResource GameCenter.SettingRowButton}"
                                        AutomationProperties.Name="Clean all logs"
                                        AutomationProperties.HelpText="Clear accumulated service and Apache logs so fresh troubleshooting runs start with clean output." />
                            </Grid>
                        </Border>

                        <TextBlock Text="STARTUP OPTIONS" Style="{StaticResource GameCenter.SectionHeading}" Margin="0,12,0,10" />
                        <Border Style="{StaticResource GameCenter.SettingRow}">
                            <!-- Checkbox-led row: the row title is the checkbox label, so the box reads as
                                 part of the setting name and clicking "Dwemer Dashboard WebUI" toggles it.
                                 The description and status line indent 32px (24px box column + 8px gap) so
                                 they hang under the label instead of under the box. -->
                            <StackPanel>
                                <CheckBox Content="Dwemer Dashboard WebUI" IsChecked="{Binding DashboardAutoOpenEnabled}"
                                          Command="{Binding SaveDashboardAutoOpenCommand}" Style="{StaticResource GameCenter.SettingCheckBox}"
                                          AutomationProperties.Name="Dwemer Dashboard WebUI, open on server start"
                                          AutomationProperties.HelpText="When checked, starting the DwemerDistro server opens the Dwemer Dashboard WebUI in your default browser on this PC. Leave it unchecked for headless or remote use. The change applies on the next server start." />
                                <TextBlock Text="Open the Dwemer Dashboard when the server starts. Turn this off for headless or remote setups. Applies on the next server start."
                                           Style="{StaticResource GameCenter.SettingRowDescription}"
                                           Margin="32,4,0,0" />
                                <TextBlock Text="{Binding DashboardAutoOpenStatusText}"
                                           Foreground="{Binding DashboardAutoOpenStatusColor}"
                                           AutomationProperties.LiveSetting="Polite"
                                           FontSize="11" Margin="32,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Logs">
                <ScrollViewer x:Name="LogsLandmark" VerticalScrollBarVisibility="Auto" Padding="18,16,18,12">
                    <StackPanel>
                        <TextBlock Text="LOGS" Style="{StaticResource GameCenter.Heading}" />
                        <TextBlock Text="Collect a debugging bundle, or open a live service log in a terminal window."
                                   Style="{StaticResource GameCenter.Caption}" Margin="0,4,0,14" />
                        <Border Style="{StaticResource GameCenter.Card}" BorderBrush="{DynamicResource GameCenter.CopperEdge}" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="DISTRO DEBUGGING LOGS" Style="{StaticResource GameCenter.SectionHeading}" />
                                    <TextBlock Text="Bundles distro diagnostics into a single file to share when asking for support."
                                               Style="{StaticResource GameCenter.Caption}" Margin="0,4,16,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Generate Distro Debugging Logs"
                                        Command="{Binding GenerateDiagnosticsCommand}"
                                        Style="{StaticResource GameCenter.CompactGoButton}"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Generate distro debugging logs"
                                        AutomationProperties.HelpText="Create a diagnostic file with distro logs and system details." />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource GameCenter.Card}" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding RefreshConnectionDetailsCommand}"
                                            Style="{StaticResource GameCenter.CompactButton}" Width="28" Height="28" MinWidth="28" MinHeight="28"
                                            Padding="0" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                                            ToolTip="Refresh" AutomationProperties.Name="Refresh"
                                            AutomationProperties.HelpText="Read current addresses without starting a stopped distro.">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" FontWeight="Normal" />
                                    </Button>
                                    <TextBlock Text="CONNECTION DETAILS" Style="{StaticResource GameCenter.SectionHeading}" VerticalAlignment="Center" />
                                </DockPanel>
                                <Grid Margin="0,10,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="ThisPcAddressLabel" Text="This PC" Style="{StaticResource GameCenter.Caption}" Margin="0,0,12,8" />
                                    <TextBlock Grid.Column="1" Text="{Binding ThisPcAddressText}" TextWrapping="Wrap" Margin="0,0,0,8"
                                               AutomationProperties.LabeledBy="{Binding ElementName=ThisPcAddressLabel}" />
                                    <TextBlock x:Name="WslAddressLabel" Grid.Row="1" Text="WSL address" Style="{StaticResource GameCenter.Caption}" Margin="0,0,12,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WslAddressText}" TextWrapping="Wrap"
                                               AutomationProperties.LabeledBy="{Binding ElementName=WslAddressLabel}" />
                                </Grid>
                                <TextBlock Text="On this PC, use the mod's Open button. These addresses are for troubleshooting; LAN access may require additional setup."
                                           Style="{StaticResource GameCenter.Caption}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <TextBlock x:Name="ConnectionDetailsStatusTextBlock" Text="{Binding ConnectionDetailsStatus}"
                                           Style="{StaticResource GameCenter.Caption}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="LIVE LOGS" Style="{StaticResource GameCenter.SectionHeading}" Margin="0,0,0,4" />
                        <TextBlock Text="Open a live service log in a terminal window." Style="{StaticResource GameCenter.Caption}" Margin="0,0,0,12" />
                        <WrapPanel x:Name="LiveLogButtons">
                            <Button Command="{Binding ViewXttsLogsCommand}" Style="{StaticResource GameCenter.LogButton}"
                                    ToolTip="Dwemer Distro XTTS log" AutomationProperties.Name="Dwemer Distro XTTS log">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="Assets/component-xtts.png" Style="{StaticResource GameCenter.LogButtonIcon}" />
                                    <TextBlock Text="XTTS" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ViewChatterboxLogsCommand}" Style="{StaticResource GameCenter.LogButton}"
                                    ToolTip="Chatterbox log" AutomationProperties.Name="Chatterbox log">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="Assets/component-chatterbox.png" Style="{StaticResource GameCenter.LogButtonIcon}" />
                                    <TextBlock Text="Chatterbox" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ViewPocketTtsLogsCommand}" Style="{StaticResource GameCenter.LogButton}"
                                    ToolTip="PocketTTS log" AutomationProperties.Name="PocketTTS log">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="Assets/component-pocket-tts.png" Style="{StaticResource GameCenter.LogButtonIcon}" />
                                    <TextBlock Text="PocketTTS" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ViewPiperLogsCommand}" Style="{StaticResource GameCenter.LogButton}"
                                    ToolTip="Piper log" AutomationProperties.Name="Piper log">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="Assets/component-piper.png" Style="{StaticResource GameCenter.LogButtonIcon}" />
                                    <TextBlock Text="Piper" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ViewLocalWhisperLogsCommand}" Style="{StaticResource GameCenter.LogButton}"
                                    ToolTip="LocalWhisper log" AutomationProperties.Name="LocalWhisper log">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="Assets/component-whisper.png" Style="{StaticResource GameCenter.LogButtonIcon}" />
                                    <TextBlock Text="LocalWhisper" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ViewParakeetLogsCommand}" Style="{StaticResource GameCenter.LogButton}"
                                    ToolTip="Parakeet log" AutomationProperties.Name="Parakeet log">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="Assets/component-parakeet.png" Style="{StaticResource GameCenter.LogButtonIcon}" />
                                    <TextBlock Text="Parakeet" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ViewApacheLogsCommand}" Style="{StaticResource GameCenter.LogButton}"
                                    ToolTip="Apache error log" AutomationProperties.Name="Apache error log">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="14" FontWeight="Normal"
                                               Width="16" Margin="0,0,8,0" TextAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Text="Apache" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Assistant">
                <!-- The view model is created on first binding and runs nothing until Connect. -->
                <views:AssistantView x:Name="AssistantLandmark" DataContext="{Binding Assistant}" />
            </TabItem>
            <TabItem Header="API Keys">
                <ContentControl x:Name="ApiKeysHost" KeyboardNavigation.TabNavigation="Continue" />
            </TabItem>
        </TabControl>

        <Border x:Name="ConsoleScrim" Grid.Row="2" Grid.Column="1" Background="#99000000" Visibility="Collapsed" Panel.ZIndex="9" />
        <Border x:Name="ConsoleDockHost" Grid.Row="3" Grid.Column="1" Background="#1A1A1A"
                BorderBrush="{DynamicResource GameCenter.BorderStrong}" BorderThickness="0,1,0,0" Panel.ZIndex="10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Button x:Name="ToggleConsoleButton" Content="Show Console"
                        Style="{StaticResource GameCenter.UtilityButton}" HorizontalContentAlignment="Left" Padding="18,8"
                        AutomationProperties.Name="Show Console" Click="ToggleConsoleButton_Click" />
                <!-- The console control is mounted only while expanded so its FlowDocument and
                     accessibility tree do not stay resident during normal launcher use. -->
                <ContentControl x:Name="OutputConsoleHost" Grid.Row="1" Focusable="False" />
            </Grid>
        </Border>
    </Grid>
</Window>
