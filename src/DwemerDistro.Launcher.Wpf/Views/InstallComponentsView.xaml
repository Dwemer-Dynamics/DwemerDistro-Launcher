<UserControl x:Class="DwemerDistro.Launcher.Wpf.Views.InstallComponentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="ComponentsPage"
             Background="#2C2C2C"
             Loaded="InstallComponentsView_Loaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- Compact dark palette for the component cards, matched to the launcher surfaces. -->
        <SolidColorBrush x:Key="Components.Raised" Color="#333333" />
        <SolidColorBrush x:Key="Components.Line" Color="#424242" />
        <SolidColorBrush x:Key="Components.LineStrong" Color="#585858" />
        <SolidColorBrush x:Key="Components.Text" Color="#ECECEC" />
        <SolidColorBrush x:Key="Components.Muted" Color="#B4B4B4" />
        <SolidColorBrush x:Key="Components.Gold" Color="#D8B44C" />
        <SolidColorBrush x:Key="Components.GoldSoft" Color="#413C30" />
        <SolidColorBrush x:Key="Components.Ok" Color="#86D08C" />
        <SolidColorBrush x:Key="Components.Warn" Color="#E6B45E" />
        <SolidColorBrush x:Key="Components.Bad" Color="#F08A8A" />
        <SolidColorBrush x:Key="Components.Off" Color="#9A9A9A" />
        <!-- Neutral light plate so dark and light artwork both stay legible without recoloring. -->
        <SolidColorBrush x:Key="Components.ArtPlate" Color="#EFEDE9" />
        <SolidColorBrush x:Key="Components.ArtLine" Color="#5A5A5A" />

        <!-- Card actions keep the shared GameCenter template (focus ring, pressed, disabled)
             at a compact height so a card footer fits on one or two lines. -->
        <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource GameCenter.Button}">
            <Setter Property="Background" Value="#3A3A3A" />
            <Setter Property="BorderBrush" Value="{StaticResource Components.LineStrong}" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Margin" Value="0,4,6,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#454545" />
                    <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.GoldSoft}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardPrimaryButton" TargetType="Button" BasedOn="{StaticResource GameCenter.PrimaryButton}">
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Margin" Value="0,4,6,0" />
        </Style>

        <Style x:Key="CardQuietButton" TargetType="Button" BasedOn="{StaticResource CardButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Components.Muted}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="6,3" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#454545" />
                    <Setter Property="BorderBrush" Value="#454545" />
                    <Setter Property="Foreground" Value="{StaticResource Components.Text}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TileBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Components.Raised}" />
            <Setter Property="BorderBrush" Value="{StaticResource Components.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <!-- Same 38px artwork box everywhere; the mark is kept whole inside it. -->
        <Style x:Key="ArtBox" TargetType="Border">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="{StaticResource Components.ArtPlate}" />
            <Setter Property="BorderBrush" Value="{StaticResource Components.ArtLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="ArtImage" TargetType="Image">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Components.Muted}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Compatibility pill: 14px brand mark on a light plate plus a visible label. -->
        <Style x:Key="HardwarePill" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Components.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="3,1,5,1" />
            <Setter Property="Margin" Value="0,4,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Section link: left accent bar marks the section last jumped to. -->
        <Style x:Key="SectionLinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Components.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="LinkBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0,4,4,0"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                            <Border x:Name="FocusRing"
                                    CornerRadius="0,4,4,0"
                                    BorderBrush="{DynamicResource GameCenter.Focus}"
                                    BorderThickness="1"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="LinkBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#454545" />
                </Trigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Components.GoldSoft}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Components.Gold}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="AutomationProperties.ItemStatus" Value="Current section" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroller"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="14"
                  ScrollChanged="PageScroller_ScrollChanged">
        <StackPanel x:Name="PageContent"
                    SizeChanged="PageContent_SizeChanged">

            <!-- Hardware guidance and Hugging Face access span the page above the cards. -->
            <Grid x:Name="AccessGrid"
                  AutomationProperties.Name="Hardware and Hugging Face access">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="NvidiaTile"
                        Style="{StaticResource TileBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource ArtBox}"
                                VerticalAlignment="Center">
                            <Image Source="/DwemerDistro;component/Assets/nvidia.png"
                                   Style="{StaticResource ArtImage}" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="NVIDIA / CUDA"
                                       Foreground="{StaticResource Components.Text}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Install CUDA before enabling GPU-backed services."
                                       Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="AmdTile"
                        Grid.Column="2"
                        Style="{StaticResource TileBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource ArtBox}"
                                VerticalAlignment="Center">
                            <Image Source="/DwemerDistro;component/Assets/amd.png"
                                   Style="{StaticResource ArtImage}" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="AMD / CPU"
                                       Foreground="{StaticResource Components.Text}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Skip CUDA and use CPU mode where the service offers it."
                                       Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="HuggingFaceTile"
                        Grid.Row="2"
                        Grid.ColumnSpan="3"
                        Margin="0,8,0,0"
                        Style="{StaticResource TileBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource ArtBox}">
                            <Image Source="/DwemerDistro;component/Assets/huggingface.png"
                                   Style="{StaticResource ArtImage}" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Margin="10,0,12,0"
                                    VerticalAlignment="Center">
                            <WrapPanel>
                                <TextBlock Text="{Binding HuggingFaceAccessTitle}"
                                           Foreground="{StaticResource Components.Text}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center" />
                                <Border Background="{Binding HuggingFaceTokenStatusBackground}"
                                        CornerRadius="10"
                                        Padding="8,1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding HuggingFaceTokenStatusText}"
                                               Foreground="{Binding HuggingFaceTokenStatusForeground}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               AutomationProperties.LiveSetting="Polite" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="{Binding HuggingFaceAccessSummary}"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,3,0,0"
                                       Visibility="{Binding HasHuggingFaceAccessSummary, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Text="{Binding HuggingFaceTokenDetailText}"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,3,0,0"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <WrapPanel x:Name="HuggingFaceActions"
                                   Grid.Column="2"
                                   VerticalAlignment="Center">
                            <Button Content="Refresh"
                                    Command="{Binding RefreshHuggingFaceTokenCommand}"
                                    Style="{StaticResource CardQuietButton}"
                                    AutomationProperties.Name="Refresh Hugging Face status" />
                            <Button Content="{Binding HuggingFaceReplaceButtonText}"
                                    Click="EditHuggingFaceTokenButton_Click"
                                    Style="{StaticResource CardButton}"
                                    Margin="0,4,0,0" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Shown only when the installed-state probe could not run, so the page never
                     silently presents every card as not installed. -->
                <TextBlock Grid.Row="3"
                           Grid.ColumnSpan="3"
                           Text="{Binding ConfigurableComponentsStatusText}"
                           Foreground="{StaticResource Components.Warn}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="2,8,0,0"
                           AutomationProperties.LiveSetting="Polite"
                           Visibility="{Binding HasConfigurableComponentsStatus, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>

            <!-- Section links beside one continuous card page. Links only scroll and highlight;
                 every component stays listed. -->
            <Grid x:Name="BrowserGrid"
                  Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LinksColumn" Width="156" />
                    <ColumnDefinition x:Name="LinksGapColumn" Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ItemsControl x:Name="SectionLinks"
                              ItemsSource="{Binding Sections}"
                              VerticalAlignment="Top"
                              Focusable="False"
                              AutomationProperties.Name="Component sections">
                    <ItemsControl.RenderTransform>
                        <TranslateTransform x:Name="SectionLinksOffset" />
                    </ItemsControl.RenderTransform>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="{Binding SectionLinksOrientation, ElementName=ComponentsPage}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}"
                                    Style="{StaticResource SectionLinkButton}"
                                    Width="{Binding SectionLinkWidth, ElementName=ComponentsPage}"
                                    Click="SectionLink_Click"
                                    AutomationProperties.HelpText="Scroll to this section. All components stay listed." />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- One shared-size scope over all sections, so every card is as tall as the tallest
                     card at the current width and footers line up across the page. -->
                <ItemsControl x:Name="SectionList"
                              Grid.Column="2"
                              ItemsSource="{Binding Sections}"
                              Focusable="False"
                              Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,16">
                                <!-- Neutral bottom rule; the gold left bar and tint mark the current section. -->
                                <Border BorderBrush="{StaticResource Components.Line}"
                                        BorderThickness="0,0,0,1">
                                    <Border Padding="8,2,0,4"
                                            BorderThickness="2,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource Components.Gold}" />
                                                        <Setter Property="Background" Value="{StaticResource Components.GoldSoft}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{StaticResource Components.Gold}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   AutomationProperties.HeadingLevel="Level2" />
                                    </Border>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Items}"
                                              Focusable="False"
                                              Margin="-4,4,-4,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="{Binding CardColumns, ElementName=ComponentsPage}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="4"
                                                    Padding="10,8"
                                                    Background="{StaticResource Components.Raised}"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{StaticResource Components.Line}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusBackground}" Value="#7A2828">
                                                                <Setter Property="BorderBrush" Value="#8A4A4A" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" SharedSizeGroup="ComponentCard" />
                                                    </Grid.RowDefinitions>
                                                    <DockPanel LastChildFill="True">
                                                        <!-- Footer actions: Install first when missing; Reinstall last once installed. -->
                                                        <WrapPanel DockPanel.Dock="Bottom"
                                                                   Margin="0,4,0,0">
                                                            <Button Content="{Binding PrimaryButtonText}"
                                                                    Command="{Binding PrimaryCommand}"
                                                                    AutomationProperties.Name="{Binding Title, StringFormat=Install {0}}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource CardPrimaryButton}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <ItemsControl ItemsSource="{Binding Configurations}"
                                                                          Focusable="False">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Content="{Binding ConfigureButtonText}"
                                                                                Command="{Binding ConfigureCommand}"
                                                                                Style="{StaticResource CardButton}"
                                                                                AutomationProperties.Name="{Binding Title, StringFormat=Configure {0}}"
                                                                                AutomationProperties.HelpText="{Binding ConfigurationText}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button Content="{Binding SecondaryActionText}"
                                                                    Command="{Binding SecondaryActionCommand}"
                                                                    Style="{StaticResource CardQuietButton}"
                                                                    Visibility="{Binding HasSecondaryAction, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            <Button Content="{Binding TertiaryActionText}"
                                                                    Command="{Binding TertiaryActionCommand}"
                                                                    Style="{StaticResource CardQuietButton}"
                                                                    Visibility="{Binding HasTertiaryAction, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            <Button Content="{Binding PrimaryButtonText}"
                                                                    Command="{Binding PrimaryCommand}"
                                                                    AutomationProperties.Name="{Binding Title, StringFormat=Reinstall {0}}"
                                                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                    Style="{StaticResource CardQuietButton}" />
                                                        </WrapPanel>

                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Style="{StaticResource ArtBox}">
                                                                    <Image Source="{Binding ArtworkSource}"
                                                                           Style="{StaticResource ArtImage}" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1"
                                                                            Margin="8,0,0,0">
                                                                    <TextBlock Text="{Binding Title}"
                                                                               Foreground="{StaticResource Components.Text}"
                                                                               FontSize="13"
                                                                               FontWeight="SemiBold"
                                                                               TextWrapping="Wrap"
                                                                               AutomationProperties.HeadingLevel="Level3" />
                                                                    <StackPanel Orientation="Horizontal"
                                                                                Margin="0,2,0,0">
                                                                        <Ellipse x:Name="StatusDot"
                                                                                 Width="7"
                                                                                 Height="7"
                                                                                 Margin="0,1,6,0"
                                                                                 VerticalAlignment="Center"
                                                                                 StrokeThickness="1.5"
                                                                                 Stroke="{Binding Foreground, ElementName=StatusLabel}">
                                                                            <Ellipse.Style>
                                                                                <!-- Hollow dot for not installed, so state never relies on color alone. -->
                                                                                <Style TargetType="Ellipse">
                                                                                    <Setter Property="Fill" Value="{Binding Stroke, RelativeSource={RelativeSource Self}}" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding StatusText}" Value="Not installed">
                                                                                            <Setter Property="Fill" Value="Transparent" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Ellipse.Style>
                                                                        </Ellipse>
                                                                        <TextBlock x:Name="StatusLabel"
                                                                                   Text="{Binding StatusText}"
                                                                                   FontSize="12"
                                                                                   TextWrapping="Wrap"
                                                                                   AutomationProperties.LiveSetting="Polite">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="{StaticResource Components.Off}" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding StatusBackground}" Value="#285A2D">
                                                                                            <Setter Property="Foreground" Value="{StaticResource Components.Ok}" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding StatusBackground}" Value="#6A3A12">
                                                                                            <Setter Property="Foreground" Value="{StaticResource Components.Warn}" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding StatusBackground}" Value="#7A2828">
                                                                                            <Setter Property="Foreground" Value="{StaticResource Components.Bad}" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding StatusText}" Value="Not installed">
                                                                                            <Setter Property="Foreground" Value="{StaticResource Components.Off}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Grid>

                                                            <TextBlock Text="{Binding Description}"
                                                                       Style="{StaticResource MutedText}"
                                                                       Margin="0,4,0,0" />

                                                            <ItemsControl ItemsSource="{Binding Details}"
                                                                          Focusable="False"
                                                                          Margin="0,2,0,0"
                                                                          Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="10" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="·"
                                                                                       Foreground="{StaticResource Components.Gold}"
                                                                                       FontSize="12"
                                                                                       FontWeight="Bold"
                                                                                       Margin="2,0,0,0" />
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding}"
                                                                                       Style="{StaticResource MutedText}" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!-- Live configuration from the component's own conf.sh probe. -->
                                                            <ItemsControl ItemsSource="{Binding Configurations}"
                                                                          Focusable="False"
                                                                          Margin="0,4,0,0"
                                                                          Visibility="{Binding HasConfiguration, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock FontSize="12"
                                                                                   TextWrapping="Wrap"
                                                                                   Foreground="{StaticResource Components.Text}">
                                                                            <Run Text="{Binding ConfigurationLabel, Mode=OneWay}"
                                                                                 Foreground="{StaticResource Components.Muted}"
                                                                                 FontWeight="SemiBold" />
                                                                            <Run Text="{Binding ConfigurationText, Mode=OneWay}" />
                                                                        </TextBlock>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <TextBlock Text="{Binding StatusDetailText}"
                                                                       Margin="0,4,0,0"
                                                                       Visibility="{Binding ShowsStatusDetail, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding StatusBackground}" Value="#7A2828">
                                                                                <Setter Property="Foreground" Value="{StaticResource Components.Bad}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <TextBlock Text="{Binding ConnectorStatusText}"
                                                                       Foreground="#FFD27A"
                                                                       FontSize="12"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,4,0,0"
                                                                       AutomationProperties.Name="{Binding ConnectorStatusText}"
                                                                       AutomationProperties.LiveSetting="Polite"
                                                                       Visibility="{Binding HasConnectorStatus, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                            <WrapPanel Margin="0,2,0,0">
                                                                <Border Style="{StaticResource HardwarePill}"
                                                                        Visibility="{Binding SupportsNvidiaCuda, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Border Background="{StaticResource Components.ArtPlate}"
                                                                                CornerRadius="2"
                                                                                Padding="1"
                                                                                Margin="0,0,4,0"
                                                                                VerticalAlignment="Center">
                                                                            <Image Source="/DwemerDistro;component/Assets/nvidia.png"
                                                                                   Width="12"
                                                                                   Height="12"
                                                                                   Stretch="Uniform"
                                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                                        </Border>
                                                                        <TextBlock Text="NVIDIA"
                                                                                   Foreground="{StaticResource Components.Muted}"
                                                                                   FontSize="11"
                                                                                   VerticalAlignment="Center"
                                                                                   AutomationProperties.Name="Works with NVIDIA" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border Style="{StaticResource HardwarePill}"
                                                                        Visibility="{Binding SupportsAmdCpu, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Border Background="{StaticResource Components.ArtPlate}"
                                                                                CornerRadius="2"
                                                                                Padding="1"
                                                                                Margin="0,0,4,0"
                                                                                VerticalAlignment="Center">
                                                                            <Image Source="/DwemerDistro;component/Assets/amd.png"
                                                                                   Width="12"
                                                                                   Height="12"
                                                                                   Stretch="Uniform"
                                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                                        </Border>
                                                                        <TextBlock Text="AMD / CPU"
                                                                                   Foreground="{StaticResource Components.Muted}"
                                                                                   FontSize="11"
                                                                                   VerticalAlignment="Center"
                                                                                   AutomationProperties.Name="Works with AMD / CPU" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <TextBlock Text="{Binding PortText}"
                                                                           Foreground="{StaticResource Components.Muted}"
                                                                           FontSize="11"
                                                                           Margin="2,4,0,0"
                                                                           VerticalAlignment="Center"
                                                                           Visibility="{Binding HasPort, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
