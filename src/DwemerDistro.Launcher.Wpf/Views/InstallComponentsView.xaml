<UserControl x:Class="DwemerDistro.Launcher.Wpf.Views.InstallComponentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#2C2C2C"
             Loaded="InstallComponentsView_Loaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- Burgundy action. Rounded 8px corners plus a 1px border match the shared
             GameCenter button tiers so the embedded page reads as one launcher.
             Hover, pressed, and disabled colors live in Style.Triggers so the gray
             tiers below can restate them without duplicating the template. -->
        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="Background" Value="#5E0505" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#8C1C1C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontFamily" Value="Trebuchet MS" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="ButtonContent"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                            <Border x:Name="FocusRing"
                                    Margin="2"
                                    CornerRadius="6"
                                    BorderBrush="White"
                                    BorderThickness="1"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False"
                                    SnapsToDevicePixels="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonContent" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4A0404" />
                    <Setter Property="BorderBrush" Value="#C9A227" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#3F0303" />
                    <Setter Property="BorderBrush" Value="#FFD700" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Install / Reinstall keeps its distinctive pill shape and content-driven fills. -->
        <Style x:Key="InstallActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
            <Setter Property="Background" Value="#2F8F3A" />
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Content" Value="Reinstall">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#5E0505" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#256F2E" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Content" Value="Reinstall" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#4A0404" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Hold the pill on its own fill; the template above owns every state color. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2F8F3A" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2F8F3A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Gray tiers: same rounded bordered shell, charcoal fill. -->
        <Style x:Key="SecondaryActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryActionButton}">
            <Setter Property="Background" Value="#404040" />
            <Setter Property="BorderBrush" Value="#747474" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4C4C4C" />
                    <Setter Property="BorderBrush" Value="#C9A227" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#333333" />
                    <Setter Property="BorderBrush" Value="#FFD700" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompactActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryActionButton}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="86" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFD700" />
            <Setter Property="FontFamily" Value="Trebuchet MS" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="14">
        <StackPanel>
        <Border Margin="0,0,0,12"
                Padding="14"
                Background="#1E1E1E"
                BorderBrush="#565656"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
            <Border Background="#252525"
                    BorderBrush="#565656"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Background="#263827"
                            BorderBrush="#565656"
                            BorderThickness="0,0,1,1"
                            Padding="10,8">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Image Source="/Assets/nvidia.png"
                                   Width="18"
                                   Height="18"
                                   Stretch="Uniform"
                                   Margin="0,0,8,0" />
                            <TextBlock Text="NVIDIA / CUDA"
                                       Foreground="#CFEFCF"
                                       FontFamily="Trebuchet MS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Background="#3A3224"
                            BorderBrush="#565656"
                            BorderThickness="0,0,0,1"
                            Padding="10,8">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Image Source="/Assets/amd.png"
                                   Width="18"
                                   Height="18"
                                   Stretch="Uniform"
                                   Margin="0,0,8,0" />
                            <TextBlock Text="AMD / CPU"
                                       Foreground="#F4D8A6"
                                       FontFamily="Trebuchet MS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.Column="0"
                            BorderBrush="#565656"
                            BorderThickness="0,0,1,0"
                            Padding="10,8">
                        <TextBlock Text="Install CUDA before enabling GPU-backed services."
                                   Foreground="#DDDDDD"
                                   FontFamily="Trebuchet MS"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border Grid.Row="1"
                            Grid.Column="1"
                            BorderBrush="#565656"
                            BorderThickness="0,0,0,0"
                            Padding="10,8">
                        <TextBlock Text="Skip CUDA and use CPU mode where the service offers it."
                                   Foreground="#DDDDDD"
                                   FontFamily="Trebuchet MS"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>

            <Border Margin="0,10,0,0"
                    Padding="12"
                    Background="#252525"
                    BorderBrush="#565656"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Image Source="/Assets/huggingface.png"
                                   Width="18"
                                   Height="18"
                                   Stretch="Uniform"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="{Binding HuggingFaceAccessTitle}"
                                       Foreground="White"
                                       FontFamily="Trebuchet MS"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <Border Background="{Binding HuggingFaceTokenStatusBackground}"
                                    CornerRadius="12"
                                    Padding="10,4"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding HuggingFaceTokenStatusText}"
                                           Foreground="{Binding HuggingFaceTokenStatusForeground}"
                                           FontFamily="Trebuchet MS"
                                           FontSize="11"
                                           FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding HuggingFaceAccessSummary}"
                                   Foreground="#DDDDDD"
                                   FontFamily="Trebuchet MS"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0"
                                   Visibility="{Binding HasHuggingFaceAccessSummary, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="{Binding HuggingFaceTokenDetailText}"
                                   Foreground="#DDDDDD"
                                   FontFamily="Trebuchet MS"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="Refresh"
                                Command="{Binding RefreshHuggingFaceTokenCommand}"
                                Style="{StaticResource CompactActionButton}" />
                        <Button Content="{Binding HuggingFaceReplaceButtonText}"
                                Click="EditHuggingFaceTokenButton_Click"
                                Style="{StaticResource CompactActionButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Margin="0,10,0,0"
                    Padding="12"
                    Background="#252525"
                    BorderBrush="#565656"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Installed Components"
                                   Foreground="White"
                                   FontFamily="Trebuchet MS"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="Refresh"
                                Command="{Binding RefreshComponentsCommand}"
                                Style="{StaticResource CompactActionButton}"
                                VerticalAlignment="Center" />
                    </Grid>

                    <Border Background="#1E1E1E"
                            BorderBrush="#4B4B4B"
                            BorderThickness="1"
                            Padding="10,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="105" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Component"
                                       Foreground="#FFD700"
                                       FontFamily="Trebuchet MS"
                                       FontSize="11"
                                       FontWeight="Bold" />
                            <TextBlock Grid.Column="1"
                                       Text="Current configuration"
                                       Foreground="#FFD700"
                                       FontFamily="Trebuchet MS"
                                       FontSize="11"
                                       FontWeight="Bold" />
                            <TextBlock Grid.Column="2"
                                       Text="Action"
                                       Foreground="#FFD700"
                                       FontFamily="Trebuchet MS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding ConfigurableComponents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#444444"
                                        BorderThickness="1,0,1,1"
                                        Padding="10,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="230" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="105" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,12,0">
                                            <Viewbox Width="16"
                                                     Height="16"
                                                     Margin="0,0,8,0">
                                                <Canvas Width="16"
                                                        Height="16">
                                                    <Ellipse Width="14"
                                                             Height="14"
                                                             Canvas.Left="1"
                                                             Canvas.Top="1"
                                                             Stroke="#61C46A"
                                                             StrokeThickness="1.4" />
                                                    <Path Data="M 3.5 8 L 6.5 11 L 12.5 5"
                                                          Stroke="#61C46A"
                                                          StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="White"
                                                       FontFamily="Trebuchet MS"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ConfigurationText}"
                                                   Foreground="#D6D6D6"
                                                   FontFamily="Trebuchet MS"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0" />

                                        <Button Grid.Column="2"
                                                Content="{Binding ConfigureButtonText}"
                                                Command="{Binding ConfigureCommand}"
                                                Style="{StaticResource CompactActionButton}"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding ConfigurableComponentsStatusText}"
                               Foreground="#BDBDBD"
                               FontFamily="Trebuchet MS"
                               FontSize="12"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,12,0,2"
                               Visibility="{Binding HasConfigurableComponentsStatus, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>
            </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Sections}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}"
                                   Style="{StaticResource SectionHeader}" />

                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12"
                                            Padding="14"
                                            Background="#262626"
                                            BorderBrush="#565656"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                            Margin="0,0,16,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="White"
                                                                   FontFamily="Trebuchet MS"
                                                                   FontSize="15"
                                                                   FontWeight="Bold"
                                                                   VerticalAlignment="Center" />
                                                        <Image Source="/Assets/nvidia.png"
                                                               Width="14"
                                                               Height="14"
                                                               Stretch="Uniform"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding SupportsNvidiaCuda, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <Image Source="/Assets/amd.png"
                                                               Width="14"
                                                               Height="14"
                                                               Stretch="Uniform"
                                                               Margin="6,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding SupportsAmdCpu, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}"
                                                               Foreground="#DDDDDD"
                                                               FontFamily="Trebuchet MS"
                                                               TextWrapping="Wrap"
                                                               Margin="0,6,0,0" />
                                                </StackPanel>

                                                <Border Grid.Column="1"
                                                        Background="{Binding StatusBackground}"
                                                        CornerRadius="12"
                                                        Padding="10,4"
                                                        VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               Foreground="{Binding StatusForeground}"
                                                               FontFamily="Trebuchet MS"
                                                               FontSize="11"
                                                               FontWeight="Bold" />
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Row="1"
                                                        Margin="0,14,0,0">
                                                <Button Content="{Binding PrimaryButtonText}"
                                                        Command="{Binding PrimaryCommand}"
                                                        Style="{StaticResource InstallActionButton}"
                                                        HorizontalAlignment="Left" />
                                                <Button Content="{Binding SecondaryActionText}"
                                                        Command="{Binding SecondaryActionCommand}"
                                                        Style="{StaticResource SecondaryActionButton}"
                                                        HorizontalAlignment="Left"
                                                        Visibility="{Binding HasSecondaryAction, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <Button Content="{Binding TertiaryActionText}"
                                                        Command="{Binding TertiaryActionCommand}"
                                                        Style="{StaticResource SecondaryActionButton}"
                                                        HorizontalAlignment="Left"
                                                        Visibility="{Binding HasTertiaryAction, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
