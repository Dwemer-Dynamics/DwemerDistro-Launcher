<Window x:Class="DwemerDistro.Launcher.Wpf.Views.ServerUninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstall Server"
        Icon="/Assets/DwemerDistro.ico"
        Width="640"
        SizeToContent="Height"
        MinHeight="520"
        MaxHeight="760"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GameCenter.Window}"
        TextElement.Foreground="{DynamicResource GameCenter.Text}"
        FocusManager.FocusedElement="{Binding ElementName=ConfirmTokenTextBox}"
        AutomationProperties.Name="Uninstall server confirmation"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="DialogBodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
            <Setter Property="FontFamily" Value="Trebuchet MS" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DialogCaptionText" TargetType="TextBlock" BasedOn="{StaticResource DialogBodyText}">
            <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="HeadingTextBlock"
                       Text="Uninstall server"
                       FontFamily="Trebuchet MS"
                       FontSize="18"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource GameCenter.DangerText}" />
            <TextBlock x:Name="SubheadingTextBlock"
                       Style="{StaticResource DialogCaptionText}"
                       Margin="0,6,0,0"
                       Text="This permanently deletes this server and everything it stores." />
        </StackPanel>

        <!-- Exact targets, so the user can confirm they are purging the server they meant. -->
        <Border Grid.Row="1"
                Style="{StaticResource GameCenter.Card}"
                Padding="14"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="WILL BE DELETED"
                           Style="{StaticResource GameCenter.SectionHeading}"
                           Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Server" Style="{StaticResource DialogCaptionText}" Margin="0,0,10,4" />
                    <TextBlock x:Name="ServerNameTextBlock" Grid.Row="0" Grid.Column="1"
                               Style="{StaticResource DialogBodyText}" FontWeight="Bold" Margin="0,0,0,4" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Files" Style="{StaticResource DialogCaptionText}" Margin="0,0,10,4" />
                    <TextBlock x:Name="RootPathTextBlock" Grid.Row="1" Grid.Column="1"
                               Style="{StaticResource DialogBodyText}" FontFamily="Consolas" Margin="0,0,0,4" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Database" Style="{StaticResource DialogCaptionText}" Margin="0,0,10,0" />
                    <TextBlock x:Name="DatabaseTextBlock" Grid.Row="2" Grid.Column="1"
                               Style="{StaticResource DialogBodyText}" FontFamily="Consolas" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource GameCenter.Panel}"
                BorderBrush="{DynamicResource GameCenter.Danger}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="14"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Permanently removed"
                           Style="{StaticResource GameCenter.SectionHeading}"
                           Foreground="{DynamicResource GameCenter.DangerText}"
                           Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource DialogBodyText}"
                           Text="Character profiles, memories, settings, logs, uploads, voices, and all database data for this server are deleted. This cannot be undone and there is no launcher backup of it." />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock x:Name="ConfirmPromptTextBlock"
                       Style="{StaticResource DialogBodyText}"
                       Margin="0,0,0,6" />
            <TextBox x:Name="ConfirmTokenTextBox"
                     Height="34"
                     VerticalContentAlignment="Center"
                     Padding="10,0"
                     FontFamily="Consolas"
                     FontSize="13"
                     Background="#191919"
                     Foreground="{DynamicResource GameCenter.Text}"
                     CaretBrush="{DynamicResource GameCenter.Text}"
                     BorderBrush="{DynamicResource GameCenter.Border}"
                     BorderThickness="1"
                     AutomationProperties.LabeledBy="{Binding ElementName=ConfirmPromptTextBlock}"
                     TextChanged="ConfirmTokenTextBox_TextChanged" />
            <TextBlock x:Name="ValidationTextBlock"
                       Style="{StaticResource DialogCaptionText}"
                       Height="30"
                       Margin="0,6,0,0"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <TextBlock x:Name="BusyTextBlock"
                   Grid.Row="4"
                   Style="{StaticResource DialogCaptionText}"
                   Height="20"
                   Margin="0,0,0,8"
                   AutomationProperties.LiveSetting="Polite" />

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Content="Cancel"
                    IsCancel="True"
                    MinWidth="120"
                    MinHeight="36"
                    Margin="0,0,10,0"
                    Style="{StaticResource GameCenter.Button}"
                    Click="CancelButton_Click"
                    AutomationProperties.Name="Cancel uninstall"
                    AutomationProperties.HelpText="Close this dialog without deleting anything." />
            <Button x:Name="UninstallButton"
                    Grid.Column="2"
                    Content="Uninstall Server"
                    IsEnabled="False"
                    MinWidth="176"
                    MinHeight="36"
                    Style="{StaticResource GameCenter.ServerUninstallButton}"
                    Click="UninstallButton_Click" />
        </Grid>
    </Grid>
</Window>
