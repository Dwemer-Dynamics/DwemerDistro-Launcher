<UserControl x:Class="DwemerDistro.Launcher.Wpf.Views.CommunityModDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource GameCenter.Window}" Foreground="{DynamicResource GameCenter.Text}">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="{DynamicResource GameCenter.Panel}" />
            <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
            <Setter Property="CaretBrush" Value="{DynamicResource GameCenter.Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.Border}" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource GameCenter.Button}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,5" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Button x:Name="BackButton" Content="← Browse mods" HorizontalAlignment="Left" Margin="0,0,0,12"
                Click="Back_Click" AutomationProperties.Name="Back to mod grid" />
        <Expander x:Name="RepositoryEditor" Grid.Row="1" Header="Repository URL" Margin="0,0,0,12"
                  Foreground="{DynamicResource GameCenter.Text}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox x:Name="RepositoryBox" AutomationProperties.Name="GitHub repository URL"
                         TextChanged="Repository_Changed" KeyDown="Repository_KeyDown" Margin="0,8,0,0" />
                <Button x:Name="CheckButton" Grid.Column="1" Content="Check release" Margin="8,8,0,0" Click="Check_Click" />
            </Grid>
        </Expander>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,8,0">
                <StackPanel>
                    <Border Background="{DynamicResource GameCenter.Panel}" Height="180" ClipToBounds="True">
                        <Grid>
                            <Image Source="../Assets/DwemerDistro.png" Width="56" Height="56" Opacity="0.2" />
                            <Image x:Name="BannerImage" Stretch="Uniform" AutomationProperties.Name="Mod banner" />
                        </Grid>
                    </Border>
                    <Grid Margin="0,16,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Image x:Name="IconImage" Width="32" Height="32" Stretch="Uniform" Margin="0,0,10,0" AutomationProperties.Name="Mod icon" />
                        <TextBlock x:Name="ModTitle" Grid.Column="1" Text="Add a mod" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="AuthorText" Foreground="{DynamicResource GameCenter.TextMuted}" FontSize="12" />
                    <TextBlock x:Name="DescriptionText" Text="Paste a repository URL to preview its published mod." Margin="0,16,0,12" FontSize="14" />
                    <ItemsControl x:Name="FeatureList" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,0,0,6" FontSize="12" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="SourceButton" Content="Repository ↗" HorizontalAlignment="Left" IsEnabled="False" Click="Source_Click" />
                    <Expander Header="Compatibility and testing" Foreground="{DynamicResource GameCenter.Text}" Margin="0,16,0,12">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock x:Name="CompatibilityText" FontSize="12" Foreground="{DynamicResource GameCenter.TextMuted}" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="NotesButton" Content="Release notes" IsEnabled="False" Margin="0,0,6,6" Click="Notes_Click" />
                                <Button x:Name="EvidenceButton" Content="Test evidence" IsEnabled="False" Margin="0,0,0,6" Click="Evidence_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="2" Style="{StaticResource GameCenter.Card}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="Install mod" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="ReleaseText" Margin="0,6,0,18" Foreground="{DynamicResource GameCenter.TextMuted}" FontSize="12" />
                            <TextBlock Text="Game folder" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="GameFolderBox" AutomationProperties.Name="Game installation folder" />
                                <Button x:Name="FolderButton" Grid.Column="1" Content="…" Width="34" Padding="0" Margin="6,0,0,0" Click="Folder_Click" AutomationProperties.Name="Choose game folder" />
                            </Grid>
                            <TextBlock x:Name="InstallPlanText" Margin="0,14,0,12" FontSize="12" Foreground="{DynamicResource GameCenter.TextMuted}" />
                            <TextBlock x:Name="EnableInGameText" Margin="0,0,0,12" FontSize="12" />
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1">
                        <CheckBox x:Name="TrustBox" Content="I trust this author and reviewed the install plan."
                                  Foreground="{DynamicResource GameCenter.Text}" Margin="0,12,0,12">
                            <CheckBox.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></CheckBox.ContentTemplate>
                        </CheckBox>
                        <Button x:Name="InstallButton" Content="Install / update" Style="{StaticResource GameCenter.PrimaryButton}"
                                IsEnabled="False" Click="Install_Click" Height="42" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <ProgressBar x:Name="BusyProgress" Height="3" Margin="0,0,0,6" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource GameCenter.TextMuted}"
                       AutomationProperties.Name="Community mod status" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Grid>
</UserControl>
