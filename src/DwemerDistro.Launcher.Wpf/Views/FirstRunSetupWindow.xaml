<Window x:Class="DwemerDistro.Launcher.Wpf.Views.FirstRunSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DwemerDistro Quickstart"
        Icon="/Assets/DwemerDistro.ico"
        Width="820"
        Height="680"
        MinWidth="760"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#2C2C2C"
        TextElement.Foreground="White">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#5E0505" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#7A2828" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontFamily" Value="Trebuchet MS" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#2F8F3A" />
            <Setter Property="BorderBrush" Value="#4FA45B" />
            <Setter Property="MinWidth" Value="168" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#404040" />
            <Setter Property="BorderBrush" Value="#565656" />
            <Setter Property="MinWidth" Value="96" />
        </Style>

        <Style x:Key="LargePrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinWidth" Value="220" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="18,12" />
        </Style>

        <Style x:Key="LargeSkipButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#404040" />
            <Setter Property="BorderBrush" Value="#565656" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="16,10" />
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#1E1E1E" />
            <Setter Property="BorderBrush" Value="#565656" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="DetailPanel" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Background" Value="#262626" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Trebuchet MS" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#191919" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="SelectionBrush" Value="#5E0505" />
            <Setter Property="BorderBrush" Value="#565656" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#191919" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="SelectionBrush" Value="#5E0505" />
            <Setter Property="BorderBrush" Value="#565656" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Oversized tick box for the Choose Your Mods rows: a 28px target on the left of each
             card, with a visible keyboard focus ring and the same palette as the rest of the wizard. -->
        <Style x:Key="LargeProductCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="34" Height="34" Background="Transparent">
                            <Border x:Name="Box"
                                    Width="28"
                                    Height="28"
                                    CornerRadius="5"
                                    Background="#191919"
                                    BorderBrush="#7A7A7A"
                                    BorderThickness="2"
                                    SnapsToDevicePixels="True" />
                            <Path x:Name="Tick"
                                  Data="M 6,14 L 12,20 L 22,8"
                                  Stroke="White"
                                  StrokeThickness="3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed" />
                            <Border x:Name="FocusRing"
                                    CornerRadius="7"
                                    BorderBrush="White"
                                    BorderThickness="1"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#2F8F3A" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#4FA45B" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FFD700" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.45" />
                                <Setter TargetName="Tick" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#191919" />
            <Setter Property="Foreground" Value="#2F8F3A" />
            <Setter Property="BorderBrush" Value="#565656" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="12" />
        </Style>

    </Window.Resources>

    <DockPanel Margin="14">
        <Border DockPanel.Dock="Top"
                Style="{StaticResource Panel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Source="/Assets/DwemerDistro.png"
                       Width="42"
                       Height="42"
                       Stretch="Uniform"
                       Margin="0,0,12,0" />

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock Text="DwemerDistro Quickstart"
                               FontSize="18"
                               FontWeight="Bold" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <Border Background="#404040"
                            CornerRadius="12"
                            Padding="10,4"
                            HorizontalAlignment="Right">
                        <TextBlock Text="{Binding CurrentStepLabel}"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="Bold" />
                    </Border>
                    <Border Background="#3A3224"
                            CornerRadius="12"
                            Padding="10,4"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Right"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding BusyText}"
                                   Foreground="#F4D8A6"
                                   FontSize="11"
                                   FontWeight="Bold" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Style="{StaticResource Panel}"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Back"
                        Command="{Binding BackCommand}"
                        Style="{StaticResource SecondaryButton}" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <Button Content="{Binding PrimaryContinueText}"
                            Command="{Binding ContinueCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Visibility="{Binding ShowContinueButton, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel Visibility="{Binding IsSetupIntroStep, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Style="{StaticResource Panel}">
                        <StackPanel Margin="0,10,0,8">
                            <TextBlock Text="Quick Setup"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Update distro, install the required services, then start the server."
                                       Foreground="#D6D6D6"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="520"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0" />

                            <Border Background="#252525"
                                    BorderBrush="#6A3A12"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,9"
                                    Margin="0,16,0,0"
                                    MaxWidth="540"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding ShowAmdCpuModeNote, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="AMD GPU path installs services in CPU mode because CUDA is NVIDIA-only."
                                           Foreground="#F4D8A6"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center" />
                            </Border>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0,24,0,0">
                                <Button Content="Start Quick Setup"
                                        Command="{Binding ContinueCommand}"
                                        Style="{StaticResource LargePrimaryButton}"
                                        Margin="0,0,10,0" />
                                <Button Content="Skip Quick Setup"
                                        Command="{Binding SkipRecommendedSetupCommand}"
                                        Style="{StaticResource LargeSkipButton}"
                                        Margin="0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Visibility="{Binding IsUpdateDistroStep, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Style="{StaticResource Panel}">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="{Binding StepTitle}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,14,0,0">
                                <Button Content="Update Distro"
                                        Command="{Binding UpdateDistroCommand}"
                                        Style="{StaticResource LargePrimaryButton}" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsInstallingSetup, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Margin="0,12,0,0">
                                <TextBlock Text="{Binding SetupInstallProgressText}"
                                           Foreground="#D6D6D6"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar Grid.Column="0"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding SetupInstallProgress, Mode=OneWay}" />
                                    <Viewbox Grid.Column="1"
                                             Width="18"
                                             Height="18"
                                             Margin="9,0,0,0"
                                             VerticalAlignment="Center">
                                        <Canvas Width="20"
                                                Height="20"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Canvas.RenderTransform>
                                                <RotateTransform x:Name="UpdateSpinnerRotate" />
                                            </Canvas.RenderTransform>
                                            <Canvas.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetName="UpdateSpinnerRotate"
                                                                             Storyboard.TargetProperty="Angle"
                                                                             From="0"
                                                                             To="360"
                                                                             Duration="0:0:0.9" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Canvas.Triggers>
                                            <Ellipse Width="16"
                                                     Height="16"
                                                     Canvas.Left="2"
                                                     Canvas.Top="2"
                                                     Stroke="#2F8F3A"
                                                     StrokeThickness="2"
                                                     Opacity="0.28" />
                                            <Path Data="M 10,2 A 8,8 0 0 1 18,10"
                                                  Stroke="#CFEFCF"
                                                  StrokeThickness="2.4"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                                <TextBlock Text="{Binding SetupInstallDetailText}"
                                           Foreground="#F4D8A6"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding HasSetupInstallDetail, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                            <TextBlock Text="Console"
                                       Foreground="#FFD700"
                                       FontWeight="Bold"
                                       Margin="0,18,0,8" />
                            <TextBox Text="{Binding SetupLogText, Mode=OneWay}"
                                     Height="130"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Visibility="{Binding IsChooseModsStep, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Style="{StaticResource Panel}">
                        <StackPanel Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding StepTitle}"
                                           FontSize="20"
                                           FontWeight="Bold" />
                                <Border Grid.Column="1"
                                        Background="{Binding ProductStatusBackground}"
                                        CornerRadius="12"
                                        Padding="10,4"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProductStatusText}"
                                               FontSize="11"
                                               FontWeight="Bold" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding StepSubtitle}"
                                       Foreground="#D6D6D6"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <TextBlock Text="Nothing is selected to start with. Continue without picking anything if you would rather decide later."
                                       Foreground="#D6D6D6"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />

                            <!-- The whole list is disabled while an install runs, so a checkbox cannot
                                 change under a running operation. -->
                            <ItemsControl ItemsSource="{Binding ProductChoices}"
                                          IsEnabled="{Binding IsProductSelectionEnabled}"
                                          Margin="0,14,0,0"
                                          KeyboardNavigation.TabNavigation="Continue"
                                          AutomationProperties.Name="Available mods">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#262626"
                                                BorderBrush="#4B4B4B"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12,10"
                                                Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0"
                                                          Style="{StaticResource LargeProductCheckBox}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          IsEnabled="{Binding IsSelectable}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,12,0"
                                                          AutomationProperties.Name="{Binding AccessibleName}"
                                                          AutomationProperties.HelpText="{Binding AccessibleHelpText}"
                                                          ToolTip="{Binding AccessibleHelpText}" />

                                                <Border Grid.Column="1"
                                                        Width="104"
                                                        Height="58"
                                                        Margin="0,0,12,0"
                                                        Background="#151515"
                                                        ClipToBounds="True">
                                                    <!-- Stretch alignment degenerates to top-left once UniformToFill
                                                         overflows the slot, so the crop is anchored explicitly to the
                                                         center of the artwork on both axes. Setting Width/Height here
                                                         would re-anchor it top-left via the layout clip. -->
                                                    <Image Source="{Binding ArtworkSource}"
                                                           Stretch="UniformToFill"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           AutomationProperties.Name="{Binding Title, StringFormat={}{0} artwork}" />
                                                </Border>

                                                <StackPanel Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="14"
                                                               FontWeight="Bold" />
                                                    <TextBlock Text="{Binding GameTitle}"
                                                               Foreground="#FFD700"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding ResultDetail}"
                                                               Foreground="#D79C9C"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Margin="0,4,0,0"
                                                               Visibility="{Binding HasResultDetail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="3"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Right">
                                                    <Border Background="{Binding StatusBackground}"
                                                            CornerRadius="12"
                                                            Padding="10,4"
                                                            HorizontalAlignment="Right"
                                                            MinWidth="88">
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   TextAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Right"
                                                                Margin="0,8,0,0"
                                                                Visibility="{Binding ShowRetry, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Button Content="Retry"
                                                                Command="{Binding RetryCommand}"
                                                                Style="{StaticResource SecondaryButton}"
                                                                MinWidth="80"
                                                                Margin="0,0,8,0"
                                                                AutomationProperties.Name="{Binding Title, StringFormat=Retry installing {0}}" />
                                                        <Button Content="Skip"
                                                                Command="{Binding SkipCommand}"
                                                                Style="{StaticResource SecondaryButton}"
                                                                MinWidth="80"
                                                                Margin="0"
                                                                AutomationProperties.Name="{Binding Title, StringFormat=Skip {0} and continue}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,6,0,0">
                                <Button Content="{Binding InstallProductsButtonText}"
                                        Command="{Binding InstallSelectedProductsCommand}"
                                        Style="{StaticResource LargePrimaryButton}"
                                        AutomationProperties.Name="Install selected mods"
                                        AutomationProperties.HelpText="Installs each selected mod in turn on the Main branch. Mods that installed successfully stay installed if a later one fails." />
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsInstallingProducts, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Margin="0,12,0,0">
                                <TextBlock Text="{Binding SetupInstallProgressText}"
                                           Foreground="#D6D6D6"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Margin="0,0,0,6"
                                           AutomationProperties.LiveSetting="Polite" />
                                <ProgressBar Minimum="0"
                                             Maximum="100"
                                             Value="{Binding SetupInstallProgress, Mode=OneWay}"
                                             AutomationProperties.Name="Mod install progress" />
                            </StackPanel>

                            <TextBlock Text="Console"
                                       Foreground="#FFD700"
                                       FontWeight="Bold"
                                       Margin="0,18,0,8" />
                            <TextBox Text="{Binding SetupLogText, Mode=OneWay}"
                                     Height="120"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Mod install output" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Visibility="{Binding IsSetupStep, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Style="{StaticResource Panel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,16,0">
                                <TextBlock Text="{Binding StepTitle}"
                                           FontSize="20"
                                           FontWeight="Bold" />
                                <Border Background="#262626"
                                        BorderBrush="#4B4B4B"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10"
                                        Margin="0,12,0,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Component"
                                                       Foreground="#FFD700"
                                                       FontSize="11"
                                                       FontWeight="Bold" />
                                            <TextBlock Grid.Column="1"
                                                       Text="Status"
                                                       Foreground="#FFD700"
                                                       FontSize="11"
                                                       FontWeight="Bold" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding SetupComponents}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Title}"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Margin="0,0,10,0" />
                                                        <Viewbox Grid.Column="1"
                                                                 Width="22"
                                                                 Height="22"
                                                                 VerticalAlignment="Center"
                                                                 ToolTip="{Binding StatusToolTip}">
                                                            <Canvas Width="20"
                                                                    Height="20">
                                                                <Ellipse Width="18"
                                                                         Height="18"
                                                                         Canvas.Left="1"
                                                                         Canvas.Top="1"
                                                                         Stroke="{Binding StatusIconColor}"
                                                                         StrokeThickness="1.5" />
                                                                <Path Data="{Binding StatusIconData}"
                                                                      Stroke="{Binding StatusIconColor}"
                                                                      StrokeThickness="2.2"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      StrokeLineJoin="Round" />
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,18,0,0">
                                    <Button Content="{Binding InstallRecommendedButtonText}"
                                            Command="{Binding InstallRecommendedCommand}"
                                            Style="{StaticResource LargePrimaryButton}" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsInstallingSetup, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Margin="0,12,0,0">
                                    <TextBlock Text="{Binding SetupInstallProgressText}"
                                               Foreground="#D6D6D6"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Margin="0,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Grid.Column="0"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding SetupInstallProgress, Mode=OneWay}" />
                                        <Viewbox Grid.Column="1"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="9,0,0,0"
                                                 VerticalAlignment="Center">
                                            <Canvas Width="20"
                                                    Height="20"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Canvas.RenderTransform>
                                                    <RotateTransform x:Name="SetupSpinnerRotate" />
                                                </Canvas.RenderTransform>
                                                <Canvas.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetName="SetupSpinnerRotate"
                                                                                 Storyboard.TargetProperty="Angle"
                                                                                 From="0"
                                                                                 To="360"
                                                                                 Duration="0:0:0.9" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Canvas.Triggers>
                                                <Ellipse Width="16"
                                                         Height="16"
                                                         Canvas.Left="2"
                                                         Canvas.Top="2"
                                                         Stroke="#2F8F3A"
                                                         StrokeThickness="2"
                                                         Opacity="0.28" />
                                                <Path Data="M 10,2 A 8,8 0 0 1 18,10"
                                                      Stroke="#CFEFCF"
                                                      StrokeThickness="2.4"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                    <TextBlock Text="{Binding SetupInstallDetailText}"
                                               Foreground="#F4D8A6"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"
                                               Visibility="{Binding HasSetupInstallDetail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </StackPanel>

                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DetailPanel}"
                            Visibility="{Binding ShowTechnicalDetails, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Install Details"
                                       Foreground="#FFD700"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding SetupComponents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0"
                                                        Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="Bold" />
                                                <TextBlock Text="{Binding Description}"
                                                           Foreground="#D6D6D6"
                                                           TextWrapping="Wrap"
                                                           FontSize="11" />
                                                <TextBlock Text="{Binding DetailText}"
                                                           Foreground="#D79C9C"
                                                           TextWrapping="Wrap"
                                                           FontSize="11"
                                                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="{Binding StatusBackground}"
                                                    CornerRadius="12"
                                                    Padding="10,4"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="11"
                                                           FontWeight="Bold" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox Text="{Binding SetupLogText, Mode=OneWay}"
                                     Height="110"
                                     Margin="0,8,0,0"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto" />
                            <Button Content="Refresh"
                                    Command="{Binding RefreshSetupCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Visibility="{Binding IsHuggingFaceStep, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Style="{StaticResource Panel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/huggingface.png"
                                           Width="22"
                                           Height="22"
                                           Stretch="Uniform"
                                           Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding StepTitle}"
                                               FontSize="20"
                                               FontWeight="Bold" />
                                </StackPanel>
                                <TextBlock Text="{Binding HuggingFaceStatusDetail}"
                                           Foreground="#D6D6D6"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,16,0,0">
                                    <Button Content="Open Token Page"
                                            Command="{Binding OpenHuggingFaceTokensCommand}"
                                            Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                                <PasswordBox x:Name="HuggingFacePasswordBox"
                                             PasswordChanged="HuggingFacePasswordBox_PasswordChanged"
                                             Margin="0,12,0,0" />
                                <Button Content="Save and Verify"
                                        Command="{Binding SaveHuggingFaceCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,12,0,0" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="{Binding HuggingFaceStatusBackground}"
                                    CornerRadius="14"
                                    Padding="12,5"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding HuggingFaceStatusText}"
                                           FontSize="11"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DetailPanel}"
                            Visibility="{Binding ShowTechnicalDetails, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Hugging Face Model Access"
                                       Foreground="#FFD700"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding HuggingFaceModelAccessItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0"
                                                        Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="Bold" />
                                                <TextBlock Text="{Binding RepositoryId}"
                                                           Foreground="#FFD700"
                                                           FontSize="11" />
                                                <TextBlock Text="{Binding DetailText}"
                                                           Foreground="#D6D6D6"
                                                           TextWrapping="Wrap"
                                                           FontSize="11" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="{Binding StatusBackground}"
                                                    CornerRadius="12"
                                                    Padding="10,4"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="11"
                                                           FontWeight="Bold" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Refresh"
                                    Command="{Binding RefreshHuggingFaceCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Visibility="{Binding IsReadyStep, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Style="{StaticResource Panel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Margin="0,0,16,0">
                                <TextBlock Text="{Binding StepTitle}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding ReadySummary}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,18,0,0" />
                                <Button Content="Start Server"
                                        Command="{Binding StartServerCommand}"
                                        Style="{StaticResource LargePrimaryButton}"
                                        HorizontalAlignment="Center"
                                        Margin="0,24,0,0" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="{Binding VoiceStatusBackground}"
                                    CornerRadius="14"
                                    Padding="12,5"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding VoiceStatusText}"
                                           FontSize="11"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DetailPanel}"
                            Visibility="{Binding ShowTechnicalDetails, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Voice Apply Targets"
                                       Foreground="#FFD700"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding VoiceApplyTargets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0"
                                                        Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="Bold" />
                                                <TextBlock Text="{Binding DetailText}"
                                                           Foreground="#D79C9C"
                                                           TextWrapping="Wrap"
                                                           FontSize="11"
                                                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Background="{Binding StatusBackground}"
                                                    CornerRadius="12"
                                                    Padding="10,4"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding StatusText}"
                                                           FontSize="11"
                                                           FontWeight="Bold" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Refresh"
                                    Command="{Binding RefreshReadyCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
