<Window x:Class="DwemerDistro.Launcher.Wpf.Views.CommunityModsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Community mods" Width="1040" Height="740" MinWidth="780" MinHeight="580"
        WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/DwemerDistro;component/Assets/DwemerDistro.ico"
        Background="{DynamicResource GameCenter.Window}" Foreground="{DynamicResource GameCenter.Text}"
        FocusManager.FocusedElement="{Binding ElementName=SearchBox}" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="#191919" />
            <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
            <Setter Property="CaretBrush" Value="{DynamicResource GameCenter.Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.Border}" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource GameCenter.Button}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,5" />
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" Click="Close_Click" />
            <StackPanel>
                <TextBlock Text="Community mods" FontSize="21" FontWeight="Bold" />
                <TextBlock Text="Browse author-published releases, or paste a repository to check it." Opacity="0.8" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" AutomationProperties.Name="Search mods or games" KeyDown="Search_KeyDown" />
            <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse / Search" Margin="8,0,0,0" Click="Browse_Click" />
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ListBox x:Name="Repositories" AutomationProperties.Name="Published mod repositories"
                     Background="#191919" Foreground="{DynamicResource GameCenter.Text}"
                     SelectionChanged="Repository_Selected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,8" MaxWidth="215">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Width="210" MaxHeight="66" Opacity="0.8" Margin="0,4,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Repository URL" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="RepositoryBox" AutomationProperties.Name="GitHub repository URL" TextChanged="Repository_Changed" />
                        <Button x:Name="CheckButton" Grid.Column="1" Content="Check release" Margin="8,0,0,0" Click="Check_Click" />
                    </Grid>
                    <Grid Margin="0,12,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Image x:Name="IconImage" Width="32" Height="32" Stretch="Uniform" AutomationProperties.Name="Mod icon" />
                        <TextBlock x:Name="ModTitle" Grid.Column="1" Text="Select a mod to view its release" FontSize="19" FontWeight="Bold" />
                    </Grid>
                    <Image x:Name="BannerImage" MaxHeight="180" Stretch="Uniform" HorizontalAlignment="Left" AutomationProperties.Name="Mod banner" />
                    <TextBlock x:Name="DescriptionText" Margin="0,8,0,0" />
                    <TextBlock x:Name="ReleaseText" Margin="0,8,0,10" Opacity="0.85" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="SourceButton" Content="Repository" IsEnabled="False" Click="Source_Click" />
                        <Button x:Name="NotesButton" Content="Release notes" IsEnabled="False" Margin="6,0,0,0" Click="Notes_Click" />
                        <Button x:Name="EvidenceButton" Content="Test evidence" IsEnabled="False" Margin="6,0,0,0" Click="Evidence_Click" />
                    </StackPanel>
                    <TextBlock Text="Game folder" Margin="0,4,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="GameFolderBox" AutomationProperties.Name="Game installation folder" />
                        <Button x:Name="FolderButton" Grid.Column="1" Content="Choose…" Margin="8,0,0,0" Click="Folder_Click" />
                    </Grid>
                    <TextBlock x:Name="InstallPlanText" Margin="0,8,0,8" />
                    <CheckBox x:Name="TrustBox" Content="I trust this author and reviewed the install plan."
                              Foreground="{DynamicResource GameCenter.Text}" Margin="0,4,0,12" />
                    <Button x:Name="InstallButton" Content="Install / Update" HorizontalAlignment="Left"
                            IsEnabled="False" Click="Install_Click" MinWidth="160" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <ProgressBar x:Name="BusyProgress" Grid.Row="3" Height="3" Margin="0,10,0,6" Opacity="0" />
        <TextBlock x:Name="StatusText" Grid.Row="4" MinHeight="32" AutomationProperties.Name="Community mod status"
                   AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Window>
