<UserControl x:Class="DwemerDistro.Launcher.Wpf.Views.AssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="AssistantView_PreviewKeyDown"
             SizeChanged="AssistantView_SizeChanged">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="Assistant.TextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#191919" />
            <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
            <Setter Property="CaretBrush" Value="{DynamicResource GameCenter.Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="Assistant.Action" TargetType="Button" BasedOn="{StaticResource GameCenter.Button}">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="MinWidth" Value="96" />
        </Style>
        <Style x:Key="Assistant.Label" TargetType="TextBlock" BasedOn="{StaticResource GameCenter.Caption}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid x:Name="PageGrid" Margin="18,16,18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="ASSISTANT" Style="{StaticResource GameCenter.Heading}" />
                <TextBlock Style="{StaticResource GameCenter.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Ask about your DwemerDistro setup: installed servers, mods and components. Get help with setup steps and problems." />
            </StackPanel>

            <!-- Header: what is connected, as whom, and the session actions. -->
            <Border Grid.Row="1" Style="{StaticResource GameCenter.Card}" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock x:Name="StatusTextBlock" Text="{Binding StatusText}" Style="{StaticResource GameCenter.SectionHeading}"
                                       AutomationProperties.Name="{Binding StatusText, StringFormat=Assistant status: {0}}"
                                       AutomationProperties.HelpText="{Binding StatusDetail}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False" Margin="0,3,0,0">
                                <TextBlock x:Name="StatusDetailText" Text="{Binding StatusDetail}" Style="{StaticResource GameCenter.Caption}"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </StackPanel>
                        <WrapPanel x:Name="SessionActions" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" MaxWidth="440">
                            <Button Content="Connect" Command="{Binding ConnectCommand}" Style="{StaticResource GameCenter.PrimaryButton}" Margin="0,0,6,6" MinWidth="96"
                                    AutomationProperties.HelpText="Check DwemerDistro and start the assistant for the current task." />
                            <Button Content="Sign in" Command="{Binding SignInCommand}" Style="{StaticResource Assistant.Action}"
                                    AutomationProperties.HelpText="Request a ChatGPT sign-in code. Nothing opens until you click Open sign-in page." />
                            <Button Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource Assistant.Action}"
                                    AutomationProperties.HelpText="Stop the current response. Available only while the assistant is responding." />
                            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Style="{StaticResource Assistant.Action}"
                                    AutomationProperties.HelpText="Close the assistant session. It stays closed until you press Connect; your draft is kept." />
                            <Button Content="Load earlier messages" Command="{Binding LoadEarlierCommand}" Style="{StaticResource Assistant.Action}"
                                    Visibility="{Binding HasEarlierHistory, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.HelpText="Show older messages of this conversation above the ones shown. Nothing is sent." />
                            <Button Content="Newer messages" Command="{Binding LoadNewerCommand}" Style="{StaticResource Assistant.Action}"
                                    Visibility="{Binding IsBrowsingHistory, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.HelpText="Show the messages after the earlier ones shown, then the latest. Nothing is sent." />
                            <Button Content="Back to latest" Command="{Binding BackToLatestCommand}" Style="{StaticResource Assistant.Action}"
                                    Visibility="{Binding IsBrowsingHistory, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.HelpText="Return to the newest messages of this conversation. Your draft is kept." />
                            <Button Content="New chat" Command="{Binding NewTaskCommand}" Style="{StaticResource Assistant.Action}"
                                    AutomationProperties.HelpText="Start a new chat with a fresh working copy. The current chat moves into History; nothing is deleted." />
                            <Button Content="Run isolation check" Command="{Binding RunProbeCommand}" Style="{StaticResource Assistant.Action}"
                                    Visibility="{Binding IsProbeVisible, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.HelpText="Run DwemerDistro's assistant isolation check again." />
                        </WrapPanel>
                    </Grid>

                    <WrapPanel Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,2">
                            <TextBlock x:Name="ProviderLabel" Text="Provider" Style="{StaticResource Assistant.Label}" />
                            <TextBlock Text="{Binding ProviderText}" Style="{StaticResource GameCenter.Caption}" VerticalAlignment="Center"
                                       AutomationProperties.LabeledBy="{Binding ElementName=ProviderLabel}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock x:Name="AccountLabel" Text="Account" Style="{StaticResource Assistant.Label}" />
                            <TextBlock Text="{Binding AccountText}" Style="{StaticResource GameCenter.Caption}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="260" ToolTip="{Binding AccountText}"
                                       AutomationProperties.LabeledBy="{Binding ElementName=AccountLabel}" />
                        </StackPanel>
                    </WrapPanel>

                    <!-- Sign-in: the supported URL and code are shown here; the browser opens only on click. -->
                    <Border Visibility="{Binding IsSignInVisible, Converter={StaticResource BoolToVisibility}}"
                            BorderBrush="{DynamicResource GameCenter.Gold}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock x:Name="SignInUrlLabel" Text="Sign-in page" Style="{StaticResource GameCenter.Caption}" />
                            <TextBox Text="{Binding SignInUrl, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Assistant.TextBox}" FontFamily="Consolas"
                                     Margin="0,3,0,6" AutomationProperties.LabeledBy="{Binding ElementName=SignInUrlLabel}" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasSignInCode, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,6">
                                <TextBlock x:Name="SignInCodeLabel" Text="Code" Style="{StaticResource Assistant.Label}" />
                                <TextBox Text="{Binding SignInCode, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Assistant.TextBox}"
                                         FontFamily="Consolas" FontSize="18" FontWeight="Bold" MinWidth="160"
                                         AutomationProperties.LabeledBy="{Binding ElementName=SignInCodeLabel}" />
                                <Button Content="Copy code" Click="CopySignInCode_Click" Style="{StaticResource Assistant.Action}" Margin="6,0,0,0" />
                            </StackPanel>
                            <Button Content="Open sign-in page" Command="{Binding OpenSignInUrlCommand}" Style="{StaticResource Assistant.Action}"
                                    HorizontalAlignment="Left" AutomationProperties.HelpText="Open the sign-in page in your browser." />
                        </StackPanel>
                    </Border>

                    <!-- History and Memory: compact toggles; their panels read nothing until opened. -->
                    <WrapPanel Margin="0,8,0,0">
                        <CheckBox x:Name="HistoryToggle" Content="History" Style="{StaticResource GameCenter.CheckBox}" Margin="0,0,16,0"
                                  Checked="HistoryToggle_Checked"
                                  AutomationProperties.HelpText="Show saved chats of this installation: search titles, rename, archive, reopen, export or delete." />
                        <CheckBox x:Name="MemoryToggle" Content="Memory" Style="{StaticResource GameCenter.CheckBox}" Margin="0,0,16,0"
                                  Checked="MemoryToggle_Checked"
                                  AutomationProperties.HelpText="Show the assistant's memory notes and settings for this installation." />
                        <TextBlock x:Name="MemoryStateText" Text="{Binding Memory.SettingsSummary}" Style="{StaticResource GameCenter.Caption}"
                                   VerticalAlignment="Center" FontSize="11.5" />
                    </WrapPanel>
                    <!-- Wide layouts do not scroll the page, so the open panels scroll here and the conversation keeps its height. -->
                    <ScrollViewer x:Name="PanelScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                    <Border x:Name="HistoryPanel" Visibility="{Binding IsChecked, ElementName=HistoryToggle, Converter={StaticResource BoolToVisibility}}"
                            BorderBrush="{DynamicResource GameCenter.Border}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,6,0,0">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock x:Name="HistorySearchLabel" Text="Search titles" Style="{StaticResource Assistant.Label}" />
                                <TextBox Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Assistant.TextBox}"
                                         MinWidth="180" MaxLength="120" Margin="0,0,12,4" AutomationProperties.LabeledBy="{Binding ElementName=HistorySearchLabel}"
                                         AutomationProperties.HelpText="Matches chat titles only, not message text." />
                                <CheckBox Content="Show archived" IsChecked="{Binding ShowArchived}" Style="{StaticResource GameCenter.CheckBox}" Margin="0,0,12,4" VerticalAlignment="Center" />
                                <CheckBox Content="Other installations and providers" IsChecked="{Binding ShowAllInstallations}" Style="{StaticResource GameCenter.CheckBox}"
                                          Margin="0,0,0,4" VerticalAlignment="Center"
                                          AutomationProperties.HelpText="List chats saved for another DwemerDistro installation or provider. They cannot be reopened here." />
                            </WrapPanel>
                            <ListBox x:Name="HistoryList" ItemsSource="{Binding HistoryItems}" SelectedItem="{Binding SelectedHistory}" MaxHeight="150"
                                     Background="#191919" BorderBrush="{DynamicResource GameCenter.Border}" Foreground="{DynamicResource GameCenter.Text}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Saved chats">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,2">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource GameCenter.Text}" />
                                            <TextBlock Text="{Binding Details}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource GameCenter.TextMuted}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Reopen" Command="{Binding ReopenCommand}" Style="{StaticResource Assistant.Action}"
                                        AutomationProperties.HelpText="Open this chat. DwemerDistro checks that its task still exists and belongs to this installation, and shows any recorded live change first." />
                                <Button Content="{Binding ArchiveLabel}" Command="{Binding ArchiveCommand}" Style="{StaticResource Assistant.Action}"
                                        AutomationProperties.HelpText="Archive only hides the chat in this list. Its conversation, task and receipts are kept." />
                                <TextBox x:Name="RenameBox" Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Assistant.TextBox}"
                                         MinWidth="160" MaxLength="120" Margin="0,0,6,6" AutomationProperties.Name="New title for the selected chat" />
                                <Button Content="Rename" Command="{Binding RenameCommand}" Style="{StaticResource Assistant.Action}" />
                            </WrapPanel>
                            <WrapPanel>
                                <Button x:Name="ExportChatButton" Content="Export chat…" Command="{Binding ExportChatCommand}" Style="{StaticResource Assistant.Action}"
                                        AutomationProperties.HelpText="Save the whole open chat, read page by page, as a Markdown file you choose. Only your messages and the assistant's replies are included." />
                                <Button Content="Cancel export" Command="{Binding CancelExportCommand}" Style="{StaticResource Assistant.Action}"
                                        Visibility="{Binding IsExporting, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.HelpText="Stop the export. Nothing is written." />
                                <Button x:Name="DeleteChatButton" Content="Delete chat…" Command="{Binding DeleteChatCommand}" Style="{StaticResource Assistant.Action}"
                                        Visibility="{Binding CanDeleteChats, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.HelpText="Delete the open chat's conversation from Codex after you confirm. Archive only hides a chat." />
                            </WrapPanel>
                            <TextBlock x:Name="ExportStatusText" Text="{Binding ExportStatus}" Style="{StaticResource GameCenter.Caption}" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="DeleteHintText" Text="{Binding DeleteHint}" Style="{StaticResource GameCenter.Caption}" TextWrapping="Wrap"
                                       Visibility="{Binding CanDeleteChats, Converter={StaticResource BoolToVisibility}}" />
                            <!-- Delete confirmation: nothing is sent until Delete chat here; Cancel or another selection changes nothing. -->
                            <Border x:Name="DeleteConfirmCard" Visibility="{Binding ConfirmingDelete, Converter={StaticResource BoolToVisibility}}"
                                    BorderBrush="{DynamicResource GameCenter.Danger}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,6,0,6"
                                    AutomationProperties.Name="Confirm deleting this chat">
                                <StackPanel>
                                    <TextBlock x:Name="DeleteConfirmTextBlock" TextWrapping="Wrap" Foreground="{DynamicResource GameCenter.DangerText}" Margin="0,0,0,6"
                                               Text="{Binding DeleteConfirmText}" />
                                    <CheckBox x:Name="ForgetChatNotesBox" Content="{Binding ForgetNotesLabel}" IsChecked="{Binding ForgetChatNotes}"
                                              Style="{StaticResource GameCenter.CheckBox}" Margin="0,0,0,6"
                                              AutomationProperties.HelpText="Also forget the memory notes that name exactly the deleted threads. Other notes are kept." />
                                    <WrapPanel>
                                        <Button Content="Delete chat" Command="{Binding ConfirmDeleteCommand}" Style="{StaticResource Assistant.Action}" />
                                        <Button Content="Cancel" Command="{Binding CancelDeleteCommand}" Style="{StaticResource Assistant.Action}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding HistoryStatus}" Style="{StaticResource GameCenter.Caption}" TextWrapping="Wrap" Foreground="{DynamicResource GameCenter.DangerText}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="MemoryPanel" DataContext="{Binding Memory}" Visibility="{Binding IsChecked, ElementName=MemoryToggle, Converter={StaticResource BoolToVisibility}}"
                            BorderBrush="{DynamicResource GameCenter.Border}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding ScopeText}" Style="{StaticResource GameCenter.Caption}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <WrapPanel IsEnabled="{Binding SettingsKnown}">
                                <CheckBox Content="Assistant may search notes" IsChecked="{Binding Retrieval, Mode=TwoWay}" Style="{StaticResource GameCenter.CheckBox}" Margin="0,0,16,4"
                                          AutomationProperties.HelpText="When off, the assistant gets no memory tool and no notes. Applies from the next connection." />
                                <CheckBox Content="Automatic learning (opt-in)" IsChecked="{Binding AutoLearning, Mode=TwoWay}" Style="{StaticResource GameCenter.CheckBox}" Margin="0,0,0,4"
                                          AutomationProperties.HelpText="Lets the assistant store stable preferences and decisions you state. Never logs, secrets or unconfirmed fixes." />
                            </WrapPanel>
                            <WrapPanel>
                                <TextBox x:Name="MemorySearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Assistant.TextBox}"
                                         MinWidth="180" MaxLength="200" Margin="0,0,6,6" AutomationProperties.Name="Search memory notes" />
                                <Button Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource Assistant.Action}" />
                                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource Assistant.Action}" />
                                <Button Content="More" Command="{Binding MoreCommand}" Style="{StaticResource Assistant.Action}" />
                            </WrapPanel>
                            <ListBox x:Name="MemoryList" ItemsSource="{Binding Notes}" SelectedItem="{Binding Selected}" MaxHeight="160"
                                     Background="#191919" BorderBrush="{DynamicResource GameCenter.Border}" Foreground="{DynamicResource GameCenter.Text}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Memory notes">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,2">
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource GameCenter.Text}" />
                                            <TextBlock Text="{Binding SourceText}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource GameCenter.TextMuted}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Edit" Command="{Binding EditCommand}" Style="{StaticResource Assistant.Action}" />
                                <Button Content="Forget selected" Command="{Binding ForgetCommand}" Style="{StaticResource Assistant.Action}" />
                                <Button Content="Export…" Command="{Binding ExportCommand}" Style="{StaticResource Assistant.Action}"
                                        AutomationProperties.HelpText="Save every note and the settings to a JSON file you choose." />
                                <Button Content="Reset memory…" Command="{Binding ResetCommand}" Style="{StaticResource Assistant.Action}" />
                            </WrapPanel>
                            <Border Visibility="{Binding ConfirmingReset, Converter={StaticResource BoolToVisibility}}" BorderBrush="{DynamicResource GameCenter.Danger}"
                                    BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="Forget every memory note of this installation? Settings, chats, task receipts and sign-in are kept. This cannot be undone."
                                               TextWrapping="Wrap" Foreground="{DynamicResource GameCenter.DangerText}" Margin="0,0,0,6" />
                                    <WrapPanel>
                                        <Button Content="Forget all notes" Command="{Binding ConfirmResetCommand}" Style="{StaticResource Assistant.Action}" />
                                        <Button Content="Cancel" Command="{Binding CancelResetCommand}" Style="{StaticResource Assistant.Action}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="MemoryDraftLabel" Text="Note (you decide what is stored)" Style="{StaticResource GameCenter.Caption}" />
                            <TextBox Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Assistant.TextBox}" AcceptsReturn="True"
                                     TextWrapping="Wrap" Height="56" MaxLength="2400" VerticalScrollBarVisibility="Auto" Margin="0,3,0,4"
                                     AutomationProperties.LabeledBy="{Binding ElementName=MemoryDraftLabel}" />
                            <WrapPanel>
                                <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding DraftKind}" Style="{StaticResource GameCenter.ComboBox}" MinWidth="110" Margin="0,0,6,6"
                                          AutomationProperties.Name="Note kind" />
                                <Button Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" Style="{StaticResource Assistant.Action}" />
                                <Button Content="Clear" Command="{Binding CancelEditCommand}" Style="{StaticResource Assistant.Action}" />
                                <TextBlock Text="{Binding DraftLengthText}" Style="{StaticResource GameCenter.Caption}" VerticalAlignment="Center" />
                            </WrapPanel>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource GameCenter.Caption}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- Advanced: collapsed by default; task details and hand-picked files for the next New task. -->
                    <CheckBox x:Name="AdvancedToggle" Content="Advanced" Style="{StaticResource GameCenter.CheckBox}" Margin="0,8,0,0"
                              HorizontalAlignment="Left" IsChecked="False"
                              AutomationProperties.HelpText="Show the task details and choose CHIM files by path for the next new task. File editing supports CHIM only." />
                    <Border x:Name="AdvancedPanel" Visibility="{Binding IsChecked, ElementName=AdvancedToggle, Converter={StaticResource BoolToVisibility}}"
                            BorderBrush="{DynamicResource GameCenter.Border}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock x:Name="TaskLabel" Text="Current task" Style="{StaticResource GameCenter.Caption}" />
                            <TextBox Text="{Binding TaskText, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Assistant.TextBox}" FontFamily="Consolas"
                                     FontSize="12" Margin="0,3,0,8" AutomationProperties.LabeledBy="{Binding ElementName=TaskLabel}" />
                            <TextBlock x:Name="PathsLabel" Text="CHIM files for the next New task (optional, one path relative to the HerikaServer folder per line). File editing supports only CHIM (HerikaServer) today; other servers, components and mods cannot be edited here yet."
                                       Style="{StaticResource GameCenter.Caption}" TextWrapping="Wrap" Margin="0,0,0,3" />
                            <TextBox Text="{Binding RelativePathsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Assistant.TextBox}"
                                     AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                                     Height="70" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxLength="5000"
                                     AutomationProperties.LabeledBy="{Binding ElementName=PathsLabel}"
                                     AutomationProperties.HelpText="Usually not needed: the assistant asks for the files it needs. Leave empty for a diagnostic workspace. Used when New task prepares a working copy." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Grid x:Name="BodyGrid" Grid.Row="2" MinHeight="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SideColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ChatRow" Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Conversation -->
                <Border x:Name="ChatCard" Style="{StaticResource GameCenter.Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- Ctrl+F: exact text in the messages shown here; the match is selected in the transcript itself. -->
                        <Border x:Name="FindBar" Visibility="Collapsed" Margin="10,8,10,0" Padding="8,6,8,2" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource GameCenter.Border}">
                            <WrapPanel>
                                <TextBlock x:Name="FindLabel" Text="Find" Style="{StaticResource Assistant.Label}" Margin="0,0,8,4" />
                                <TextBox x:Name="FindBox" Style="{StaticResource Assistant.TextBox}" MinWidth="200" MaxWidth="360" MaxLength="200" Margin="0,0,6,4"
                                         TextChanged="FindBox_TextChanged" PreviewKeyDown="FindBox_PreviewKeyDown"
                                         AutomationProperties.LabeledBy="{Binding ElementName=FindLabel}"
                                         AutomationProperties.HelpText="Exact text in the messages shown here. Enter finds the next match, Shift+Enter the previous, Esc closes Find." />
                                <Button Content="Previous" Click="FindPrevious_Click" Style="{StaticResource Assistant.Action}" MinWidth="80" Margin="0,0,6,4" />
                                <Button Content="Next" Click="FindNext_Click" Style="{StaticResource Assistant.Action}" MinWidth="80" Margin="0,0,6,4" />
                                <Button Content="Close" Click="FindClose_Click" Style="{StaticResource Assistant.Action}" MinWidth="70" Margin="0,0,10,4" />
                                <TextBlock x:Name="FindStatusText" Style="{StaticResource GameCenter.Caption}" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Margin="0,0,0,4" AutomationProperties.LiveSetting="Polite" />
                            </WrapPanel>
                        </Border>
                        <!-- One read-only document, so a selection, Ctrl+A and Copy can span the whole conversation.
                             Code-behind keeps its blocks in step with Transcript. -->
                        <RichTextBox x:Name="TranscriptBox" Grid.Row="1" IsReadOnly="True" IsReadOnlyCaretVisible="True" IsUndoEnabled="False"
                                     IsInactiveSelectionHighlightEnabled="True"
                                     Background="Transparent" BorderThickness="0" Padding="10,10" FontSize="13"
                                     Foreground="{DynamicResource GameCenter.Text}" CaretBrush="{DynamicResource GameCenter.Text}"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="Assistant conversation"
                                     AutomationProperties.HelpText="Read-only. Ctrl+F finds text in the messages shown, Ctrl+A selects the whole conversation and Ctrl+C copies the selection.">
                            <FlowDocument PagePadding="0" />
                        </RichTextBox>

                        <!-- File access: what the assistant asked for. Nothing is copied until Allow access is clicked. -->
                        <Border x:Name="AccessCard" Grid.Row="2" Margin="10,0,10,0" Padding="10" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource GameCenter.Gold}" Background="{DynamicResource GameCenter.GoldTint}"
                                Visibility="{Binding HasFileRequest, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="File access request" AutomationProperties.LiveSetting="Polite">
                            <StackPanel>
                                <TextBlock Text="The assistant asks to read and edit these CHIM files" FontWeight="SemiBold"
                                           Foreground="{DynamicResource GameCenter.Text}" TextWrapping="Wrap" />
                                <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" Margin="0,4,0,4" Focusable="False">
                                    <ItemsControl x:Name="AccessPaths" ItemsSource="{Binding FileRequestPaths}" Focusable="False"
                                                  AutomationProperties.Name="Requested files">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource GameCenter.Text}"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Style="{StaticResource GameCenter.Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="Allow access copies only these files into a fresh isolated working copy and continues your request there. Only CHIM (HerikaServer) files can be shared and edited today. Live files change only after you review and approve." />
                                <WrapPanel>
                                    <Button Content="Allow access" Command="{Binding AllowFileAccessCommand}" Style="{StaticResource GameCenter.PrimaryButton}"
                                            Margin="0,0,6,0" MinWidth="110"
                                            AutomationProperties.HelpText="Copy only the listed files into a new isolated working copy and continue." />
                                    <Button Content="Not now" Command="{Binding DeclineFileAccessCommand}" Style="{StaticResource Assistant.Action}" Margin="0"
                                            AutomationProperties.HelpText="Dismiss this request. Nothing is shared." />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- The draft stays editable in every state; only Send waits for a ready session. -->
                        <Grid Grid.Row="3" Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="InputBox" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Assistant.TextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="38" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                                     PreviewKeyDown="InputBox_PreviewKeyDown"
                                     AutomationProperties.Name="Message to the assistant"
                                     AutomationProperties.HelpText="Enter sends. Shift+Enter adds a new line. Esc stops a response. Messages over 8,000 characters are not cut; shorten them to send." />
                            <Button Grid.Column="1" Content="Send" Command="{Binding SendCommand}" Style="{StaticResource GameCenter.PrimaryButton}"
                                    Margin="8,0,0,0" MinWidth="80" VerticalAlignment="Bottom" />
                            <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,2">
                                    <TextBlock x:Name="ModelLabel" Text="Model" Style="{StaticResource Assistant.Label}" />
                                    <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="DisplayName"
                                              Style="{StaticResource GameCenter.ComboBox}" MinWidth="150" MaxWidth="240"
                                              AutomationProperties.LabeledBy="{Binding ElementName=ModelLabel}"
                                              AutomationProperties.HelpText="Models offered by the assistant for this account. Used from the next message." />
                                </StackPanel>
                                <TextBlock x:Name="InputLengthText" Text="{Binding InputLengthText}" VerticalAlignment="Center" Margin="0,0,14,2"
                                           FontSize="11.5" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInputTooLong}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource GameCenter.DangerText}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Content="Find…" Click="OpenFind_Click" Style="{StaticResource Assistant.Action}" MinWidth="70" Margin="0,0,6,2"
                                        AutomationProperties.HelpText="Find text in the messages shown here (Ctrl+F). Export chat in History saves the whole chat." />
                                <Button Content="Remember selection…" Click="RememberSelection_Click" Style="{StaticResource Assistant.Action}" Margin="0,0,14,2"
                                        AutomationProperties.HelpText="Start a memory note from the text selected in the conversation (or the last reply). You edit it before anything is stored." />
                                <TextBlock x:Name="UsageTextBlock" Text="{Binding UsageText}" Style="{StaticResource GameCenter.Caption}"
                                           VerticalAlignment="Center" FontSize="11.5" Margin="0,0,0,2"
                                           AutomationProperties.Name="{Binding UsageText, StringFormat=Conversation usage: {0}}" />
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Review and live-change controls; this column is shown only while one of its cards is. -->
                <ScrollViewer x:Name="SidePanel" Grid.Column="1" Margin="10,0,0,0" VerticalScrollBarVisibility="Auto" Focusable="False"
                              Visibility="{Binding IsSidePanelVisible, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <Border Style="{StaticResource GameCenter.Card}" Padding="12" Margin="0,0,0,10" BorderBrush="{DynamicResource GameCenter.Gold}"
                                Visibility="{Binding IsChangesVisible, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="CHANGES READY" Style="{StaticResource GameCenter.SectionHeading}" />
                                <TextBlock Style="{StaticResource GameCenter.Caption}" Margin="0,4,0,8" TextWrapping="Wrap"
                                           Text="The assistant edited files in its isolated copy. Nothing is live yet." />
                                <Button Content="Review changes" Command="{Binding ReviewCommand}" Style="{StaticResource GameCenter.PrimaryButton}"
                                        HorizontalAlignment="Left" MinWidth="96"
                                        AutomationProperties.HelpText="Freeze the assistant's current changes into one exact batch and show its diff." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GameCenter.Card}" Padding="12" Margin="0,0,0,10" BorderBrush="{DynamicResource GameCenter.Gold}"
                                Visibility="{Binding IsReviewVisible, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <DockPanel>
                                    <CheckBox x:Name="WiderReviewToggle" DockPanel.Dock="Right" Content="Wider" Style="{StaticResource GameCenter.CheckBox}"
                                              VerticalAlignment="Center" Checked="WiderReviewToggle_Changed" Unchecked="WiderReviewToggle_Changed"
                                              AutomationProperties.HelpText="Give the review more width on wide windows." />
                                    <TextBlock Text="REVIEW" Style="{StaticResource GameCenter.SectionHeading}" />
                                </DockPanel>
                                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Focusable="False" Margin="0,4,0,6">
                                    <TextBlock x:Name="ReviewSummaryText" Text="{Binding ReviewSummary}" Style="{StaticResource GameCenter.Caption}"
                                               TextWrapping="Wrap" />
                                </ScrollViewer>
                                <!-- Validation sits above Approve; a check DwemerDistro could not run is a warning, never shown as passed. -->
                                <Border x:Name="ReviewValidation" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.Border}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasReviewWarnings}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.Danger}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" Focusable="False">
                                        <TextBlock x:Name="ReviewValidationText" Text="{Binding ReviewValidationText}" TextWrapping="Wrap" FontSize="12"
                                                   AutomationProperties.Name="{Binding ReviewValidationText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasReviewWarnings}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource GameCenter.DangerText}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </ScrollViewer>
                                </Border>
                                <WrapPanel Margin="0,0,0,2">
                                    <Button Content="Approve and apply" Command="{Binding ApproveCommand}" Style="{StaticResource GameCenter.SuccessButton}"
                                            Margin="0,0,6,6" IsDefault="False"
                                            AutomationProperties.HelpText="Apply exactly this reviewed batch to the live CHIM files, once." />
                                    <Button Content="Reject" Command="{Binding RejectCommand}" Style="{StaticResource Assistant.Action}"
                                            AutomationProperties.HelpText="Clear this review. Nothing is applied." />
                                </WrapPanel>
                                <TextBox x:Name="DiffBox" Text="{Binding ReviewDiff, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Assistant.TextBox}"
                                         FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap" Height="200"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Diff of the reviewed batch" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GameCenter.Card}" Padding="12"
                                Visibility="{Binding HasOutcome, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="LAST LIVE CHANGE" Style="{StaticResource GameCenter.SectionHeading}" />
                                <TextBlock x:Name="OutcomeTextBlock" Text="{Binding OutcomeText}" Style="{StaticResource GameCenter.Caption}" Margin="0,4,0,8"
                                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                                <WrapPanel>
                                    <Button Content="Check status" Command="{Binding CheckOutcomeCommand}" Style="{StaticResource Assistant.Action}"
                                            AutomationProperties.HelpText="Ask DwemerDistro what this task's live change state is." />
                                    <Button Content="Roll back" Command="{Binding RollbackCommand}" Style="{StaticResource Assistant.Action}"
                                            AutomationProperties.HelpText="Restore the live files recorded by this task's apply receipt." />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
