<Window x:Class="DwemerDistro.Launcher.Wpf.Views.AddCustomModWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add custom mod"
        Icon="/Assets/DwemerDistro.ico"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GameCenter.Window}"
        TextElement.Foreground="{DynamicResource GameCenter.Text}"
        FocusManager.FocusedElement="{Binding ElementName=RepositoryUrlTextBox}"
        AutomationProperties.Name="Add custom mod"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="DialogBodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
            <Setter Property="FontFamily" Value="Trebuchet MS" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DialogCaptionText" TargetType="TextBlock" BasedOn="{StaticResource DialogBodyText}">
            <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="Add custom mod" FontFamily="Trebuchet MS" FontSize="18" FontWeight="Bold" />
        <TextBlock Style="{StaticResource DialogCaptionText}" Margin="0,6,0,14"
                   Text="Paste a public HTTPS Git repository that includes a dwemer-mod.json file." />

        <TextBlock x:Name="RepositoryUrlLabel" Text="Repository URL" Style="{StaticResource DialogBodyText}" Margin="0,0,0,6" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="RepositoryUrlTextBox"
                     Height="34" VerticalContentAlignment="Center" Padding="10,0"
                     FontFamily="Consolas" FontSize="13" MaxLength="300"
                     Background="#191919" Foreground="{DynamicResource GameCenter.Text}"
                     CaretBrush="{DynamicResource GameCenter.Text}"
                     BorderBrush="{DynamicResource GameCenter.Border}" BorderThickness="1"
                     AutomationProperties.LabeledBy="{Binding ElementName=RepositoryUrlLabel}"
                     AutomationProperties.HelpText="For example https://github.com/owner/repository. Credentials and query text are not accepted."
                     TextChanged="RepositoryUrlTextBox_TextChanged"
                     KeyDown="RepositoryUrlTextBox_KeyDown" />
            <Button x:Name="CheckButton" Grid.Column="1" Content="Check repo" MinWidth="120" MinHeight="34" Margin="10,0,0,0"
                    Style="{StaticResource GameCenter.Button}" IsEnabled="False" Click="CheckButton_Click"
                    AutomationProperties.HelpText="Read the repository's manifest without installing anything." />
        </Grid>

        <!-- Manifest preview. Collapsed until a check succeeds. -->
        <Border x:Name="PreviewPanel" Visibility="Collapsed" Margin="0,14,0,0" Padding="12"
                Background="#191919" BorderBrush="{DynamicResource GameCenter.Border}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="PreviewNameText" FontFamily="Trebuchet MS" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="PreviewDescriptionText" Style="{StaticResource DialogBodyText}" Margin="0,4,0,0" />
                <TextBlock x:Name="PreviewDetailsText" Style="{StaticResource DialogCaptionText}" Margin="0,8,0,0" FontFamily="Consolas" FontSize="11" />
                <TextBlock Style="{StaticResource DialogCaptionText}" Margin="0,8,0,0"
                           Text="Needs: PHP 8.2 and its own PostgreSQL database inside the distro." />
            </StackPanel>
        </Border>

        <CheckBox x:Name="TrustCheckBox" Visibility="Collapsed" Margin="0,14,0,0"
                  Foreground="{DynamicResource GameCenter.Text}" Checked="TrustCheckBox_Changed" Unchecked="TrustCheckBox_Changed"
                  AutomationProperties.Name="I trust this repository's code">
            <TextBlock Style="{StaticResource DialogBodyText}"
                       Text="I trust this repository. Its PHP code will run inside the distro as the dwemer user and can read that user's files." />
        </CheckBox>

        <Grid Height="44" Margin="0,12,0,0">
            <Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock x:Name="StatusText" Style="{StaticResource DialogCaptionText}" TextTrimming="CharacterEllipsis"
                       AutomationProperties.Name="Add custom mod status" AutomationProperties.LiveSetting="Polite" />
            <ProgressBar x:Name="BusyProgress" Grid.Row="1" Height="6" VerticalAlignment="Top" IsIndeterminate="False" Opacity="0"
                         Background="#151515" BorderThickness="0" Foreground="{DynamicResource GameCenter.Gold}"
                         IsTabStop="False" Focusable="False" AutomationProperties.Name="Add custom mod progress" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="110" MinHeight="36" Margin="0,0,10,0"
                    Style="{StaticResource GameCenter.Button}" Click="CancelButton_Click" />
            <Button x:Name="InstallButton" Content="Install" MinWidth="140" MinHeight="36" IsEnabled="False"
                    Style="{StaticResource GameCenter.Button}" Click="InstallButton_Click"
                    AutomationProperties.HelpText="Install the checked version. Enabled after the repository is checked and trusted." />
        </StackPanel>
    </StackPanel>
</Window>
