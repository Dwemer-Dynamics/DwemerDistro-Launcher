<Window x:Class="DwemerDistro.Launcher.Wpf.Views.StartupUpdateNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Distro update"
        Width="500"
        MinWidth="280"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GameCenter.Window}"
        BorderBrush="{DynamicResource GameCenter.Border}"
        BorderThickness="1"
        TextElement.Foreground="{DynamicResource GameCenter.Text}"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="NoticeBodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
            <Setter Property="FontFamily" Value="Trebuchet MS" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="NoticeCaptionText" TargetType="TextBlock" BasedOn="{StaticResource NoticeBodyText}">
            <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
        </Style>
    </Window.Resources>

    <!-- A non-modal notice owned by the main window, styled like the mod update dialog. Every button only
         navigates or closes: retrying stays the Settings Update Distro button, with its own confirmation. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#1A1A1A"
                BorderBrush="{DynamicResource GameCenter.Border}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                    <Image Source="/Assets/DwemerDistro.png" Width="18" Height="18" Margin="0,0,9,0" />
                    <TextBlock x:Name="TitleTextBlock"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="✕"
                        IsTabStop="False"
                        Style="{StaticResource GameCenter.CaptionCloseButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Close"
                        Click="CloseButton_Click" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel Margin="20,16,20,16">
                <TextBlock x:Name="HeadingTextBlock"
                           FontFamily="Trebuchet MS"
                           FontSize="16"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource GameCenter.DangerText}" />
                <TextBlock x:Name="SummaryTextBlock"
                           Style="{StaticResource NoticeBodyText}"
                           Margin="0,6,0,0" />
                <Border x:Name="DetailsBorder"
                        Background="#191919"
                        BorderBrush="{DynamicResource GameCenter.Border}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,12,0,0">
                    <!-- Read-only so the reason can be copied; out of the tab order so the actions keep focus. -->
                    <TextBox x:Name="DetailsTextBox"
                             IsReadOnly="True"
                             IsTabStop="False"
                             MaxHeight="120"
                             Padding="6,6"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             FontFamily="Consolas"
                             FontSize="12"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource GameCenter.Text}"
                             CaretBrush="{DynamicResource GameCenter.Text}"
                             AutomationProperties.Name="Failure details" />
                </Border>
                <TextBlock x:Name="NextStepTextBlock"
                           Style="{StaticResource NoticeCaptionText}"
                           Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="#242424"
                BorderBrush="{DynamicResource GameCenter.Border}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="ShowConsoleButton"
                        Content="Show Console"
                        MinWidth="96"
                        Margin="0,0,10,0"
                        Style="{StaticResource GameCenter.Button}"
                        AutomationProperties.HelpText="Close this notice and show the launcher console with the update output."
                        Click="ShowConsoleButton_Click" />
                <Button x:Name="OpenSettingsButton"
                        Content="Open Settings"
                        MinWidth="96"
                        Margin="0,0,10,0"
                        IsDefault="True"
                        Style="{StaticResource GameCenter.GoButton}"
                        AutomationProperties.HelpText="Close this notice and open Settings, where Update Distro can be run again."
                        Click="OpenSettingsButton_Click" />
                <Button x:Name="DismissButton"
                        Content="Close"
                        MinWidth="96"
                        IsCancel="True"
                        Style="{StaticResource GameCenter.Button}"
                        Click="CloseButton_Click" />
            </WrapPanel>
        </Border>
    </Grid>
</Window>
