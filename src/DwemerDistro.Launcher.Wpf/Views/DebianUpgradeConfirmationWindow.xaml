<Window x:Class="DwemerDistro.Launcher.Wpf.Views.DebianUpgradeConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upgrade DwemerDistro"
        Icon="/Assets/DwemerDistro.ico"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GameCenter.Window}"
        TextElement.Foreground="{DynamicResource GameCenter.Text}"
        UseLayoutRounding="True"
        AutomationProperties.Name="Upgrade DwemerDistro confirmation">
    <Window.Resources>
        <Style x:Key="DialogBodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
            <Setter Property="FontFamily" Value="Trebuchet MS" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DialogCaptionText" TargetType="TextBlock" BasedOn="{StaticResource DialogBodyText}">
            <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
        </Style>
        <Style x:Key="DialogLabelText" TargetType="TextBlock" BasedOn="{StaticResource DialogBodyText}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
    </Window.Resources>

    <!-- Only confirms: the caller runs the distro update with the upgrade approved, so nothing changes while this is open.
         Later is the default and the cancel action, so Enter or Esc never starts a half-hour operation by accident. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel Margin="20,18,20,8">
                <TextBlock x:Name="HeadingTextBlock"
                           Text="Upgrade DwemerDistro?"
                           FontFamily="Trebuchet MS"
                           FontSize="18"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource GameCenter.CopperStrong}" />

                <TextBlock x:Name="PlayLabelTextBlock" Text="While it runs" Style="{StaticResource DialogLabelText}" />
                <TextBlock x:Name="PlayTextBlock"
                           Style="{StaticResource DialogBodyText}"
                           Text="Close your game and stop the DwemerDistro server first. Keep the launcher open until the upgrade finishes." />

                <TextBlock x:Name="TimeLabelTextBlock" Text="Time" Style="{StaticResource DialogLabelText}" />
                <TextBlock x:Name="TimeTextBlock"
                           Style="{StaticResource DialogBodyText}"
                           Text="Roughly 10-20 minutes" />

                <TextBlock x:Name="SpaceLabelTextBlock" Text="Disk space" Style="{StaticResource DialogLabelText}" />
                <!-- One row per Windows volume; each row is a single text so a screen reader reads need and free together. -->
                <ItemsControl x:Name="VolumesItemsControl"
                              Focusable="False"
                              AutomationProperties.LabeledBy="{Binding ElementName=SpaceLabelTextBlock}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#191919"
                                    BorderBrush="{DynamicResource GameCenter.Border}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10,6"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Description}"
                                               Style="{StaticResource DialogBodyText}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Verdict}"
                                               Foreground="{Binding VerdictBrush}"
                                               FontFamily="Trebuchet MS"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="SpaceNoteTextBlock"
                           Style="{StaticResource DialogCaptionText}"
                           Text="The launcher checks the exact space needed before it starts the upgrade." />

                <!-- Why Start can't go ahead right now: a game, the server, or space. Announced as soon as it appears. -->
                <Border x:Name="AlertBorder"
                        Visibility="Collapsed"
                        BorderBrush="{DynamicResource GameCenter.Danger}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,8"
                        Margin="0,14,0,0">
                    <TextBlock x:Name="AlertTextBlock"
                               Style="{StaticResource DialogBodyText}"
                               Foreground="{DynamicResource GameCenter.DangerText}"
                               AutomationProperties.LiveSetting="Assertive" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="#242424"
                BorderBrush="{DynamicResource GameCenter.Border}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="LaterButton"
                        Content="Later"
                        IsCancel="True"
                        IsDefault="True"
                        MinWidth="82"
                        MinHeight="36"
                        Margin="0,0,10,0"
                        Style="{StaticResource GameCenter.Button}"
                        AutomationProperties.Name="Later"
                        AutomationProperties.HelpText="Keep Debian 12 for now. Nothing in the system changes and you can keep playing."
                        Click="LaterButton_Click" />
                <Button x:Name="StartButton"
                        Content="Upgrade DwemerDistro"
                        MinWidth="180"
                        MinHeight="36"
                        Style="{StaticResource GameCenter.GoButton}"
                        ToolTipService.ShowOnDisabled="True"
                        AutomationProperties.Name="Upgrade DwemerDistro"
                        Click="StartButton_Click" />
            </WrapPanel>
        </Border>
    </Grid>
</Window>
