<Window x:Class="DwemerDistro.Launcher.Wpf.Views.ServerUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Server update"
        Icon="/Assets/DwemerDistro.ico"
        Width="540"
        MinWidth="280"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GameCenter.Window}"
        BorderBrush="{DynamicResource GameCenter.Border}"
        BorderThickness="1"
        TextElement.Foreground="{DynamicResource GameCenter.Text}"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="DialogBodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
            <Setter Property="FontFamily" Value="Trebuchet MS" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DialogCaptionText" TargetType="TextBlock" BasedOn="{StaticResource DialogBodyText}">
            <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
        </Style>
        <Style x:Key="DialogChoice" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GameCenter.Panel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GameCenter.BorderStrong}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
    </Window.Resources>

    <!-- Title bar and actions stay fixed; only the body scrolls when the work area is too short. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#1A1A1A"
                BorderBrush="{DynamicResource GameCenter.Border}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                    <Image Source="/Assets/DwemerDistro.png" Width="18" Height="18" Margin="0,0,9,0" />
                    <TextBlock x:Name="TitleTextBlock"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <!-- Closing from the title bar is always the safe answer, never consent. -->
                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Content="✕"
                        IsTabStop="False"
                        Style="{StaticResource GameCenter.CaptionCloseButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="Close"
                        Click="DismissButton_Click" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel Margin="20,16,20,16">
                <TextBlock x:Name="HeadingTextBlock"
                           FontFamily="Trebuchet MS"
                           FontSize="16"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource GameCenter.DangerText}" />
                <TextBlock x:Name="IntroTextBlock"
                           Style="{StaticResource DialogBodyText}"
                           Margin="0,6,0,0" />

                <TextBlock x:Name="DetailsLabelTextBlock"
                           Style="{StaticResource DialogCaptionText}"
                           FontSize="11"
                           FontWeight="Bold"
                           Margin="0,12,0,4" />
                <Border Background="#191919"
                        BorderBrush="{DynamicResource GameCenter.Border}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <!-- Read-only so names can be copied; out of the tab order so No keeps focus. 216 DIP fits the
                         seven wrapped file lines at most; only a long error tail scrolls here. -->
                    <TextBox x:Name="DetailsTextBox"
                             IsReadOnly="True"
                             IsTabStop="False"
                             MaxHeight="216"
                             Padding="6,6"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             FontFamily="Consolas"
                             FontSize="12"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource GameCenter.Text}"
                             CaretBrush="{DynamicResource GameCenter.Text}"
                             AutomationProperties.LabeledBy="{Binding ElementName=DetailsLabelTextBlock}" />
                </Border>

                <StackPanel x:Name="ChoicesPanel" Margin="0,12,0,0" Visibility="Collapsed">
                    <Border Style="{StaticResource DialogChoice}"
                            BorderBrush="{DynamicResource GameCenter.Danger}"
                            Margin="0,0,0,6">
                        <TextBlock Style="{StaticResource DialogBodyText}">
                            <Run Text="Yes:" FontWeight="Bold" Foreground="{DynamicResource GameCenter.DangerText}" />
                            <Run x:Name="YesChoiceRun" />
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource DialogChoice}">
                        <TextBlock Style="{StaticResource DialogBodyText}">
                            <Run Text="No:" FontWeight="Bold" />
                            <Run x:Name="NoChoiceRun" />
                        </TextBlock>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="FootnoteTextBlock"
                           Style="{StaticResource DialogCaptionText}"
                           Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="#242424"
                BorderBrush="{DynamicResource GameCenter.Border}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="YesButton"
                        Content="Yes"
                        MinWidth="96"
                        Margin="0,0,10,0"
                        Visibility="Collapsed"
                        Style="{StaticResource GameCenter.ServerUninstallButton}"
                        Click="YesButton_Click" />
                <!-- No on the confirmation, OK otherwise: default, cancel and first focus, so Enter,
                     Escape and every close path give the answer that changes nothing. -->
                <Button x:Name="DismissButton"
                        Content="OK"
                        MinWidth="96"
                        IsDefault="True"
                        IsCancel="True"
                        Style="{StaticResource GameCenter.PrimaryButton}"
                        Click="DismissButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
