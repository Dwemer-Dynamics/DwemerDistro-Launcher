<Window x:Class="DwemerDistro.Launcher.Wpf.Views.UpgradeProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upgrade DwemerDistro"
        Icon="/Assets/DwemerDistro.ico"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GameCenter.Window}"
        TextElement.Foreground="{DynamicResource GameCenter.Text}"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="DialogBodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GameCenter.Text}" />
            <Setter Property="FontFamily" Value="Trebuchet MS" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DialogCaptionText" TargetType="TextBlock" BasedOn="{StaticResource DialogBodyText}">
            <Setter Property="Foreground" Value="{DynamicResource GameCenter.TextMuted}" />
        </Style>
    </Window.Resources>

    <!-- Modeless and only reports: the caller owns the run and closes this before its result dialog. Hide closes it
         without stopping anything, so Enter or Esc never cancels an upgrade. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,18,20,14">
            <TextBlock x:Name="HeadingTextBlock"
                       FontFamily="Trebuchet MS"
                       FontSize="18"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource GameCenter.CopperStrong}" />

            <!-- The active phase, announced when it changes. -->
            <TextBlock x:Name="PhaseTextBlock"
                       Style="{StaticResource DialogBodyText}"
                       FontWeight="SemiBold"
                       Margin="0,12,0,8"
                       AutomationProperties.LiveSetting="Polite" />

            <!-- Indeterminate: none of these steps reports how far it has got, so no percentage is shown. -->
            <ProgressBar x:Name="ActivityProgressBar"
                         Height="6"
                         IsIndeterminate="True"
                         Background="#151515"
                         BorderThickness="0"
                         Foreground="{DynamicResource GameCenter.CopperStrong}"
                         IsTabStop="False"
                         Focusable="False"
                         AutomationProperties.Name="Upgrade in progress"
                         AutomationProperties.LabeledBy="{Binding ElementName=PhaseTextBlock}" />

            <!-- The latest real output from the step: a log line, a recovery copy's size, or a game it waits for. -->
            <TextBlock x:Name="DetailTextBlock"
                       Style="{StaticResource DialogCaptionText}"
                       Margin="0,8,0,0"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       Visibility="Collapsed"
                       AutomationProperties.Name="Latest activity" />

            <TextBlock x:Name="NoteTextBlock"
                       Style="{StaticResource DialogCaptionText}"
                       Margin="0,14,0,0"
                       Text="Keep the launcher open until it finishes. Hiding this window doesn't stop it; the console shows the full output." />
        </StackPanel>

        <Border Grid.Row="1"
                Background="#242424"
                BorderBrush="{DynamicResource GameCenter.Border}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="HideButton"
                        Content="Hide"
                        IsCancel="True"
                        IsDefault="True"
                        MinWidth="82"
                        MinHeight="36"
                        Style="{StaticResource GameCenter.Button}"
                        AutomationProperties.Name="Hide"
                        AutomationProperties.HelpText="Hides this window. The upgrade keeps running and the launcher reports when it finishes."
                        Click="HideButton_Click" />
            </WrapPanel>
        </Border>
    </Grid>
</Window>
